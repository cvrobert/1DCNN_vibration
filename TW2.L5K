				N: XIC(b_TU_ServoIL)XIC(timer_TU_SvOn.DN)OTE(G_b_TU_SV_ON);
				RC: "////////////////////////////////////////////////////////////// Take Up BObin Axis Disk Brake SV /////////////////////////////////////////////////////";
				N: [XIC(G_b_TU_MC_ON) XIC(SV1_Axis2_TU.ServoActionStatus) ,XIC(b_BrkManOpen) ]OTE(Local:3:O.Pt14.Data);
				RC: "////////////////////////////////////////////////////////////// Take Up Safety Door Lock Release /////////////////////////////////////////////////////";
				N: XIC(b_DoorUnlockHb)OTE(Local:3:O.Pt12.Data);
				N: XIC(M11ETH:2:I.Pt03.Data)OTE(Local:3:O.Pt01.Data);
				N: XIC(G_b_LineRunJogZero)XIC(TPFRM_RUNSET.b_Slct_StaticElmntr)[OTE(Local:3:O.Pt03.Data) ,OTE(Local:3:O.Pt04.Data) ,OTE(GAUX_b_SttcElmntr_Mb) ];
		END_ROUTINE

		CHILD_PROGRAMS
		END_CHILD_PROGRAMS

	END_PROGRAM

