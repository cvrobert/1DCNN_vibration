				N: XIO(G_b_Alm1IL[86])XIO(G_b_Alm1IL[89])XIO(G_b_Alm1IL[92])XIO(G_b_Alm1IL[95])XIO(G_b_Alm1IL[98])XIO(G_b_Alm2IL[0])XIO(G_b_Alm2IL[4])XIO(G_b_Alm2IL[5])XIO(G_b_Alm2IL[11])XIO(G_b_Alm2IL[15])XIO(G_b_Alm2IL[16])OTE(b_Q_Stp_Aux1);
				N: XIO(G_b_Alm2IL[22])XIO(G_b_Alm2IL[26])XIO(G_b_Alm2IL[27])XIO(G_b_Alm2IL[33])XIO(G_b_Alm2IL[37])XIO(G_b_Alm2IL[38])XIO(G_b_Alm2IL[44])XIO(G_b_Alm2IL[48])OTE(b_Q_Stp_Aux2);
				N: XIO(G_b_Alm2IL[49])XIO(G_b_Alm2IL[55])XIO(G_b_Alm2IL[59])XIO(G_b_Alm2IL[60])XIO(G_b_Alm2IL[66])XIO(G_b_Alm2IL[70])XIO(G_b_Alm2IL[71])XIO(G_b_Alm2IL[77])OTE(b_Q_Stp_Aux3);
				N: XIO(G_b_Alm2IL[81])XIO(G_b_Alm2IL[82])XIO(G_b_Alm2IL[88])XIO(G_b_Alm2IL[92])XIO(G_b_Alm2IL[93])XIO(G_b_Alm2IL[99])XIO(G_b_Alm2IL[103])XIO(G_b_Alm2IL[104])XIO(G_b_Alm3IL[0])OTE(b_Q_Stp_Aux4);
				N: XIO(G_b_Alm3IL[4])XIO(G_b_Alm3IL[5])XIO(G_b_Alm3IL[11])XIO(G_b_Alm3IL[15])XIO(G_b_Alm3IL[16])XIO(G_b_Alm3IL[111])XIO(G_b_Alm3IL[115])OTE(b_Q_Stp_Aux5);
				N: XIC(b_Q_Stp_Aux0)XIC(b_Q_Stp_Aux1)XIC(b_Q_Stp_Aux2)XIC(b_Q_Stp_Aux3)XIC(b_Q_Stp_Aux4)XIC(b_Q_Stp_Aux5)[OTE(b_Run_Q_Stp_IL) ,OTE(b_Jog_Q_Stp_IL) ];
				RC: "//////////////////////////////////////////////////////////////////////////////////// Slow Down Stop Inter Lock //////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: XIO(G_b_Alm1IL[51])XIO(G_b_Alm1IL[67])XIO(G_b_Alm1IL[70])XIO(G_b_Alm1IL[71])[XIO(G_b_Alm1IL[87]) XIO(G_b_Alm1IL[90]) XIO(G_b_Alm1IL[99]) XIO(G_b_Alm1IL[96]) ,XIC(TPTO01_n_Grph_BND_IL) ]XIO(G_b_Alm2IL[7])XIO(G_b_Alm2IL[18])XIO(G_b_Alm2IL[29])XIO(G_b_Alm2IL[40])XIO(G_b_Alm2IL[51])XIO(G_b_Alm2IL[62])OTE(b_SFS_IL_Aux1);
				N: XIO(G_b_Alm2IL[2])XIO(G_b_Alm2IL[13])XIO(G_b_Alm2IL[24])XIO(G_b_Alm2IL[35])XIO(G_b_Alm2IL[46])XIO(G_b_Alm2IL[57])XIO(G_b_Alm2IL[68])XIO(G_b_Alm2IL[79])XIO(G_b_Alm2IL[90])XIO(G_b_Alm2IL[101])XIO(G_b_Alm3IL[2])XIO(G_b_Alm3IL[13])OTE(A_Payoff_UninstalledIL);
				N: XIO(G_b_Alm2IL[73])XIO(G_b_Alm2IL[84])XIO(G_b_Alm2IL[95])XIO(G_b_Alm2IL[106])XIO(G_b_Alm3IL[7])XIO(G_b_Alm3IL[18])OTE(b_SFS_IL_Aux2);
				N: XIO(G_b_Alm4Ope_IL[0])XIO(G_b_Alm4Ope_IL[1])XIO(G_b_Alm4Ope_IL[2])XIO(G_b_Alm4Ope_IL[3])XIO(G_b_Alm4Ope_IL[4])XIO(G_b_Alm4Ope_IL[5])XIO(G_b_Alm4Ope_IL[6])XIO(G_b_Alm4Ope_IL[7])OTE(b_SFS_IL_Aux3);
				N: XIO(G_b_Alm2IL[8])XIO(G_b_Alm2IL[19])XIO(G_b_Alm2IL[30])XIO(G_b_Alm2IL[41])XIO(G_b_Alm2IL[52])XIO(G_b_Alm2IL[63])XIO(G_b_Alm2IL[74])XIO(G_b_Alm2IL[85])XIO(G_b_Alm2IL[96])XIO(G_b_Alm2IL[107])XIO(G_b_Alm3IL[8])XIO(G_b_Alm3IL[19])OTE(b_SFS_IL_Aux4);
				N: XIC(b_SFS_IL_Aux1)XIC(b_SFS_IL_Aux2)XIC(b_SFS_IL_Aux4)[XIC(b_SFS_IL_Aux3) OTE(b_Run_SFS_IL) ,OTE(b_Jog_SFS_IL) ];
				RC: "//////////////////////////////////////////////////////////////////////////////////// Start Inter Lock //////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: XIC(b_Run_ES_IL)XIC(b_Run_Q_Stp_IL)XIC(b_Run_SFS_IL)XIO(G_b_Alm1IL[33])XIO(G_b_Alm1IL[106])XIO(G_b_Alm1IL[107])XIO(G_b_Alm1IL[108])XIO(G_b_Alm1IL[109])XIO(G_b_Alm1IL[34])OTE(b_Run_S_IL);
				N: XIC(b_Jog_ES_IL)XIC(b_Jog_Q_Stp_IL)XIC(b_Jog_SFS_IL)XIO(G_b_Alm1IL[33])XIO(G_b_Alm1IL[106])XIO(G_b_Alm1IL[107])XIO(G_b_Alm1IL[108])XIO(G_b_Alm1IL[109])XIO(G_b_Alm1IL[34])OTE(b_Jog_S_IL);
				N: XIC(b_Run_ES_IL)XIC(b_Run_Q_Stp_IL)XIC(b_Run_SFS_IL)XIO(G_b_Alm1IL[33])XIO(G_b_Alm1IL[106])XIO(G_b_Alm1IL[107])XIO(G_b_Alm1IL[108])XIO(G_b_Alm1IL[109])OTE(b_Zero_S_IL);
		END_ROUTINE

		ROUTINE R03_LineRunMainbit 
				N: XIC(GCMND_b_LineJog)[OSR(b_PlsStrage[0],b_LineJog_Rsng) ,OSF(b_PlsStrage[1],b_LineJog_Fllng) ];
				N: XIC(M11ETH:2:I.Pt04.Data)OTE(b_FRYR_Brk_Opn_SSW);
				N: XIC(M11ETH:2:I.Pt05.Data)OTE(b_FRYR_Brk_Cls_SSW);
				RC: "///////////////////////////////////////////////////////////////////////////////////////////// Line Start Bell ////////////////////////////////////////////////////////////////////////////////////////$N"
				    "";
				N: XIC(GCMND_b_LineStrtBell)[OTE(G_b_StrtBell_On) ,TON(tmr_StrtBell3s,?,?) ,XIC(tmr_StrtBell3s.DN) TOF(tmr_StrtBellOk,?,?) ];
				N: XIC(tmr_StrtBellOk.DN)OTE(b_StrtPBAvar);
				RC: "////////////////////////////////////////////////////////// Line Run Sequence //////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: XIO(G_b_LineJogMb)XIO(G_b_LineZeroPstnMb)XIO(GTU_b_FwJog_Mb)XIO(GTU_b_RvJog_Mb)OTE(b_Execlusive_Run);
				N: XIC(b_Run_S_IL)XIC(b_STT_is_RUN_OK)XIC(b_StrtPBAvar)XIC(G_b_CNV1_MC_Intrvl_OK)OTE(b_LineStrtOk);
				N: XIC(b_Run_ES_IL)XIC(b_Execlusive_Run)XIO(b_RunFin)[XIC(GCMND_b_LineRun) XIC(b_LineStrtOk) ,XIC(G_b_LineRunMb) ]OTE(G_b_LineRunMb);
				N: XIC(G_b_LineRunMb)[XIO(GCMND_b_LineStp) ,XIO(b_Run_SFS_IL) ,XIC(G_b_LineStpHb) ]OTE(G_b_LineStpHb);
				N: [XIC(G_b_LineRunMb) ,XIC(G_b_LineZeroPstnMb) ][XIO(b_Run_Q_Stp_IL) ,XIC(G_b_LineQstpHb) ]OTE(G_b_LineQstpHb);
				N: [XIC(G_b_LineRunMb) ,XIC(G_b_LineZeroPstnMb) ][XIC(G_b_LineStpHb) ,XIC(G_b_LineQstpHb) ]XIC(G_b_FryrZeroSpdRch)OTE(b_RunFin);
				RC: "//////////////////////////////////////////////////////////////////////////////////// Line Jog Sequence ///////////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: XIO(G_b_LineRunMb)XIO(G_b_LineZeroPstnMb)XIO(GTU_b_FwJog_Mb)XIO(GTU_b_RvJog_Mb)OTE(b_Execlusive_Jog);
				N: XIC(b_Jog_S_IL)XIC(b_STT_is_JOG_OK)XIC(b_StrtPBAvar)XIC(G_b_CNV1_MC_Intrvl_OK)OTE(b_JogStrtOk);
				RC: "$N"
				    "";
				N: XIC(b_Jog_ES_IL)XIC(b_Execlusive_Jog)XIO(b_LineJogStp)[XIC(b_LineJog_Rsng) XIC(b_JogStrtOk) ,XIC(G_b_LineJogMb) ]OTE(G_b_LineJogMb);
				N: XIC(G_b_LineJogMb)[XIC(b_LineJog_Fllng) ,XIO(b_Jog_SFS_IL) ,XIC(G_b_LineJogStpHb) ]OTE(G_b_LineJogStpHb);
				N: XIC(G_b_LineJogMb)[XIO(b_Jog_Q_Stp_IL) ,XIC(G_b_LineJogQstpHb) ]OTE(G_b_LineJogQstpHb);
				N: XIC(G_b_LineJogMb)[XIC(G_b_LineJogStpHb) ,XIC(G_b_LineJogQstpHb) ]XIC(G_b_FryrZeroSpdRch)OTE(b_LineJogStp);
				RC: "//////////////////////////////////////////////////////////////////////////////// Master Up (Change Product Speed ) //////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: XIC(TPFRM06_b_MasterUp_PB)TON(tmr_MstrUpPB,?,?);
				N: XIC(tmr_MstrUpPB.DN)OSR(b_PlsStrage[2],b_MstrUpPB_pls);
				N: XIC(b_MstrUpPB_pls)[XIO(G_b_MasterUp) OTE(b_MstrUpOn_pls) ,XIC(G_b_MasterUp) OTE(b_MstrUpOff_pls) ];
				N: XIC(G_b_LineRunMb)XIC(b_STT_is_M_Up_OK)XIO(b_MstrUpOff_pls)[XIC(b_MstrUpOn_pls) ,XIC(G_b_MasterUp) ]OTE(G_b_MasterUp);
		END_ROUTINE

		ROUTINE R04_Line0Postn 
				RC: "//////////////////////////////////////////////////////////////////////////////////////// Fryer Zero Position Run Main bit Swquence ////////////////////////////////////////////////////////////////////////////";
				N: XIO(G_b_LineRunMb)XIO(G_b_LineJogMb)XIO(GTU_b_FwJog_Mb)XIO(GTU_b_RvJog_Mb)OTE(b_Execlusive_Zero);
				N: XIC(b_Zero_S_IL)XIC(b_StrtPBAvar)XIC(G_b_CNV1_MC_Intrvl_OK)OTE(b_ZeroStrtOK);
				N: XIC(b_Run_ES_IL)XIO(b_RunFin)XIC(b_Execlusive_Zero)XIO(G_b_LineZeroCmplt)[XIC(M11ETH:1:I.Pt03.Data) XIC(b_ZeroStrtOK) ,XIC(G_b_LineZeroPstnMb) ]OTE(G_b_LineZeroPstnMb);
				N: XIC(G_b_LineZeroPstnMb)[XIO(GCMND_b_LineStp) ,XIO(b_Run_SFS_IL) ,XIO(b_Run_Q_Stp_IL) ,XIO(b_Zero_S_IL) ,XIC(G_b_LineZeroStopHb) ][OTE(G_b_LineZeroStopHb) ,XIC(G_b_FryrZeroSpdRch) OTE(b_ZeroForceFin) ];
				N: [XIC(G_b_LineStpHb) ,XIC(G_b_LineZeroPstnMb) ][XIC(b_Angle_is_LowSpeed) OTE(G_b_LineZeroSerching) ,XIC(G_b_LineZeroSerching) XIC(Local:2:I.Pt05.Data) [OTE(G_b_LineOriRTB_StopKP) ,XIC(G_b_FryrZeroSpdRch) OTE(G_b_LineZeroCmplt) ] ];
				N: [XIC(G_b_LineStpHb) ,XIC(G_b_LineZeroPstnMb) ][GEQ(GLIB_f_LineZ_pstnSpd_ns,TPTO02_MTR_FRYR.f_Spd_me) ,XIC(b_ZeroRough) ]OTE(b_ZeroRough);
				N: XIC(b_ZeroRough)[XIC(Local:2:I.Pt05.Data) ,XIC(b_Z_Rough_Rst) ]OTE(b_Z_Rough_Rst);
				N: XIC(b_Z_Rough_Rst)[GRT(G_f_FRYR_Angl_me,GLIB_f_Z_pstnSpdChngAngl) LES(G_f_FRYR_Angl_me,350) ,XIC(b_Angle_is_LowSpeed) ]OTE(b_Angle_is_LowSpeed);
				N: XIO(G_b_LineZeroCmplt)[TON(tmr_RstDly,?,?) ,XIC(tmr_RstDly.DN) TON(tmr_RstFin,?,?) ,XIC(tmr_RstDly.DN) XIO(tmr_RstFin.DN) OTE(b_Z_Fine_Rst) ];
				N: [XIC(b_Z_Rough_Rst) ,XIC(b_Z_Fine_Rst) ]OTE(G_b_Fryr_CntrRst);
		END_ROUTINE

		ROUTINE R05_FRYR_Run 
				RC: "///////////////////////////////////////////////////////////////////////////// Fryer Servo On Inter Lock ///////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: XIO(G_b_Alm1IL[0])XIO(G_b_Alm1IL[7])XIO(G_b_Alm1IL[8])XIO(G_b_Alm1IL[9])XIO(G_b_Alm1IL[10])XIO(G_b_Alm1IL[11])XIO(G_b_Alm1IL[14])XIO(G_b_Alm1IL[15])XIO(G_b_Alm1IL[17])XIO(G_b_Alm1IL[19])XIO(G_b_Alm1IL[24])XIO(G_b_Alm1IL[28])XIO(G_b_Alm1IL[105])XIO(G_b_Alm3IL[61])OTE(b_FRYR_ServoIL);
				RC: "//////////////////////////////////////////////////////// SV1 Conveter Magnet Contactor And Servo On //////////////////////////////////////////////////";
				N: [XIC(G_b_LineRunMb) ,XIC(G_b_LineJogMb) ,XIC(G_b_LineZeroPstnMb) ]XIO(G_b_F10)[TOF(tmr_FRYR_MC,?,?) ,TON(tmr_FRYR_SvOn,?,?) ];
				N: XIC(b_FRYR_ServoIL)XIC(tmr_FRYR_MC.DN)OTE(G_b_FRYR_MC_ON);
				N: XIC(b_FRYR_ServoIL)OTE(G_b_FRYR_SV_ENBL);
				N: XIC(b_FRYR_ServoIL)XIC(tmr_FRYR_SvOn.DN)OTE(G_b_FRYR_SV_ON);
				RC: "//////////////////////////////////////////////////////////// Fryer Disc Brake Manual Open Hold /////////////////////////////////////////////////////";
				N: [XIC(b_FRYR_Brk_Opn_SSW) ,XIC(b_FRYR_Brk_ManOPN_Hold) ]XIO(G_b_FRYR_SV_ON)XIO(b_FRYR_Brk_Cls_SSW)OTE(b_FRYR_Brk_ManOPN_Hold);
		END_ROUTINE

		ROUTINE R06_CAP_Run 
				N: XIO(G_b_Alm1IL[0])XIO(G_b_Alm1IL[7])XIO(G_b_Alm1IL[8])XIO(G_b_Alm1IL[9])XIO(G_b_Alm1IL[10])XIO(G_b_Alm1IL[11])XIO(G_b_Alm1IL[14])XIO(G_b_Alm1IL[15])XIO(G_b_Alm1IL[17])XIO(G_b_Alm1IL[20])XIO(G_b_Alm1IL[24])XIO(G_b_Alm1IL[28])XIO(G_b_Alm1IL[105])XIO(G_b_Alm3IL[61])OTE(b_CAP_ServoIL);
				N: [XIC(G_b_LineRunMb) ,XIC(G_b_LineJogMb) ,XIC(G_b_LineZeroPstnMb) ]XIO(G_b_F10)[TOF(tmr_CAP_MC,?,?) ,TON(tmr_CAP_SvOn,?,?) ];
				N: XIC(b_CAP_ServoIL)XIC(tmr_CAP_MC.DN)OTE(G_b_CAP_MC_ON);
				N: XIC(b_CAP_ServoIL)OTE(G_b_CAP_SV_ENBL);
				N: XIC(b_CAP_ServoIL)XIC(tmr_CAP_SvOn.DN)OTE(G_b_CAP_SV_ON);
		END_ROUTINE

		ROUTINE R07_OutPut 
				N: [XIC(G_b_FRYR_MC_ON) ,XIC(b_FRYR_Brk_ManOPN_Hold) ]OTE(Local:3:O.Pt13.Data);
				RC: "/////////////////////////////////////////////////// Line Run Pirot Lamp ///////////////////////////////////////////////////////";
				N: [XIC(G_b_LineRunMb) ,XIC(G_b_LineJogMb) ,XIC(M11ETH:2:I.Pt06.Data) ][OTE(M11ETH:3:O.Pt00.Data) ,OTE(M21ETH:2:O.Pt02.Data) ,OTE(M31_1ETH:4:O.Pt03.Data) ,OTE(M32_1ETH:4:O.Pt03.Data) ];
				N: XIC(G_b_OP_Dly)[XIC(G_b_LineZeroCmplt) ,XIC(b_Fryr_is_Z_Pstn) ]XIC(Local:2:I.Pt05.Data)OTE(b_Fryr_is_Z_Pstn);
				N: [XIC(G_b_LineZeroSerching) XIC(G_b_Flicker) ,XIC(b_Fryr_is_Z_Pstn) ,XIC(M11ETH:2:I.Pt06.Data) ]OTE(M11ETH:3:O.Pt04.Data);
		END_ROUTINE

		CHILD_PROGRAMS
		END_CHILD_PROGRAMS

	END_PROGRAM

	PROGRAM P18_MasterSpeedcalc (MAIN := "MainRoutine",
	                             MODE := 0,
	                             DisableFlag := 0,
	                             UseAsFolder := 0)
		TAG
			b_FryerDrctnRev : BOOL (RADIX := Decimal) := 0;
			b_Jog_Speed : BOOL (Description := "Jog Speed m92",
			            RADIX := Decimal) := 0;
			b_OriRTB_Speed : BOOL (Description := "Origin RTB Speed m93",
			            RADIX := Decimal) := 0;
			b_Prdctn_Speed : BOOL (Description := "Rrodution Speed m91",
			            RADIX := Decimal) := 0;
			b_SrUp_Speed : BOOL (Description := "Set Up Speed m90",
			            RADIX := Decimal) := 0;
			fryer_SFS : SFS00  := [11,0.00000000e+000,4.16666651e+000,4.16666651e+000,0.00000000e+000,0.00000000e+000,[5,1,2147483647
					,0,0,2,-196595084,5632,990057071,0,0,1],[5,1,2147483647,0,0,2,-196587780,5632,990057071,0,0,1],0.00000000e+000
					,0.00000000e+000,0.00000000e+000,4.16666651e+000,4.16666651e+000,[1,1,0.00000000e+000]];
			f_Acc : REAL (Description := "Acceleration [rpm/s]",
			            RADIX := Float) := 4.16666651e+000;
			f_DeccN : REAL (Description := "Decceleration [rpm/s]",
			            RADIX := Float) := 4.16666651e+000;
			f_DeccQ : REAL (Description := "Decceleration [rpm/s] for Q Stop",
			            RADIX := Float) := 8.33333300e+000;
			f_Spd_Jog_ns : DINT (RADIX := Decimal) := 10;
			f_Spd_Prdct_ns : REAL (RADIX := Float) := 2.00000000e+002;
			f_Spd_SUP_ns : REAL (RADIX := Float) := 1.25000000e+001;
			f_Spd_Zero_ns : REAL (RADIX := Float) := 5.00000000e+000;
			f_Spd_Z_Low_ns : DINT (RADIX := Decimal) := 2;
		END_TAG

		ROUTINE MainRoutine 
				N: JSR(R02_FRYR_SpdRf,0);
				N: JSR(R03_CAP_SpdRf,0);
				N: JSR(R04_SpdFlg,0);
		END_ROUTINE

		ROUTINE R02_FRYR_SpdRf 
				N: MOV(TPFRM_RUNSET.f_FRYRSpdSUp_ns,f_Spd_SUP_ns)MOV(TPFRM_RUNSET.f_FRYRSpdPrdct_ns,f_Spd_Prdct_ns);
				N: MOV(GLIB_f_LineZ_pstnSpd_ns,f_Spd_Zero_ns)MOV(GLIB_f_LineZ_pstnLowSpd_ns,f_Spd_Z_Low_ns);
				N: MOV(GLIB_f_LineJogSpd_ns,f_Spd_Jog_ns);
				RC: "/////////////////////////////////////////////////////////  Change Nominal Set of Fryer Rotation Speed ///////////////////////////////////////////////////";
				N: XIC(G_b_FRYR_SV_ON)XIC(G_b_LineRunMb)[XIC(SV1_Axis1_FRYR.ServoActionStatus) ,XIC(SV1_Axis2_TU.ServoActionStatus) ][XIO(G_b_MasterUp) MOV(f_Spd_SUP_ns,fryer_SFS.f_ns) OTE(G_b_Spd_is_StrtUp) ,XIC(G_b_MasterUp) MOV(f_Spd_Prdct_ns,fryer_SFS.f_ns) OTE(G_b_Spd_is_Prdct) ];
				N: XIC(G_b_CAP_SV_ON)XIC(G_b_LineJogMb)MOV(f_Spd_Jog_ns,fryer_SFS.f_ns)OTE(G_b_Spd_is_Jog);
				N: XIC(G_b_FRYR_SV_ON)[XIC(G_b_LineStpHb) ,XIC(G_b_LineZeroPstnMb) ][XIO(G_b_LineZeroSerching) MOV(f_Spd_Zero_ns,fryer_SFS.f_ns) ,XIC(G_b_LineZeroSerching) MOV(f_Spd_Z_Low_ns,fryer_SFS.f_ns) ]OTE(b_OriRTB_Speed);
				N: [XIO(G_b_LineRunMb) XIO(G_b_LineJogMb) XIO(G_b_LineZeroPstnMb) ,XIC(G_b_LineOriRTB_StopKP) ,XIC(G_b_LineQstpHb) ,XIC(G_b_LineJogStpHb) ,XIC(G_b_LineJogQstpHb) ]MOV(0,fryer_SFS.f_ns);
				RC: "//////////////////////////////////////////////////// Set Acceleration and Decceleration /////////////////////////////////////////////////";
				N: DIV(TPFRM04_f_FRYR_Acc_ns,60,f_Acc)MOV(f_Acc,fryer_SFS.f_Accrat);
				N: DIV(TPFRM04_f_FRYR_Dcc_ns,60,f_DeccN)MOV(f_DeccN,fryer_SFS.f_Dccrat);
				N: [XIC(G_b_LineQstpHb) ,XIC(G_b_LineJogQstpHb) ]DIV(TPFRM04_f_FRYR_QckStpDcc_ns,60,f_DeccQ)MOV(f_DeccQ,fryer_SFS.f_Dccrat);
				RC: "////////////////////////////////////////////////////// Set AS Enable ////////////////////////////////////////////////////";
				N: [XIC(G_b_LineRunMb) ,XIC(G_b_LineJogMb) ,XIC(G_b_LineZeroPstnMb) ]OTE(fryer_SFS.b_NoRst);
				N: OTE(fryer_SFS.EnableIn);
				RC: "///////////////////////////////////////////////////// SoftStart Calcuration AOI Exec ////////////////////////////////////////////////////";
				N: SFS00(fryer_SFS);
				RC: "// GFRYR_f_Spd_as is cotrol use.  it has +, - as this Direction, + is Z twist, - is S twist. // $N"
				    "// TPTO02_f_FRYR_Spd_me is Tpuvhpanel Indication and its value is absolute. //";
				N: MOV(fryer_SFS.f_as,GFRYR_f_Spd_as)MOV(fryer_SFS.f_as,TPTO02_MTR_FRYR.f_Spd_me);
				N: XIC(TPFRM_RUNSET.b_FRYR_TwistDrct)NEG(GFRYR_f_Spd_as,GFRYR_f_Spd_as);
		END_ROUTINE

