			'	
			'end_if;
			'
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'
			'// Make Machine Name Print Commnad //////////////////////////////////////////////////////
			'
			'if ( b_PrntStt[20] or b_PrntStt[44] ) then
			'	
			'	s_Tmp2 := '^AE';									// Select Font E(Big)
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '^FD';									// Start of Print String
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := 'TW1';									// Name of This Machine
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '^FS';									// END of Print String
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '^LH0,35';							    // Feed 35 Dot
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	
			'end_if;
			'
			'// Make Line Print Commnad //////////////////////////////////////////////////////////////
			'
			'if b_PrntStt[32] then
			'	
			'	s_Tmp2 := '^AD';									// Select Font D
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '^FD';									// Start of Print String
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '************************';				// This is Line
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '^FS';									// END of Print String
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '^LH0,18';							    // Feed 18 Dot
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	
			'end_if;
			'
			'// Make 1 Line Feed Commnad //////////////////////////////////////////////////////////////
			'
			'if ( b_PrntStt[36] or b_PrntStt[52] or b_PrntStt[92] ) then
			'	
			'	s_Tmp2 := '^LH0,18';							    // Feed 18 Dot
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	
			'end_if;
			'
			'// Make 3 Line Feed Commnad ///////////////////////////////////////////////////////////////
			'
			'if ( b_PrntStt[36] or b_PrntStt[52] or b_PrntStt[92] ) then
			'	
			'	s_Tmp2 := '^LH0,54';							    // Feed 18 Dot *3
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	
			'end_if;
			'
			'// Make Product Name Commnad /////////////////////////////////////////////////////////////
			'
			'if b_PrntStt[48] then
			'	
			'	s_Tmp2 := '^AD';									// Select Font D
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '^FD';									// Start of Print String
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	CONCAT(s_Tmp1, s_PrdctName, s_Tmp1);				// Add Product Name
			'	s_Tmp2 := '^FS';									// END of Print String
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '^LH0,18';							    // Feed 18 Dot
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	
			'end_if;
			'
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'
			'// Make Event Stringth Commnad //////////////////////////////////////////////////////////
			'
			'if b_PrntStt[48] then
			'	
			'	// Set Point Number
			'	
			'	DTOS(nn_PrntNumber, s_Number);
			'	if(3< s_Number.LEN ) then s_Number.LEN := 3; end_if;
			'	
			'	// Set Event Name
			'	
			'	s_EvntName := evntPoint.s_EvntName; 
			'	if (12 < s_EvntName.LEN ) then s_EvntName.LEN := 12; end_if;
			'	
			'	// Translate Lenght Value INt to ASCII
			'	
			'	DTOS(evntPoint.f_Length, s_Length);
			'	if( 7< s_Length.LEN ) then s_Length.LEN := 7; end_if;
			'	
			'	// Make Space Strings
			'	
			'	n_tmp := 24 - s_EvntName.LEN - s_Length.LEN - s_Number.LEN ;
			'	if n_tmp < 0 then n_tmp := 0; end_if;
			'	
			'	s_Space := '';
			'	
			'	FOR nn_loop := 1
			'		TO n_tmp
			'		BY 1
			'		do
			'		
			'		s_Tmp2 := '';
			'		
			'		CONCAT(s_Space, s_Tmp2, s_Space);
			'		
			'	end_for;
			'	
			'	s_Tmp2 := '^AD';									// Select Font D
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '^FD';									// Start of Print String
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	
			'	CONCAT(s_Tmp1, s_Number, s_Tmp1);					// Add Event Number
			'	CONCAT(s_Tmp1, s_EvntName, s_Tmp1);					// Add EventName Name
			'	CONCAT(s_Tmp1, s_Space, s_Tmp1);					// Add Space
			'	CONCAT(s_Tmp1, s_Length, s_Tmp1);					// Add Length
			'	s_Tmp2 := 'm';										// Add "m"
			'	
			'	s_Tmp2 := '^FS';									// END of Print String
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '^LH0,18';							    // Feed 18 Dot
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	
			'end_if;
			'
			'
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'
			'// Make Total Stringth Commnad //////////////////////////////////////////////////////////
			'
			'if b_PrntStt[96] then
			'	
			'	// Set Total Lenght String
			'	
			'	if (12 < s_TotalLName.LEN ) then s_TotalLName.LEN := 12; end_if;
			'	
			'	// Translate TOTALLenght Value INt to ASCII
			'	
			'	DTOS(f_TotalLength, s_Length);
			'	if( 7< s_Length.LEN ) then s_Length.LEN := 7; end_if;
			'	
			'	// Make Space Strings
			'	
			'	n_tmp := 24 - s_TotalLName.LEN - s_Length.LEN ;
			'	if n_tmp < 0 then n_tmp := 0; end_if;
			'	
			'	s_Space := '';
			'	
			'	FOR nn_loop := 1
			'		TO n_tmp
			'		BY 1
			'		do
			'		
			'		s_Tmp2 := '';
			'		
			'		CONCAT(s_Space, s_Tmp2, s_Space);
			'		
			'	end_for;
			'	
			'	s_Tmp2 := '^AD';									// Select Font D
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '^FD';									// Start of Print String
			'	
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	CONCAT(s_Tmp1, s_TotalLName, s_Tmp1);				// Add TotalLengthIten
			'	CONCAT(s_Tmp1, s_Space, s_Tmp1);					// Add Space
			'	CONCAT(s_Tmp1, s_Length, s_Tmp1);					// Add Length
			'	s_Tmp2 := 'm';										// Add "m"
			'	
			'	s_Tmp2 := '^FS';									// END of Print String
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	s_Tmp2 := '^LH0,18';							    // Feed 18 Dot
			'	CONCAT(s_Tmp1, s_Tmp2, s_Tmp1);
			'	
			'end_if;
			'
			'
			'
			'
		END_ST_ROUTINE

		ROUTINE R05_PrinterIF_O 
				N: MOV(1,EvPrntr:O.XF_FormatNumber);
				N: MOV(0,EvPrntr:O.XF_FormatName[0])COP(EvPrntr:O.XF_FormatName[0],EvPrntr:O.XF_FormatName[1],23);
				N: MOV(0,EvPrntr:O.XF_Field1[0])COP(EvPrntr:O.XF_Field1[0],EvPrntr:O.XF_Field1[1],67);
				N: MOV(0,EvPrntr:O.XF_Field2[0])COP(EvPrntr:O.XF_Field2[0],EvPrntr:O.XF_Field2[1],19);
				N: MOV(0,EvPrntr:O.XF_Field3[0])COP(EvPrntr:O.XF_Field3[0],EvPrntr:O.XF_Field3[1],19);
				N: MOV(0,EvPrntr:O.XF_Field4[0])COP(EvPrntr:O.XF_Field4[0],EvPrntr:O.XF_Field4[1],19);
				N: MOV(0,EvPrntr:O.XF_Field5[0])COP(EvPrntr:O.XF_Field5[0],EvPrntr:O.XF_Field5[1],19);
				N: COP(ns_ParserData[0],EvPrntr:O.RawParserData[0],320);
				N: XIC(b_Cmd_PrintAll)ADD(EvPrntr:O.SequenceNumber,1,EvPrntr:O.SequenceNumber);
				N: XIO(b_Cmd_PrintAll)GEQ(EvPrntr:O.SequenceNumber,32767)MOV(0,EvPrntr:O.SequenceNumber);
		END_ROUTINE

		ROUTINE R06_PrinterIF_I 
				N: EQU(EvPrntr:I.SystemStatus.Sec1PrinterPause,1)OTE(b_PrntrPaused);
				N: EQU(EvPrntr:I.SystemStatus.Sec2PrinterError,1)OTE(b_PrntrErr);
				N: EQU(EvPrntr:I.SystemStatus.Sec5PrinterError,1)OTE(b_PrntrWarn);
		END_ROUTINE

		ROUTINE R11_Output 
				N: XIC(b_PrntStt[72])OTE(GEVENT_b_EvPrntCmplt);
		END_ROUTINE

		CHILD_PROGRAMS
		END_CHILD_PROGRAMS

	END_PROGRAM

	PROGRAM P70_ToutchPanel (MAIN := "MainRoutine",
	                         MODE := 0,
	                         DisableFlag := 0,
	                         UseAsFolder := 0)
		TAG
			b_BindIL : FBD_ONESHOT  := [1,1,0.00000000e+000];
			b_BNDIL_Act : BOOL (RADIX := Decimal) := 0;
			b_BNDIL_Dsbl : BOOL (RADIX := Decimal) := 0;
			b_ElistDwnOld : BOOL (RADIX := Decimal) := 0;
			b_EListDwnPls : BOOL (RADIX := Decimal) := 0;
			b_EListUpOld : BOOL (RADIX := Decimal) := 0;
			b_EListUpPls : BOOL (RADIX := Decimal) := 0;
			b_E_P_DwnOld : BOOL (RADIX := Decimal) := 0;
			b_E_P_DwnPls : BOOL (RADIX := Decimal) := 0;
			b_E_P_UpOld : BOOL (RADIX := Decimal) := 0;
			b_E_P_UpPls : BOOL (RADIX := Decimal) := 0;
			b_F13 : FBD_ONESHOT  := [1,1,0.00000000e+000];
			b_Traverse_Return_To_Origin_Comp : FBD_ONESHOT  := [3,1,0.00000000e+000];
			b_W1 : FBD_ONESHOT  := [1,1,0.00000000e+000];
			b_W2 : FBD_ONESHOT  := [1,1,0.00000000e+000];
			nn_C : DINT (RADIX := Decimal) := 30;
			nn_L : DINT (RADIX := Decimal) := 0;
			nn_P : DINT (RADIX := Decimal) := 0;
			n_BBN_Slct_No : INT (RADIX := Decimal) := 5;
			n_Step_Buffer : INT (Description := "D260",
			            RADIX := Decimal) := 56;
			n_Step_Log_Buffer : INT[50] (RADIX := Decimal) := [65,56,55,45,40,32,31,30,20,15,7,6,5,3,2,1,95,90,81,80,70,65,56,55,45,40,32,31,30,20,15,7,6,5,3,2,1,95,90,81,80,70,65,56,65,56,55
