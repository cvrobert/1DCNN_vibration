				N: XIC(b_TRV_EStop_S)XIO(G_b_LineRunJogZero)XIO(b_TRV_QckJog_TUSide_Mb)XIO(b_TRV_QckJog_POside_Mb)XIO(G_b_Alm1IL[32])XIO(G_b_Alm1IL[31])XIO(G_b_Alm1IL[24])OTE(b_TRV_OriRTB_IL);
				N: XIC(b_TRV_OriRTB_PB_Rsng)[XIO(b_TRV_OriRTB_Mb) OTE(b_OriRTB_ON_Pls) ,XIC(b_TRV_OriRTB_Mb) OTE(b_OriRTB_OFF_Pls) ];
				N: XIC(b_TRV_OriRTB_IL)XIO(tmr_On_DLY[4].DN)[XIC(b_OriRTB_ON_Pls) ,XIC(b_TRV_OriRTB_Mb) ]OTE(b_TRV_OriRTB_Mb);
				N: XIC(b_TRV_OriRTB_Mb)[XIC(b_OriRTB_OFF_Pls) ,XIC(b_TRV_OriRTB_Stt[40]) ,XIC(b_TRV_OriRTB_OFHold) ][OTE(b_TRV_OriRTB_OFHold) ,TON(tmr_On_DLY[4],?,?) ];
				N: [XIC(G_b_Flicker) XIC(b_TRV_OriRTB_Mb) ,XIC(GSTT_b_LineState[200]) ][XIO(tmr_On_DLY[5].DN) OTE(b_TRV_OriRTB_PL_Aux) ,XIC(GSTT_b_LineState[200]) TON(tmr_On_DLY[5],?,?) ];
				RC: "CRoberts 06/06/2024  Added parallel conditional statement to allow traverse while door is open. ";
				N: [XIC(b_TRV_EStop_S) ,CMP(TPTO02_f_LineSpd_me <= 1) ][XIO(G_b_Alm1IL[34]) ,XIO(G_b_F1) ]XIO(b_TRV_OriRTB_Mb)OTE(b_TRV_QckJog_IL);
				N: XIC(b_TRV_QckJog_IL)XIO(b_TRV_TUSide_SftLimit)XIO(b_TRV_QckJog_POside_Mb)XIC(M11ETH:1:I.Pt06.Data)OTE(b_TRV_QckJog_TUSide_Mb);
				N: XIC(b_TRV_QckJog_IL)XIO(b_TRV_POSide_SftLimit)XIO(b_TRV_QckJog_TUSide_Mb)XIC(M11ETH:1:I.Pt05.Data)OTE(b_TRV_QckJog_POside_Mb);
				N: [XIC(b_TRV_OriRTB_Mb) ,XIC(b_TRV_QckJog_TUSide_Mb) ,XIC(b_TRV_QckJog_POside_Mb) ]OTE(b_TRV_Run_S);
				N: [XIC(b_TRV_EStop_T) XIC(G_b_LineRunJogZero) ,XIC(b_TRV_Run_S) ]XIC(G_b_CNV1_MC_Intrvl_OK)OTE(b_TRV_MCON_Mb);
