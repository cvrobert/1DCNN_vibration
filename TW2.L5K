				N: XIC(M11ETH:1:I.Pt11.Data)OSR(b_StorageBit2_01,b_TRV_OriRTB_PB_Rsng);
				N: XIO(G_b_Alm1IL[0])XIO(G_b_Alm1IL[7])XIO(G_b_Alm1IL[8])XIO(G_b_Alm1IL[9])XIO(G_b_Alm1IL[10])XIO(G_b_Alm1IL[11])XIO(G_b_Alm1IL[14])OTE(b_TRV_EStop_Aux1);
