			'b_PrntStt[41] :=  ( nn_PrntStt = 41 );
			'b_PrntStt[44] :=  ( nn_PrntStt = 44 );
			'b_PrntStt[45] :=  ( nn_PrntStt = 45 );
			'b_PrntStt[48] :=  ( nn_PrntStt = 48 );
			'b_PrntStt[49] :=  ( nn_PrntStt = 49 );
			'b_PrntStt[52] :=  ( nn_PrntStt = 52 );
			'b_PrntStt[53] :=  ( nn_PrntStt = 53 );
			'
			'b_PrntStt[60] :=  ( nn_PrntStt = 60 );
			'
			'b_PrntStt[62] :=  ( nn_PrntStt = 62 );
			'b_PrntStt[69] :=  ( nn_PrntStt = 69 );
			'b_PrntStt[72] :=  ( nn_PrntStt = 72 );
			'
			'b_PrntStt[90] :=  ( nn_PrntStt = 90 );
			'b_PrntStt[92] :=  ( nn_PrntStt = 92 );
			'b_PrntStt[93] :=  ( nn_PrntStt = 93 );
			'b_PrntStt[96] :=  ( nn_PrntStt = 96 );
			'b_PrntStt[97] :=  ( nn_PrntStt = 97 );
			'b_PrntStt[100]:=  ( nn_PrntStt =100 );
			'b_PrntStt[101]:=  ( nn_PrntStt =101 );
			'b_PrntStt[104]:=  ( nn_PrntStt =104 );
			'
		END_ST_ROUTINE

		ROUTINE R03_PrntComStateTrns 
				N: XIC(b_InitState)MOV(0,nn_PrntStt);
				N: XIC(b_PrntStt[0])[XIC(b_TestExec) MOV(10,nn_PrntStt) ,XIC(b_PrdctStrt) MOV(30,nn_PrntStt) ];
				N: XIC(b_PrntStt[10])MOV(12,nn_PrntStt);
				N: XIC(b_PrntStt[12])MOV(13,nn_PrntStt);
				N: XIC(b_PrntStt[13])[XIC(b_PrntOutComp) ,XIC(tmrR03[0].DN) ]MOV(16,nn_PrntStt);
				N: XIC(b_PrntStt[16])MOV(17,nn_PrntStt);
				N: XIC(b_PrntStt[17])[XIC(b_PrntOutComp) ,XIC(tmrR03[1].DN) ]MOV(20,nn_PrntStt);
				N: XIC(b_PrntStt[20])MOV(21,nn_PrntStt);
				N: XIC(b_PrntStt[21])[XIC(b_PrntOutComp) ,XIC(tmrR03[2].DN) ]MOV(0,nn_PrntStt);
				N: XIC(b_PrntStt[30])MOV(32,nn_PrntStt);
				N: XIC(b_PrntStt[32])MOV(33,nn_PrntStt);
				N: XIC(b_PrntStt[33])[XIC(b_PrntOutComp) ,XIC(tmrR03[3].DN) ]MOV(36,nn_PrntStt);
				N: XIC(b_PrntStt[36])MOV(37,nn_PrntStt);
				N: XIC(b_PrntStt[37])[XIC(b_PrntOutComp) ,XIC(tmrR03[4].DN) ]MOV(40,nn_PrntStt);
				N: XIC(b_PrntStt[40])MOV(41,nn_PrntStt);
				N: XIC(b_PrntStt[41])[XIC(b_PrntOutComp) ,XIC(tmrR03[5].DN) ]MOV(44,nn_PrntStt);
				N: XIC(b_PrntStt[44])MOV(45,nn_PrntStt);
				N: XIC(b_PrntStt[45])[XIC(b_PrntOutComp) ,XIC(tmrR03[6].DN) ]MOV(48,nn_PrntStt);
				N: XIC(b_PrntStt[48])MOV(49,nn_PrntStt);
				N: XIC(b_PrntStt[49])[XIC(b_PrntOutComp) ,XIC(tmrR03[7].DN) ]MOV(52,nn_PrntStt);
				N: XIC(b_PrntStt[52])MOV(53,nn_PrntStt);
				N: XIC(b_PrntStt[53])[XIC(b_PrntOutComp) ,XIC(tmrR03[8].DN) ]MOV(60,nn_PrntStt);
				N: XIC(b_PrntStt[60])[XIC(b_PrntEvntRq) MOV(62,nn_PrntStt) ,XIC(b_PrdctChanged) MOV(90,nn_PrntStt) ];
				N: XIC(b_PrntStt[62])MOV(69,nn_PrntStt);
				N: XIC(b_PrntStt[69])[XIC(b_PrntOutComp) ,XIC(tmrR03[9].DN) ]MOV(72,nn_PrntStt);
				N: XIC(b_PrntStt[72])[XIO(b_PrntEvntRq) ,XIC(tmrR03[10].DN) ]MOV(60,nn_PrntStt);
				N: XIC(b_PrntStt[90])XIC(tmrR03[11].DN)MOV(92,nn_PrntStt);
				N: XIC(b_PrntStt[92])MOV(93,nn_PrntStt);
				N: XIC(b_PrntStt[93])[XIC(b_PrntOutComp) ,XIC(tmrR03[12].DN) ]MOV(96,nn_PrntStt);
				N: XIC(b_PrntStt[96])MOV(97,nn_PrntStt);
				N: XIC(b_PrntStt[97])[XIC(b_PrntOutComp) ,XIC(tmrR03[13].DN) ]MOV(100,nn_PrntStt);
				N: XIC(b_PrntStt[100])MOV(101,nn_PrntStt);
				N: XIC(b_PrntStt[101])[XIC(b_PrntOutComp) ,XIC(tmrR03[14].DN) ]MOV(104,nn_PrntStt);
				N: XIC(b_PrntStt[104])MOV(0,nn_PrntStt);
				RC: "///////////////////////////////////////////////////////////////////////////// Auxialy Timer For Time Out Of  Each Print Out State ///////////////////////////////////////////////////////////////////";
				N: XIC(b_PrntStt[13])TON(tmrR03[0],?,?);
				N: XIC(b_PrntStt[17])TON(tmrR03[1],?,?);
				N: XIC(b_PrntStt[21])TON(tmrR03[2],?,?);
				N: XIC(b_PrntStt[33])TON(tmrR03[3],?,?);
				N: XIC(b_PrntStt[37])TON(tmrR03[4],?,?);
				N: XIC(b_PrntStt[41])TON(tmrR03[5],?,?);
				N: XIC(b_PrntStt[45])TON(tmrR03[6],?,?);
				N: XIC(b_PrntStt[49])TON(tmrR03[7],?,?);
				N: XIC(b_PrntStt[53])TON(tmrR03[8],?,?);
				N: XIC(b_PrntStt[69])TON(tmrR03[9],?,?);
				N: XIC(b_PrntStt[72])TON(tmrR03[10],?,?);
				N: XIC(b_PrntStt[90])TON(tmrR03[11],?,?);
				N: XIC(b_PrntStt[93])TON(tmrR03[12],?,?);
				N: XIC(b_PrntStt[97])TON(tmrR03[13],?,?);
				N: XIC(b_PrntStt[101])TON(tmrR03[14],?,?);
		END_ROUTINE

		ST_ROUTINE R04_MakePrintCmmnd 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// Make Printer Commands ////////////////////////////////////////////////////////////////
