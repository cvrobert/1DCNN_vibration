		ST_ROUTINE Logic (Description := "Soft Start for Refarence$NIchiro Hatanaka$N2019.11.15")
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'////////////////////////////////////////////////////////////////////////
			'// Name: SFS00  ver 1.03
			'////////////////////////////////////////////////////////////////////////
			'// SoftStart Culculate Program
			'// f_ns is Nominal Set Value.
			'// f_as is Actual Set Value With SoftStart, it will follow f_ns.
			'// Unfortunatery ST language of R/W cant accept "LongReal" type with calculation.
			'// That's why this Program used Timer for SoftStart. 
			'// This Algolism is old one of SEI.
			'// Ver 1.01 Ichiro Hatanaka 2019.11.18
			'// Ver 1.02 Ichiro Hatanaka 2019.11.30
			'// Modify if acceleraion or Decceleration is changed whille doing Accel or 
			'// Deccel, Momory "_as" to temmporary memory and clear the timer accume value 
			'// and then, continue accel or decell with new acceleration or decceleration.
			'// ver 1.03 ichiro Hatanaka 2020.01.03
			'// change some code to  more simple discription.
			'
			'// Make bits which express acceleration or decceleraion. 
			'
			'b_Acc := ( f_as < f_ns );
			'b_Dcc := ( f_ns < f_as );
			'b_Rch := ( f_as = f_ns );
			'
			'// malke Pulse of acceleraion or decceleration.
			'
			'b_AccPls := not(b_AccOld) and (b_Acc);
			'b_DccPls := not(b_DccOld) and (b_Dcc);
			'
			'b_AccOld := b_Acc;
			'b_DccOld := b_Dcc;
			'
			'// make pulseof Acceleration or Decceleraiton changed.
			'
			'b_AccratChanged := (f_Accrat <> f_AccratOld );
			'b_DccratChanged := (f_Dccrat <> f_DccratOld );
			'
			'f_AccratOld := f_Accrat;
			'f_DccratOld := f_Dccrat;
			'
			'//20191227 edit
			'if ( (b_AccPls) or (b_DccPls) or (b_AccratChanged) or (b_DccratChanged)) then
			'	f_as_Temp := f_as;
			'end_if;
			'
			'// Timers for Acceleration or Decceleration
			'
			'tmr_ACC.EnableIn := 1;
			'tmr_ACC.PRE := 2147483647; // 2,147,483,647 [ms] = 2,147,483[s] = 35,791[min] = 596.5[hr]
			'tmr_ACC.Reset := ( not(b_Acc) or (b_AccratChanged) );
			'tmr_ACC.TimerEnable := b_Acc;
			'TONR(tmr_ACC);
			'f_Dummy01 := tmr_ACC.ACC;
			'f_SecForAcc := f_Dummy01 / 1000;
			'
			'
			'tmr_DCC.EnableIn := 1;
			'tmr_DCC.PRE := 2147483647; // 2,147,483,647 [ms] = 2,147,483[s] = 35,791[min] = 596.5[hr]
			'tmr_DCC.Reset := ( not(b_Dcc) or (b_DccratChanged) );
			'tmr_DCC.TimerEnable := b_Dcc;
			'TONR(tmr_DCC);
			'f_Dummy01 := tmr_DCC.ACC;
			'f_SecForDcc := f_Dummy01 / 1000;
			'
			'// Calculate Acceieration or Decceleration.
			'// "f_Accrat" is Acceleration Rate [U/s] "f_Dccrat" is Decceleration Rate [U/s]
			'
			'if(b_Acc) then
			'	f_as := f_as_Temp + f_Accrat * f_SecForAcc;
			'	if ( f_ns < f_as) then f_as := f_ns; end_if;
			'end_if;
			'
			'if(b_Dcc) then
			'	f_as := f_as_Temp - f_Dccrat * f_SecForDcc;	
			'	if (f_as < f_ns) then f_as := f_ns; end_if;
			'end_if;
			'
			'
			'// Disable OutPut Value With Reset Flag( OFF = Reset)
			'
			'if not(b_NoRst) then
			'	f_as := 0;
			'end_if;
		END_ST_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

