		ROUTINE R11_OutPut 
				N: XIC(b_PriCoStt[16])OTE(GEVENT_b_PrntRq);
				N: COP(event_List,GEVENT_LIST[0],1)MOV(nn_EventStt,GEVENT_nn_Stt)COP(printPoint1,GEVENT_PRNT_POINT,1);
				N: XIC(b_ShiftListPls)COP(GEVENT_LIST[1],GEVENT_LIST[2],1)COP(GEVENT_LIST[0],GEVENT_LIST[1],1);
				N: ADD(event_List.n_Printed,1,GEVENT_nn_Number);
		END_ROUTINE

		ST_ROUTINE R50_UpDate 
