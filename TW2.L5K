				N: [GEQ(TPTO02_MTR_BND2.f_Trq_me,TPFRM04_f_SV_MtrTrqHiAlm) ,LEQ(TPTO02_MTR_BND2.f_Trq_me,f_Servo_Waring_Neg) ]TON(tmr_Trq_Warn[5],?,?);
