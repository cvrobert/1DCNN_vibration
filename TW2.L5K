		ROUTINE R05_ZeroSttTrns 
				RC: "////////////////////////////////////////////////////////////////////////////// Preparation ////////////////////////////////////////////////////////////////////////////";
				N: XIC(G_b_OP)OSR(b_StorageBit5_01,b_OP_Rsng);
				N: XIC(b_TRV_OriRTB_Mb)[OSR(b_StorageBit5_02,b_TRV_OriRTB_Mb_Rsng) ,OSF(b_StorageBit5_03,b_TRV_OriRTB_Mb_Fllng) ];
