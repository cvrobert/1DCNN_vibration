					,3.17205734e+001,0.00000000e+000,3.46016693e+002,0.00000000e+000,3.40000000e+002,2.70000000e+002
					,7.70000000e+002,[5,1,5000,0,0,1,-196587777,5632,981668463,0,0,1],9.51617181e-001,0.00000000e+000,0.00000000e+000
					,1.22400000e-003,[3,1.22400000e-003,[3,7,2147483647,282,0,2,-141348628,5632,990057071,0,282,7],216,1.22400000e+003
					],-7.46653462e-003,-8.00000061e+002];
			takeUp_Jog_SFS : SFS00  := [11,0.00000000e+000,1.50000000e+002,1.50000000e+002,0.00000000e+000,-2.00000000e+001,[5,1,2147483647
					,0,0,1,347971934,5632,981668463,0,0,1],[5,1,2147483647,0,0,2,347971645,5632,990057071,0,0,1],0.00000000e+000
					,0.00000000e+000,0.00000000e+000,1.50000000e+002,1.50000000e+002,[1,1,0.00000000e+000]];
