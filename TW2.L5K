				N: GEQ(TPTO02_MTR_PO[1].f_Ampere,GLIB_f_POINV_TrqHiErr)TON(tmr_PO_Trq_Fatal[1],?,?);
				N: GEQ(TPTO02_MTR_PO[1].f_Ampere,GLIB_f_POINV_TrqHiAlm)TON(tmr_PO_Trq_Warn[1],?,?);
