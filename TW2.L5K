			'    POView_TimeAtMaxOL_s[9] := POHist_LastRunMaxMotorOLDwell_ms[9] / 1000.0;
			'    POView_LineSpeedAtMaxOL[9] := POHist_LastRunLineSpdAtMaxOL[9];
			'    POView_OCCount[9] := POHist_LastRunOCCount[9];
			'    POView_LongestOC_s[9] := POHist_LastRunOCLongest_ms[9] / 1000.0;
			'    POView_OCPeak_A[9] := POHist_LastRunOCPeak_A[9];
			'
			'
			'    (* ----------------------------- PO11 ---------------------------------- *)
			'
			'    POView_MaxCurrent_A[10] := POHist_LastRunMaxCurrent_A[10];
			'    POView_TimeAtMax_s[10] := POHist_LastRunMaxCurrentDwell_ms[10] / 1000.0;
			'    POView_LineSpeedAtMax[10] := POHist_LastRunLineSpdAtMaxCurrent[10];
			'    POView_OLAtMaxCurrent_Pct[10] := POHist_LastRunOLAtMaxCurrent_Pct[10];
			'    POView_MaxMotorOL_Pct[10] := POHist_LastRunMaxMotorOL_Pct[10];
			'    POView_CurrentAtMaxOL_A[10] := POHist_LastRunCurrentAtMaxOL_A[10];
			'    POView_TimeAtMaxOL_s[10] := POHist_LastRunMaxMotorOLDwell_ms[10] / 1000.0;
			'    POView_LineSpeedAtMaxOL[10] := POHist_LastRunLineSpdAtMaxOL[10];
			'    POView_OCCount[10] := POHist_LastRunOCCount[10];
			'    POView_LongestOC_s[10] := POHist_LastRunOCLongest_ms[10] / 1000.0;
			'    POView_OCPeak_A[10] := POHist_LastRunOCPeak_A[10];
			'
			'
			'    (* ----------------------------- PO12 ---------------------------------- *)
			'
			'    POView_MaxCurrent_A[11] := POHist_LastRunMaxCurrent_A[11];
			'    POView_TimeAtMax_s[11] := POHist_LastRunMaxCurrentDwell_ms[11] / 1000.0;
			'    POView_LineSpeedAtMax[11] := POHist_LastRunLineSpdAtMaxCurrent[11];
			'    POView_OLAtMaxCurrent_Pct[11] := POHist_LastRunOLAtMaxCurrent_Pct[11];
			'    POView_MaxMotorOL_Pct[11] := POHist_LastRunMaxMotorOL_Pct[11];
			'    POView_CurrentAtMaxOL_A[11] := POHist_LastRunCurrentAtMaxOL_A[11];
			'    POView_TimeAtMaxOL_s[11] := POHist_LastRunMaxMotorOLDwell_ms[11] / 1000.0;
			'    POView_LineSpeedAtMaxOL[11] := POHist_LastRunLineSpdAtMaxOL[11];
			'    POView_OCCount[11] := POHist_LastRunOCCount[11];
			'    POView_LongestOC_s[11] := POHist_LastRunOCLongest_ms[11] / 1000.0;
			'    POView_OCPeak_A[11] := POHist_LastRunOCPeak_A[11];
			'
			'END_IF;
			'
			'
			'POHist_i := 0; POHist_j := 0;
			'
			'
		END_ST_ROUTINE

		ST_ROUTINE Current_Monitor_Historian 
			'
			'(* ========================================================================= *)
			'(* 1. READ CONTROLLER CLOCK                                                  *)
			'(* ========================================================================= *)
			'
			'(* Microsecond clock used for duration calculations. *)
			'GSV(WALLCLOCKTIME,,CurrentValue,POHist_Now_us);
			'
			'(* Local date/time:
			'   [0] Year
			'   [1] Month
			'   [2] Day
			'   [3] Hour
			'   [4] Minute
			'   [5] Second
			'   [6] Microseconds
			'*)
			'GSV(WALLCLOCKTIME,,LocalDateTime,POHist_NowLocal[0]);
			'
			'
			'(* ========================================================================= *)
			'(* 2. DETERMINE WHETHER THE LINE IS RUNNING                                  *)
			'(* ========================================================================= *)
			'(* Any non-zero line speed starts/maintains a run immediately.               *)
			'(* Line speed must remain exactly zero for 2 seconds before the run ends.    *)
			'(* This prevents brief zero-speed readings from splitting one run into many. *)
			'(* ========================================================================= *)
			'
			'
			'IF ABS(TPTO02_f_LineSpd_me) > 0.1 THEN
			'
			'    (* Line is moving - immediately consider machine running. *)
			'    POHist_LineRunning := 1;
			'
			'    (* Cancel any pending zero-speed stop timer. *)
			'    POHist_ZeroSpeedTiming := 0;
			'
			'    POHist_ZeroSpeedElapsed_us := 0;
			'
			'
			'ELSE
			'
			'
			'    IF POHist_LineRunning THEN
			'
			'
			'        IF NOT POHist_ZeroSpeedTiming THEN
			'
			'            POHist_ZeroSpeedTiming := 1;
			'
			'            POHist_ZeroSpeedStart_us :=
			'                POHist_Now_us;
			'
			'            POHist_ZeroSpeedElapsed_us := 0;
			'
			'        ELSE
			'
			'            (* Continue measuring zero-speed duration. *)
			'
			'            POHist_ZeroSpeedElapsed_us :=
			'                POHist_Now_us -
			'                POHist_ZeroSpeedStart_us;
			'
			'
			'            (*  2.0 seconds *)
			'
			'            IF POHist_ZeroSpeedElapsed_us >= 2000000 THEN
			'
			'                POHist_LineRunning := 0;
			'
			'                POHist_ZeroSpeedTiming := 0;
			'
			'                POHist_ZeroSpeedElapsed_us := 0;
			'
			'            END_IF;
			'
			'        END_IF;
			'
			'    END_IF;
			'
			'END_IF;
			'
			'POHist_RunStartPulse :=
			'	POHist_LineRunning AND NOT POHist_LineRunning_Last;
			'POHist_RunStopPulse :=
			'	NOT POHist_LineRunning AND POHist_LineRunning_Last;
			'	
			'
			'(* ========================================================================= *)
			'(* 3. COPY LIVE PAYOFF CURRENT INTO A SIMPLE ARRAY                           *)
			'(* ========================================================================= *)
			'
			'FOR POHist_i := 0 TO 11 DO
			'
			'    POHist_LiveCurrent_A[POHist_i] :=
			'        TPTO02_MTR_PO[POHist_i].f_Ampere;
			'
			'END_FOR;
			'
			'
			'(* ========================================================================= *)
			'(* 4. NEW RUN - RESET CURRENT-RUN DATA                                       *)
			'(* ========================================================================= *)
			'
			'IF POHist_RunStartPulse THEN
			'
			'    POHist_RunNumber := POHist_RunNumber + 1;
			'
			'    FOR POHist_j := 0 TO 6 DO
			'
			'        POHist_RunStartTime[POHist_j] :=
			'            POHist_NowLocal[POHist_j];
			'
			'    END_FOR;
			'
			'
			'    FOR POHist_i := 0 TO 11 DO
			'
			'        (* ----- Absolute current maximum ----- *)
			'        POHist_RunMaxCurrent_A[POHist_i] := 0.0;
			'        POHist_RunMaxCurrentDwell_ms[POHist_i] := 0;
			'        POHist_LineSpeedAtMaxCurrent[POHist_i] := 0.0;
			'
			'        POHist_CurrentPeakBandActive[POHist_i] := 0;
			'        POHist_CurrentPeakBandStart_us[POHist_i] := POHist_Now_us;
			'
			'
			'        (* ----- >1.8 A event data ----- *)
			'        POHist_OCActive[POHist_i] := 0;
			'        POHist_OCStart_us[POHist_i] := POHist_Now_us;
			'        POHist_OCCurrentDuration_ms[POHist_i] := 0;
			'        POHist_OCEventPeak_A[POHist_i] := 0.0;
			'
			'        POHist_OCRunCount[POHist_i] := 0;
			'        POHist_OCRunLongest_ms[POHist_i] := 0;
			'        POHist_OCRunPeak_A[POHist_i] := 0.0;
			'
			'
			'        (* Clear the current-maximum timestamp for this new run. *)
			'        FOR POHist_j := 0 TO 6 DO
			'
			'            POHist_RunMaxCurrentTime[POHist_i,POHist_j] := 0;
			'
			'        END_FOR;
			'
			'    END_FOR;
			'
			'END_IF;
			'
			'
			'(* ========================================================================= *)
			'(* 5. ACTIVE RUN MONITORING                                                  *)
			'(* ========================================================================= *)
			'
			'IF POHist_LineRunning THEN
			'
			'    FOR POHist_i := 0 TO 11 DO
			'
			'
			'        (* ----------------------------------------------------------------- *)
			'        (* 5A. STORE THE HIGHEST CURRENT SEEN DURING THIS RUN                *)
			'        (* ----------------------------------------------------------------- *)
			'
			'        IF POHist_LiveCurrent_A[POHist_i] >
			'           POHist_RunMaxCurrent_A[POHist_i] THEN
			'
			'            POHist_RunMaxCurrent_A[POHist_i] :=
			'                POHist_LiveCurrent_A[POHist_i];
			'
			'            POHist_LineSpeedAtMaxCurrent[POHist_i] :=
			'                TPTO02_f_LineSpd_me;
			'
			'            (* Timestamp of newest absolute current maximum. *)
			'            FOR POHist_j := 0 TO 6 DO
			'
			'                POHist_RunMaxCurrentTime[POHist_i,POHist_j] :=
			'                    POHist_NowLocal[POHist_j];
			'
			'            END_FOR;
			'
			'
			'            (* A new maximum establishes a new "near max" reference. *)
			'            POHist_CurrentPeakBandActive[POHist_i] := 1;
			'            POHist_CurrentPeakBandStart_us[POHist_i] :=
			'                POHist_Now_us;
			'
			'            POHist_RunMaxCurrentDwell_ms[POHist_i] := 0;
			'
			'        END_IF;
			'
			'
			'        (* ----------------------------------------------------------------- *)
			'        (* 5B. TIME SPENT NEAR THE CURRENT MAXIMUM                           *)
			'        (*                                                                     *)
			'        (* Default band = 0.05 A.                                             *)
			'        (* Example: final maximum = 1.94 A                                    *)
			'        (* Time-at-max band = current >= 1.89 A                               *)
			'        (* ----------------------------------------------------------------- *)
			'
			'        IF POHist_LiveCurrent_A[POHist_i] >=
			'           (POHist_RunMaxCurrent_A[POHist_i] -
			'            POHist_CurrentPeakBand_A) THEN
			'
			'            IF NOT POHist_CurrentPeakBandActive[POHist_i] THEN
			'
			'                POHist_CurrentPeakBandActive[POHist_i] := 1;
			'
			'                POHist_CurrentPeakBandStart_us[POHist_i] :=
			'                    POHist_Now_us;
			'
			'            END_IF;
			'
			'
			'            POHist_TempElapsed_us[POHist_i] :=
			'                POHist_Now_us -
			'                POHist_CurrentPeakBandStart_us[POHist_i];
			'
			'            POHist_TempElapsed_ms[POHist_i] :=
			'                POHist_TempElapsed_us[POHist_i] / 1000;
			'
			'
			'            IF POHist_TempElapsed_ms[POHist_i] >
			'               POHist_RunMaxCurrentDwell_ms[POHist_i] THEN
			'
			'                POHist_RunMaxCurrentDwell_ms[POHist_i] :=
			'                    POHist_TempElapsed_ms[POHist_i];
			'
			'            END_IF;
			'
			'        ELSE
			'
			'            POHist_CurrentPeakBandActive[POHist_i] := 0;
			'
			'        END_IF;
			'
			'
			'        (* ----------------------------------------------------------------- *)
			'        (* 5C. RECORD EVERY EXCURSION ABOVE 1.8 A                            *)
			'        (*                                                                   *)
			'        (* ----------------------------------------------------------------- *)
			'
			'        IF POHist_LiveCurrent_A[POHist_i] >
			'           POHist_OverCurrentThreshold_A THEN
			'
			'
			'            (* Start of a new >1.8 A excursion. *)
			'            IF NOT POHist_OCActive[POHist_i] THEN
			'
			'                POHist_OCActive[POHist_i] := 1;
			'
			'                POHist_OCStart_us[POHist_i] :=
			'                    POHist_Now_us;
			'
			'                POHist_OCCurrentDuration_ms[POHist_i] := 0;
			'
			'                POHist_OCEventPeak_A[POHist_i] :=
			'                    POHist_LiveCurrent_A[POHist_i];
			'
			'            END_IF;
			'
			'
			'            (* Highest current during this individual event. *)
			'            IF POHist_LiveCurrent_A[POHist_i] >
			'               POHist_OCEventPeak_A[POHist_i] THEN
			'
			'                POHist_OCEventPeak_A[POHist_i] :=
			'                    POHist_LiveCurrent_A[POHist_i];
			'
			'            END_IF;
			'
			'
			'            (* Highest current seen during ANY >1.8 A event this run. *)
			'            IF POHist_LiveCurrent_A[POHist_i] >
			'               POHist_OCRunPeak_A[POHist_i] THEN
			'
			'                POHist_OCRunPeak_A[POHist_i] :=
			'                    POHist_LiveCurrent_A[POHist_i];
			'
			'            END_IF;
			'
			'
			'            (* Live duration of the current event. *)
			'            POHist_TempElapsed_us[POHist_i] :=
			'                POHist_Now_us -
			'                POHist_OCStart_us[POHist_i];
			'
			'            POHist_OCCurrentDuration_ms[POHist_i] :=
			'                POHist_TempElapsed_us[POHist_i] / 1000;
			'
			'
			'        ELSE
			'
			'
			'            (* Falling below 1.8 A closes the event. *)
			'            IF POHist_OCActive[POHist_i] THEN
			'
			'                POHist_OCActive[POHist_i] := 0;
			'
			'                POHist_OCRunCount[POHist_i] :=
			'                    POHist_OCRunCount[POHist_i] + 1;
			'
			'
			'                IF POHist_OCCurrentDuration_ms[POHist_i] >
			'                   POHist_OCRunLongest_ms[POHist_i] THEN
			'
			'                    POHist_OCRunLongest_ms[POHist_i] :=
			'                        POHist_OCCurrentDuration_ms[POHist_i];
			'
			'                END_IF;
			'
			'
			'                POHist_OCCurrentDuration_ms[POHist_i] := 0;
			'
			'            END_IF;
			'
			'        END_IF;
			'
			'    END_FOR;
			'
			'END_IF;
			'
			'
			'(* ========================================================================= *)
			'(* 6. RUN STOP - SAVE A PERMANENT COPY AS "LAST RUN"                         *)
			'(* ========================================================================= *)
			'
			'IF POHist_RunStopPulse THEN
			'
			'
			'    FOR POHist_j := 0 TO 6 DO
			'
			'        POHist_LastRunEndTime[POHist_j] :=
			'            POHist_NowLocal[POHist_j];
			'
			'        POHist_LastRunStartTime[POHist_j] :=
			'            POHist_RunStartTime[POHist_j];
			'
			'    END_FOR;
			'
			'
			'    POHist_LastRunNumber :=
			'        POHist_RunNumber;
			'
			'
			'    FOR POHist_i := 0 TO 11 DO
			'
			'
			'        (* If line speed fell to zero while an OC event was still active,
			'           close that event using the run-stop time. *)
			'        IF POHist_OCActive[POHist_i] THEN
			'
			'            POHist_TempElapsed_us[POHist_i] :=
			'                POHist_Now_us -
			'                POHist_OCStart_us[POHist_i];
			'
			'            POHist_OCCurrentDuration_ms[POHist_i] :=
			'                POHist_TempElapsed_us[POHist_i] / 1000;
			'
			'
			'            POHist_OCActive[POHist_i] := 0;
			'
			'            POHist_OCRunCount[POHist_i] :=
			'                POHist_OCRunCount[POHist_i] + 1;
			'
			'
			'            IF POHist_OCCurrentDuration_ms[POHist_i] >
			'               POHist_OCRunLongest_ms[POHist_i] THEN
			'
			'                POHist_OCRunLongest_ms[POHist_i] :=
			'                    POHist_OCCurrentDuration_ms[POHist_i];
			'
			'            END_IF;
			'
			'
			'            POHist_OCCurrentDuration_ms[POHist_i] := 0;
			'
			'        END_IF;
			'
			'
			'        (* ----- Save completed-run current summary ----- *)
			'
			'        POHist_LastRunMaxCurrent_A[POHist_i] :=
			'            POHist_RunMaxCurrent_A[POHist_i];
			'
			'        POHist_LastRunMaxCurrentDwell_ms[POHist_i] :=
			'            POHist_RunMaxCurrentDwell_ms[POHist_i];
			'
			'        POHist_LastRunLineSpdAtMaxCurrent[POHist_i] :=
			'            POHist_LineSpeedAtMaxCurrent[POHist_i];
			'
			'
			'        (* ----- Save completed-run overcurrent summary ----- *)
			'
			'        POHist_LastRunOCCount[POHist_i] :=
			'            POHist_OCRunCount[POHist_i];
			'
			'        POHist_LastRunOCLongest_ms[POHist_i] :=
			'            POHist_OCRunLongest_ms[POHist_i];
			'
			'        POHist_LastRunOCPeak_A[POHist_i] :=
			'            POHist_OCRunPeak_A[POHist_i];
			'
			'
			'        (* ----- Save current-maximum timestamp ----- *)
			'
			'        FOR POHist_j := 0 TO 6 DO
			'
			'            POHist_LastRunMaxCurrentTime[POHist_i,POHist_j] :=
			'                POHist_RunMaxCurrentTime[POHist_i,POHist_j];
			'
			'        END_FOR;
			'
			'    END_FOR;
			'
			'END_IF;
			'
			'
			'(* ========================================================================= *)
			'(* 7. MAP ARRAY RESULTS TO YOUR EXISTING MAX-CURRENT TAGS                    *)
			'(* ========================================================================= *)
			'
			'PO1_MaxCurrent  := POHist_RunMaxCurrent_A[0];
			'PO2_MaxCurrent  := POHist_RunMaxCurrent_A[1];
			'PO3_MaxCurrent  := POHist_RunMaxCurrent_A[2];
			'PO4_MaxCurrent  := POHist_RunMaxCurrent_A[3];
			'PO5_MaxCurrent  := POHist_RunMaxCurrent_A[4];
			'PO6_MaxCurrent  := POHist_RunMaxCurrent_A[5];
			'PO7_MaxCurrent  := POHist_RunMaxCurrent_A[6];
			'PO8_MaxCurrent  := POHist_RunMaxCurrent_A[7];
			'PO9_MaxCurrent  := POHist_RunMaxCurrent_A[8];
			'PO10_MaxCurrent := POHist_RunMaxCurrent_A[9];
			'PO11_MaxCurrent := POHist_RunMaxCurrent_A[10];
			'PO12_MaxCurrent := POHist_RunMaxCurrent_A[11];
			'
			'
			'// =========================================================================
			'// 8A. POWERFLEX 525 d369 MOTOR OL LEVEL MAPPING 
			'// =========================================================================
			'
			'POHist_LiveMotorOL_Pct[0] :=
			'    M31INV11:I.MotorOLLevel * 0.1;
			'
			'POHist_LiveMotorOL_Pct[1] :=
			'    M31INV12:I.MotorOLLevel * 0.1;
			'
			'POHist_LiveMotorOL_Pct[2] :=
			'    M31INV13:I.MotorOLLevel * 0.1;
			'
			'POHist_LiveMotorOL_Pct[3] :=
			'    M31INV14:I.MotorOLLevel * 0.1;
			'
			'POHist_LiveMotorOL_Pct[4] :=
			'    M31INV15:I.MotorOLLevel * 0.1;
			'
			'POHist_LiveMotorOL_Pct[5] :=
			'    M31INV16:I.MotorOLLevel * 0.1;
			'
			'POHist_LiveMotorOL_Pct[6] :=
			'    M32INV11:I.MotorOLLevel * 0.1;
			'
			'POHist_LiveMotorOL_Pct[7] :=
			'    M32INV12:I.MotorOLLevel * 0.1;
			'
			'POHist_LiveMotorOL_Pct[8] :=
			'    M32INV13:I.MotorOLLevel * 0.1;
			'
			'POHist_LiveMotorOL_Pct[9] :=
			'    M32INV14:I.MotorOLLevel * 0.1;
			'
			'POHist_LiveMotorOL_Pct[10] :=
			'    M32INV15:I.MotorOLLevel * 0.1;
			'
			'POHist_LiveMotorOL_Pct[11] :=
			'    M32INV16:I.MotorOLLevel * 0.1;
			'
			'
			'// =========================================================================
			'// 8B. RESET MOTOR OL HISTORY AT THE START OF A NEW RUN 
			'// =========================================================================
			'
			'IF POHist_RunStartPulse THEN
			'
			'    FOR POHist_i := 0 TO 11 DO
			'
			'        POHist_RunMaxMotorOL_Pct[POHist_i] := 0.0;
			'
			'        POHist_RunMaxMotorOLDwell_ms[POHist_i] := 0;
			'
			'        POHist_CurrentAtMaxMotorOL_A[POHist_i] := 0.0;
			'
			'        POHist_LineSpeedAtMaxMotorOL[POHist_i] := 0.0;
			'
			'        POHist_OLAtMaxCurrent_Pct[POHist_i] := 0.0;
			'
			'        POHist_OLPeakBandActive[POHist_i] := 0;
			'
			'        POHist_OLPeakBandStart_us[POHist_i] :=
			'            POHist_Now_us;
			'
			'        // Used so Section 8 can tell when Section 5
			'        // has detected a new absolute current maximum.
			'        POHist_OLCurrentMaxSeen_A[POHist_i] := 0.0;
			'
			'
			'        FOR POHist_j := 0 TO 6 DO
			'
			'            POHist_RunMaxMotorOLTime[POHist_i,POHist_j] := 0;
			'
			'        END_FOR;
			'
			'    END_FOR;
			'
			'END_IF;
			'
			'
			'// =========================================================================
			'// 8C. ACTIVE MOTOR OL MONITORING
			'// =========================================================================
			'
			'IF POHist_LineRunning THEN
			'
			'    FOR POHist_i := 0 TO 11 DO
			'
			'
			'        // -----------------------------------------------------------------
			'        // STORE d369 AT THE MOMENT A NEW CURRENT MAXIMUM IS DETECTED
			'        // -----------------------------------------------------------------
			'        //
			'        // Section 5 runs before this section.
			'        // Therefore, if RunMaxCurrent has increased since the last scan,
			'        // the current scan established a new current maximum.
			'        //
			'
			'        IF POHist_RunMaxCurrent_A[POHist_i] >
			'           POHist_OLCurrentMaxSeen_A[POHist_i] THEN
			'
			'            POHist_OLAtMaxCurrent_Pct[POHist_i] :=
			'                POHist_LiveMotorOL_Pct[POHist_i];
			'
			'            POHist_OLCurrentMaxSeen_A[POHist_i] :=
			'                POHist_RunMaxCurrent_A[POHist_i];
			'
			'        END_IF;
			'
			'
			'        // -----------------------------------------------------------------
			'        // FIND MAXIMUM d369 MOTOR OL LEVEL DURING THIS RUN
			'        // -----------------------------------------------------------------
			'
			'        IF POHist_LiveMotorOL_Pct[POHist_i] >
			'           POHist_RunMaxMotorOL_Pct[POHist_i] THEN
			'
			'            POHist_RunMaxMotorOL_Pct[POHist_i] :=
			'                POHist_LiveMotorOL_Pct[POHist_i];
			'
			'
			'            // Store motor current when maximum OL occurred.
			'
			'            POHist_CurrentAtMaxMotorOL_A[POHist_i] :=
			'                POHist_LiveCurrent_A[POHist_i];
			'
			'
			'            // Store line speed when maximum OL occurred.
			'
			'            POHist_LineSpeedAtMaxMotorOL[POHist_i] :=
			'                TPTO02_f_LineSpd_me;
			'
			'
			'            // Store date/time when maximum OL occurred.
			'
			'            FOR POHist_j := 0 TO 6 DO
			'
			'                POHist_RunMaxMotorOLTime[POHist_i,POHist_j] :=
			'                    POHist_NowLocal[POHist_j];
			'
			'            END_FOR;
			'
			'
			'            // Start measuring dwell around this new maximum.
			'
			'            POHist_OLPeakBandActive[POHist_i] := 1;
			'
			'            POHist_OLPeakBandStart_us[POHist_i] :=
			'                POHist_Now_us;
			'
			'            POHist_RunMaxMotorOLDwell_ms[POHist_i] := 0;
			'
			'        END_IF;
			'
			'
			'        // -----------------------------------------------------------------
			'        // TIME SPENT NEAR THE MAXIMUM MOTOR OL LEVEL
			'        // -----------------------------------------------------------------
			'        //
			'        // Example:
			'        //
			'        // Maximum Motor OL = 87.6 %
			'        // OL peak band      = 0.5 %
			'        //
			'        // Time-at-max is measured while d369 >= 87.1 %
			'        //
			'
			'        IF POHist_LiveMotorOL_Pct[POHist_i] >=
			'           (POHist_RunMaxMotorOL_Pct[POHist_i] -
			'            POHist_OLPeakBand_Pct) THEN
			'
			'
			'            IF POHist_OLPeakBandActive[POHist_i] = 0 THEN
			'
			'                POHist_OLPeakBandActive[POHist_i] := 1;
			'
			'                POHist_OLPeakBandStart_us[POHist_i] :=
			'                    POHist_Now_us;
			'
			'            END_IF;
			'
			'
			'            POHist_TempElapsed_us[POHist_i] :=
			'                POHist_Now_us -
			'                POHist_OLPeakBandStart_us[POHist_i];
			'
			'
			'            POHist_TempElapsed_ms[POHist_i] :=
			'                POHist_TempElapsed_us[POHist_i] / 1000;
			'
			'
			'            IF POHist_TempElapsed_ms[POHist_i] >
			'               POHist_RunMaxMotorOLDwell_ms[POHist_i] THEN
			'
			'                POHist_RunMaxMotorOLDwell_ms[POHist_i] :=
			'                    POHist_TempElapsed_ms[POHist_i];
			'
			'            END_IF;
			'
			'
			'        ELSE
			'
			'            POHist_OLPeakBandActive[POHist_i] := 0;
			'
			'        END_IF;
			'
			'
			'    END_FOR;
			'
			'END_IF;
			'
			'
			'
			'(* ========================================================================= *)
			'(* 9. SAVE LINE STATE FOR NEXT SCAN                                          *)
			'(* ========================================================================= *)
			'
			'POHist_LineRunning_Last :=
			'    POHist_LineRunning;
			'
			'(* ========================================================================= *)
			'(* 10. HISTORIAN VIEW                                                        *)
			'(* ========================================================================= *)
			'	
			'	
			'	
			'//For ease of viewing, should allow for dropdowns to view all simultaniously
			'	
			'IF POHist_LineRunning then
			'	FOR POHist_i := 0 to 11 DO 
			'		POView_MaxCurrent_A[POHist_i] := 
			'			POHist_RunMaxCurrent_A[POHist_i];
			'		POView_TimeAtMax_s[POHist_i] := 
			'			POHist_RunMaxCurrentDwell_ms[POHist_i] / 1000.0;
			'		POView_OCCount[POHist_i] := 
			'			POHist_OCRunCount[POHist_i];
			'		POView_LongestOC_s[POHist_i] := 
			'			POHist_OCRunLongest_ms[POHist_i] / 1000.0;
			'		POView_OCPeak_A[POHist_i] := 
			'			POHist_OCRunPeak_A[POHist_i];
			'		POView_LineSpeedAtMax[POHist_i] := 
			'			POHist_LineSpeedAtMaxCurrent[POHist_i];
			'	END_FOR;
			'Else
			'	FOR POHist_i := 0 to 11 DO 
			'		POView_MaxCurrent_A[POHist_i] := 
			'			POHist_LastRunMaxCurrent_A[POHist_i];
			'		POView_TimeAtMax_s[POHist_i] := 
			'			POHist_LastRunMaxCurrentDwell_ms[POHist_i] / 1000.0;
			'		POView_OCCount[POHist_i] := 
			'			POHist_LastRunOCCount[POHist_i];
			'		POView_LongestOC_s[POHist_i] := 
			'			POHist_LastRunOCLongest_ms[POHist_i] / 1000.0;
			'		POView_OCPeak_A[POHist_i] := 
			'			POHist_LastRunOCPeak_A[POHist_i];
			'		POView_LineSpeedAtMax[POHist_i] := 
			'			POHist_LastRunLineSpdAtMaxCurrent[POHist_i];
			'	End_For;
			'END_IF;
			'
			'POHist_i :=0;
			'POHist_j :=0;
		END_ST_ROUTINE

