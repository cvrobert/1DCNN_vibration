				N: [[XIC(b_SpmeOneOnPls[0]) ,XIC(b_SpmeOneOnPls[1]) ,XIC(b_SpmeOneOnPls[2]) ] XIC(tmr_OP_On.DN) ,XIC(b_Alarm_Hold) XIO(GCMND_b_BzStp) ]XIO(tmrAlarmHoldOf.DN)[OTE(b_Alarm_Hold) ,TON(tmrAlarmHoldOf,?,?) ];
				N: [XIC(b_SpmeOneOnPls[3]) XIC(tmr_OP_On.DN) ,XIC(b_Full_Winding_Hold) XIO(GCMND_b_BzStp) ]XIO(tmr_LengthInfoAutoOf.DN)XIO(b_Alarm_Hold)[OTE(b_Full_Winding_Hold) ,TON(tmr_LengthInfoAutoOf,?,?) ];
				RC: "21 DEC 2020     Shoe      Rungs 2 thru 4     add tags and logic to allow Buzzer Stop PB to silence Buzzer for PO Cover Doors OPEN Alarm __ original could only Silence PO Cover Doors Open Buzzer by turning Preparation OFF$N"
				    "$N"
				    "";
				N: [XIC(G_b_Alm3IL[110]) ,XIC(G_b_Alm3IL[114]) ]XIO(G_b_Alm4Ope_IL[3])XIO(G_b_Alm1IL[15])XIO(GSTT_b_LineState[80])OTE(b_PO_CvrOpen_ALM);
				N: [XIC(b_PO_CvrOpen_ALM) XIO(b_PO_CvrOpen_ACK) ,XIC(z_TEST_BIT_3) ]OTE(M21ETH:2:O.Pt03.Data);
				N: [XIC(GCMND_b_BzStp) ,XIC(b_PO_CvrOpen_ACK) ]XIC(b_PO_CvrOpen_ALM)OTE(b_PO_CvrOpen_ACK);
				N: [XIC(b_Full_Winding_Hold) ,XIC(z_TEST_BIT_2) ]OTE(M21ETH:2:O.Pt04.Data);
				N: [XIC(G_b_StrtBell_On) ,XIC(z_TEST_BIT_0) ]OTE(M21ETH:2:O.Pt05.Data);
				N: [XIC(b_Alarm_Hold) ,XIC(z_TEST_BIT_1) ]OTE(M21ETH:2:O.Pt06.Data);
		END_ROUTINE

