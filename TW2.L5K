		ROUTINE R02_Prepare 
				N: XIC(G_b_OP)TON(tmr_OP_On,?,?);
				N: XIC(G_b_LineRunJogZero)[TON(tmr_LineRun2s,?,?) ,TON(tmr_LineRun10s,?,?) ];
				N: MOV(95,f_DncrHiFatal)MOV(-95,f_DncrLoFatal);
				N: MOV(60,f_DncrHiWarn)MOV(-60,f_DncrLoWarn);
				N: SUB(TPFRM03_f_TU_Lngth_ns,TPTO02_f_TU_Lngth_me,f_TUP_Remain_Length);
				N: NEG(TPFRM04_f_SV_MtrTrqHiErr,f_Servo_Alarm_Neg);
				N: NEG(TPFRM04_f_SV_MtrTrqHiAlm,f_Servo_Waring_Neg);
				N: [GEQ(TPTO02_MTR_FRYR.f_Trq_me,TPFRM04_f_SV_MtrTrqHiErr) ,LEQ(TPTO02_MTR_FRYR.f_Trq_me,f_Servo_Alarm_Neg) ]TON(tmr_Trq_Fatal[0],?,?);
				N: [GEQ(TPTO02_MTR_FRYR.f_Trq_me,TPFRM04_f_SV_MtrTrqHiAlm) ,LEQ(TPTO02_MTR_FRYR.f_Trq_me,f_Servo_Waring_Neg) ]TON(tmr_Trq_Warn[0],?,?);
				N: [GEQ(TPTO02_MTR_TU.f_Trq_me,TPFRM04_f_SV_MtrTrqHiErr) ,LEQ(TPTO02_MTR_TU.f_Trq_me,f_Servo_Alarm_Neg) ]TON(tmr_Trq_Fatal[1],?,?);
				N: [GEQ(TPTO02_MTR_TU.f_Trq_me,TPFRM04_f_SV_MtrTrqHiAlm) ,LEQ(TPTO02_MTR_TU.f_Trq_me,f_Servo_Waring_Neg) ]TON(tmr_Trq_Warn[1],?,?);
				N: [GEQ(TPTO02_MTR_TRV.f_Trq_me,TPFRM04_f_SV_MtrTrqHiErr) ,LEQ(TPTO02_MTR_TRV.f_Trq_me,f_Servo_Alarm_Neg) ]TON(tmr_Trq_Fatal[2],?,?);
				N: [GEQ(TPTO02_MTR_TRV.f_Trq_me,TPFRM04_f_SV_MtrTrqHiAlm) ,LEQ(TPTO02_MTR_TRV.f_Trq_me,f_Servo_Waring_Neg) ]TON(tmr_Trq_Warn[2],?,?);
				N: [GEQ(TPTO02_MTR_CAP.f_Trq_me,TPFRM04_f_SV_MtrTrqHiErr) ,LEQ(TPTO02_MTR_CAP.f_Trq_me,f_Servo_Alarm_Neg) ]TON(tmr_Trq_Fatal[3],?,?);
