				N: GEQ(TPTO02_MTR_PO[8].f_Ampere,GLIB_f_POINV_TrqHiErr)TON(tmr_PO_Trq_Fatal[8],?,?);
				N: GEQ(TPTO02_MTR_PO[8].f_Ampere,GLIB_f_POINV_TrqHiAlm)TON(tmr_PO_Trq_Warn[8],?,?);
				RC: "////////////////////////////////////////////////////////////////// Pay Off No10 Alarm Prepare /////////////////////////////////////////////////////";
				N: GRT(TPTO02_f_DncrPstn_PO_me[9],f_DncrHiFatal)OTE(b_PO_DncrHiFatal[9]);
				N: LES(TPTO02_f_DncrPstn_PO_me[9],f_DncrLoFatal)OTE(b_PO_DncrLoFatal[9]);
				N: GRT(TPTO02_f_DncrPstn_PO_me[9],f_DncrHiWarn)OTE(b_PO_DncrHiWarn[9]);
				N: LES(TPTO02_f_DncrPstn_PO_me[9],f_DncrLoWarn)OTE(b_PO_DncrLoWarn[9]);
				N: GEQ(TPTO02_MTR_PO[9].f_Ampere,GLIB_f_POINV_TrqHiErr)TON(tmr_PO_Trq_Fatal[9],?,?);
				N: GEQ(TPTO02_MTR_PO[9].f_Ampere,GLIB_f_POINV_TrqHiAlm)TON(tmr_PO_Trq_Warn[9],?,?);
				RC: "////////////////////////////////////////////////////////////////// Pay Off No11 Alarm Prepare /////////////////////////////////////////////////////";
				N: GRT(TPTO02_f_DncrPstn_PO_me[10],f_DncrHiFatal)OTE(b_PO_DncrHiFatal[10]);
				N: LES(TPTO02_f_DncrPstn_PO_me[10],f_DncrLoFatal)OTE(b_PO_DncrLoFatal[10]);
				N: GRT(TPTO02_f_DncrPstn_PO_me[10],f_DncrHiWarn)OTE(b_PO_DncrHiWarn[10]);
				N: LES(TPTO02_f_DncrPstn_PO_me[10],f_DncrLoWarn)OTE(b_PO_DncrLoWarn[10]);
				N: GEQ(TPTO02_MTR_PO[10].f_Ampere,GLIB_f_POINV_TrqHiErr)TON(tmr_PO_Trq_Fatal[10],?,?);
				N: GEQ(TPTO02_MTR_PO[10].f_Ampere,GLIB_f_POINV_TrqHiAlm)TON(tmr_PO_Trq_Warn[10],?,?);
				RC: "////////////////////////////////////////////////////////////////// Pay Off No12 Alarm Prepare /////////////////////////////////////////////////////";
				N: GRT(TPTO02_f_DncrPstn_PO_me[11],f_DncrHiFatal)OTE(b_PO_DncrHiFatal[11]);
				N: LES(TPTO02_f_DncrPstn_PO_me[11],f_DncrLoFatal)OTE(b_PO_DncrLoFatal[11]);
				N: GRT(TPTO02_f_DncrPstn_PO_me[11],f_DncrHiWarn)OTE(b_PO_DncrHiWarn[11]);
				N: LES(TPTO02_f_DncrPstn_PO_me[11],f_DncrLoWarn)OTE(b_PO_DncrLoWarn[11]);
				N: GEQ(TPTO02_MTR_PO[11].f_Ampere,GLIB_f_POINV_TrqHiErr)TON(tmr_PO_Trq_Fatal[11],?,?);
				N: GEQ(TPTO02_MTR_PO[11].f_Ampere,GLIB_f_POINV_TrqHiAlm)TON(tmr_PO_Trq_Warn[11],?,?);
				RC: "//////////////////////////////////////////////////////////////////////////////////////////////   ///////////////////////////////////////////////////////////////////////////////////";
				N: XIC(tmr_LineRun10s.DN)XIC(GPO_b_RUN_Mb[0])XIC(M31_1ETH:4:O.Pt04.Data)[XIC(M31_1ETH:1:I.Pt14.Data) TON(tmr_SR_Warn[0],?,?) ,XIO(M31_1ETH:1:I.Pt15.Data) TON(tmr_SR_Fatal[0],?,?) ];
				N: XIC(tmr_LineRun10s.DN)XIC(GPO_b_RUN_Mb[1])XIC(M31_1ETH:4:O.Pt05.Data)[XIC(M31_1ETH:2:I.Pt00.Data) TON(tmr_SR_Warn[1],?,?) ,XIO(M31_1ETH:2:I.Pt01.Data) TON(tmr_SR_Fatal[1],?,?) ];
				N: XIC(tmr_LineRun10s.DN)XIC(GPO_b_RUN_Mb[2])XIC(M31_1ETH:4:O.Pt06.Data)[XIC(M31_1ETH:2:I.Pt02.Data) TON(tmr_SR_Warn[2],?,?) ,XIO(M31_1ETH:2:I.Pt03.Data) TON(tmr_SR_Fatal[2],?,?) ];
				N: XIC(tmr_LineRun10s.DN)XIC(GPO_b_RUN_Mb[3])XIC(M31_1ETH:4:O.Pt07.Data)[XIC(M31_1ETH:2:I.Pt04.Data) TON(tmr_SR_Warn[3],?,?) ,XIO(M31_1ETH:2:I.Pt05.Data) TON(tmr_SR_Fatal[3],?,?) ];
				N: XIC(tmr_LineRun10s.DN)XIC(GPO_b_RUN_Mb[4])XIC(M31_1ETH:4:O.Pt08.Data)[XIC(M31_1ETH:2:I.Pt06.Data) TON(tmr_SR_Warn[4],?,?) ,XIO(M31_1ETH:2:I.Pt07.Data) TON(tmr_SR_Fatal[4],?,?) ];
				N: XIC(tmr_LineRun10s.DN)XIC(GPO_b_RUN_Mb[5])XIC(M31_1ETH:4:O.Pt09.Data)[XIC(M31_1ETH:2:I.Pt08.Data) TON(tmr_SR_Warn[5],?,?) ,XIO(M31_1ETH:2:I.Pt09.Data) TON(tmr_SR_Fatal[5],?,?) ];
				N: XIC(tmr_LineRun10s.DN)XIC(GPO_b_RUN_Mb[6])XIC(M32_1ETH:4:O.Pt04.Data)[XIC(M32_1ETH:1:I.Pt14.Data) TON(tmr_SR_Warn[6],?,?) ,XIO(M32_1ETH:1:I.Pt15.Data) TON(tmr_SR_Fatal[6],?,?) ];
				N: XIC(tmr_LineRun10s.DN)XIC(GPO_b_RUN_Mb[7])XIC(M32_1ETH:4:O.Pt05.Data)[XIC(M32_1ETH:2:I.Pt00.Data) TON(tmr_SR_Warn[7],?,?) ,XIO(M32_1ETH:2:I.Pt01.Data) TON(tmr_SR_Fatal[7],?,?) ];
				N: XIC(tmr_LineRun10s.DN)XIC(GPO_b_RUN_Mb[8])XIC(M32_1ETH:4:O.Pt06.Data)[XIC(M32_1ETH:2:I.Pt02.Data) TON(tmr_SR_Warn[8],?,?) ,XIO(M32_1ETH:2:I.Pt03.Data) TON(tmr_SR_Fatal[8],?,?) ];
				N: XIC(tmr_LineRun10s.DN)XIC(GPO_b_RUN_Mb[9])XIC(M32_1ETH:4:O.Pt07.Data)[XIC(M32_1ETH:2:I.Pt04.Data) TON(tmr_SR_Warn[9],?,?) ,XIO(M32_1ETH:2:I.Pt05.Data) TON(tmr_SR_Fatal[9],?,?) ];
				N: XIC(tmr_LineRun10s.DN)XIC(GPO_b_RUN_Mb[10])XIC(M32_1ETH:4:O.Pt08.Data)[XIC(M32_1ETH:2:I.Pt06.Data) TON(tmr_SR_Warn[10],?,?) ,XIO(M32_1ETH:2:I.Pt07.Data) TON(tmr_SR_Fatal[10],?,?) ];
				N: XIC(tmr_LineRun10s.DN)XIC(GPO_b_RUN_Mb[11])XIC(M32_1ETH:4:O.Pt09.Data)[XIC(M32_1ETH:2:I.Pt08.Data) TON(tmr_SR_Warn[11],?,?) ,XIO(M32_1ETH:2:I.Pt09.Data) TON(tmr_SR_Fatal[11],?,?) ];
				N: XIO(Local:3:O.Pt12.Data)XIO(Local:2:I.Pt01.Data)TON(tmr_TUP_Safety_Cover_Lock_Fault,?,?);
				N: XIC(Local:3:O.Pt03.Data)TON(tmr_TUP_SR_ON,?,?);
				N: XIO(M20ETH:3:O.Pt07.Data)XIO(M20ETH:1:I.Pt01.Data)TON(tmr_BND1_Cover_Rock,?,?);
				N: XIO(M20ETH:3:O.Pt08.Data)XIO(M20ETH:1:I.Pt04.Data)TON(tmr_BND2_Cover_Rock,?,?);
				N: [XIO(M31_2ETH:3:O.Pt02.Data) XIO(M31_2ETH:2:I.Pt03.Data) ,XIO(M31_2ETH:3:O.Pt03.Data) XIO(M31_2ETH:2:I.Pt05.Data) ]TON(tmr_PO_Safety_Coverlock_Error_31,?,?);
				N: [XIO(M32_2ETH:3:O.Pt02.Data) XIO(M32_2ETH:2:I.Pt03.Data) ,XIO(M32_2ETH:3:O.Pt03.Data) XIO(M32_2ETH:2:I.Pt05.Data) ]TON(tmr_PO_Safety_Coverlock_Error_32,?,?);
				N: XIC(M31_1ETH:4:O.Pt10.Data)TON(tmr_Concent_Static_Alarm,?,?);
		END_ROUTINE

		ROUTINE R03_MakeErrbits 
				RC: "////////////////////////////////////////////////////////////////////////////////////////////////////////////  System Alarm ///////////////////////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: [XIO(G_b_Always_On) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[0]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[0]) ,OTE(G_b_Alm1Bz[0]) ];
				N: [XIC(G_tmr_11ETH.DN) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[7]) XIO(GCMND_b_AlmRst) ]XIC(G_b_F10)[OTE(G_b_Alm1IL[7]) ,OTE(G_b_Alm1Bz[7]) ];
				N: [XIC(G_tmr_20ETH.DN) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[8]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[8]) ,OTE(G_b_Alm1Bz[8]) ];
				N: [XIC(G_tmr_21ETH.DN) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[9]) XIO(GCMND_b_AlmRst) ]XIC(G_b_F10)[OTE(G_b_Alm1IL[9]) ,OTE(G_b_Alm1Bz[9]) ];
				N: [XIC(G_tmr_31ETH.DN) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[10]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[10]) ,OTE(G_b_Alm1Bz[10]) ];
				N: [XIC(G_tmr_32ETH.DN) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[11]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[11]) ,OTE(G_b_Alm1Bz[11]) ];
				RC: "//////////////////////////////////////////////////////////////////////////////////////////////////////////// Emergency Stop , Preparation Alarm ///////////////////////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: [XIO(Local:1:I.Pt01.Data) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[14]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[14]) ,OTE(G_b_Alm1Bz[14]) ];
				N: [XIO(G_b_RPR) XIC(tmr_LineRun2s.DN) ,XIC(G_b_Alm1Bz[15]) XIO(GCMND_b_AlmRst) ]OTE(G_b_Alm1Bz[15]);
				N: [XIO(G_b_RPR) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1Bz[15]) ]OTE(G_b_Alm1IL[15]);
				RC: "//////////////////////////////////////////////////////////////////////////////////////////////////////////// Motors, Drivers Alarm ///////////////////////////////////////////////////////////////////////////////////////////////";
				N: [XIO(Local:1:I.Pt05.Data) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[17]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[17]) ,OTE(G_b_Alm1Bz[17]) ];
				N: [NEQ(SV1_Axis1_FRYR.AxisFault,0) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[19]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[19]) ,OTE(G_b_Alm1Bz[19]) ];
				N: [NEQ(SV1_Axis4_CAP.AxisFault,0) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[20]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[20]) ,OTE(G_b_Alm1Bz[20]) ];
				N: [NEQ(SV1_Axis2_TU.AxisFault,0) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[21]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[21]) ,OTE(G_b_Alm1Bz[21]) ];
				N: [NEQ(SV1_Axis3_TRV.AxisFault,0) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[22]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[22]) ,OTE(G_b_Alm1Bz[22]) ];
				RC: "//////////////////////////////////////////////////////////////////////////////////////////////////////////// Safety Doors Alarm ///////////////////////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: [XIO(Local:2:I.Pt00.Data) XIC(tmr_LineRun2s.DN) ,XIC(G_b_Alm1Bz[24]) XIO(GCMND_b_AlmRst) ]OTE(G_b_Alm1Bz[24]);
				N: [XIO(Local:2:I.Pt00.Data) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1Bz[24]) ]OTE(G_b_Alm1IL[24]);
				N: [XIC(tmr_TUP_Safety_Cover_Lock_Fault.DN) XIC(tmr_LineRun2s.DN) ,XIC(G_b_Alm1Bz[25]) XIO(GCMND_b_AlmRst) ]OTE(G_b_Alm1Bz[25]);
				N: [XIC(tmr_TUP_Safety_Cover_Lock_Fault.DN) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1Bz[25]) ]OTE(G_b_Alm1IL[25]);
				N: [XIO(Local:1:I.Pt04.Data) XIC(tmr_LineRun2s.DN) ,XIC(G_b_Alm1Bz[28]) XIO(GCMND_b_AlmRst) ]OTE(G_b_Alm1Bz[28]);
				N: [XIO(Local:1:I.Pt04.Data) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1Bz[28]) ]OTE(G_b_Alm1IL[28]);
				RC: "////////////////////////////////////////////////////////////////////////////////////////////////////////////   ///////////////////////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: [XIO(Local:2:I.Pt03.Data) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[31]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[31]) ,OTE(G_b_Alm1Bz[31]) ];
				N: [XIO(Local:2:I.Pt02.Data) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[32]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[32]) ,OTE(G_b_Alm1Bz[32]) ];
				N: XIO(GTRV_b_ST200_O_PstnCmp)XIC(tmr_OP_On.DN)OTE(G_b_Alm1IL[33]);
				N: EQU(GSTT_n_LineState,0)XIC(tmr_OP_On.DN)OTE(G_b_Alm1IL[34]);
				N: [LEQ(TPFRM_TU_BBN.f_DiaMin,250) XIC(Local:2:I.Pt08.Data) ,GRT(TPFRM_TU_BBN.f_DiaMin,250) XIC(Local:2:I.Pt14.Data) ]XIC(tmr_OP_On.DN)OTE(G_b_Alm1IL[40]);
				RC: "////////////////////////////////////////////////////////////////////////////////////////////////////////////  Servo Torque Alarm ///////////////////////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: [XIC(tmr_Trq_Warn[0].DN) XIC(tmr_LineRun2s.DN) ,XIC(G_b_Alm1IL[43]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[43]) ,OTE(G_b_Alm1Bz[43]) ];
				N: [XIC(tmr_Trq_Warn[3].DN) XIC(tmr_LineRun2s.DN) ,XIC(G_b_Alm1IL[44]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[44]) ,OTE(G_b_Alm1Bz[44]) ];
				N: [XIC(tmr_Trq_Warn[1].DN) XIC(tmr_LineRun2s.DN) ,XIC(G_b_Alm1IL[45]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[45]) ,OTE(G_b_Alm1Bz[45]) ];
				N: [XIC(tmr_Trq_Warn[2].DN) XIC(tmr_LineRun2s.DN) ,XIC(G_b_Alm1IL[46]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[46]) ,OTE(G_b_Alm1Bz[46]) ];
				RC: "//////////////////////////////////////////////////////////////////////////////////////////////////////////// T/U Dancer Alarm ///////////////////////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: [XIC(b_TU_DncrHiFatal) XIC(tmr_LineRun2s.DN) ,XIC(G_b_Alm1Bz[49]) XIO(GCMND_b_AlmRst) ]OTE(G_b_Alm1Bz[49]);
				N: [XIC(b_TU_DncrHiFatal) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1Bz[49]) ]OTE(G_b_Alm1IL[49]);
				N: [XIC(b_TU_DncrLoFatal) XIC(tmr_LineRun2s.DN) ,XIC(G_b_Alm1Bz[50]) XIO(GCMND_b_AlmRst) ]OTE(G_b_Alm1Bz[50]);
				N: [XIC(b_TU_DncrLoFatal) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1Bz[50]) ]OTE(G_b_Alm1IL[50]);
				N: [XIC(tmr_DNCR_Warn.DN) [XIC(b_TU_DncrHiWarn) ,XIC(b_TU_DncrLoWarn) ] ,XIC(G_b_Alm1IL[51]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[51]) ,OTE(G_b_Alm1Bz[51]) ];
				RC: "//////////////////////////////////////////////////////////////////////////////////////////////////////////// Servo Torque Alarm ///////////////////////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: [XIC(tmr_Trq_Fatal[0].DN) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[59]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[59]) ,OTE(G_b_Alm1Bz[59]) ];
				N: [XIC(tmr_Trq_Fatal[3].DN) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[60]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[60]) ,OTE(G_b_Alm1Bz[60]) ];
				N: [XIC(tmr_Trq_Fatal[1].DN) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[61]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[61]) ,OTE(G_b_Alm1Bz[61]) ];
				N: [XIC(tmr_Trq_Fatal[2].DN) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[62]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[62]) ,OTE(G_b_Alm1Bz[62]) ];
				RC: "//////////////////////////////////////////////////////////////////////////////////////////////////////////// Static Elminators Alarm ///////////////////////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "";
				N: [XIC(Local:2:I.Pt09.Data) XIC(TPFRM_RUNSET.b_Slct_StaticElmntr) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[65]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[65]) ,OTE(G_b_Alm1Bz[65]) ];
				N: [XIC(Local:2:I.Pt10.Data) XIC(TPFRM_RUNSET.b_Slct_StaticElmntr) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[66]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[66]) ,OTE(G_b_Alm1Bz[66]) ];
				N: [XIC(tmr_TUP_SR_ON.DN) XIO(Local:2:I.Pt11.Data) XIC(TPFRM_RUNSET.b_Slct_StaticElmntr) XIC(tmr_OP_On.DN) ,XIC(G_b_Alm1IL[67]) XIO(GCMND_b_AlmRst) ][OTE(G_b_Alm1IL[67]) ,OTE(G_b_Alm1Bz[67]) ];
				RC: "////////////////////////////////////////////////////////////////////////////////////////////////////////////  ///////////////////////////////////////////////////////////////////////////////////////////////$N"
