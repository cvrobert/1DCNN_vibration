		ST_ROUTINE R09_Recipi 
			'///////////////////////////////////////////////
			'// Name: TouchPanel_Recipi
			'////////////////////////////////////////////////
			'// ver 1.00
			'// Touch Panel Monitor Processing
			'// Auther Ryo Mikuni
			'// 2019.11.24
			'
			'
			'//Product File Name Save
			'
			' if ( G_b_LineRunJog ) then TPTO03_b_Rcp_IL := 1; //Rcp Insert I/L
			' else TPTO03_b_Rcp_IL := 0; end_if;
			' 
			' b_F13.InputBit := TPFRM_b_RcpCmnd[0] ;//Create Oneshot
			' OSRI (b_F13) ;
			' b_W1.InputBit := TPFRM_b_RcpCmnd[4] ;//Create Oneshot
			' OSRI (b_W1) ;
			' b_W2.InputBit := TPFRM_b_RcpCmnd[5] ;//Create Oneshot
			' OSRI (b_W2) ;
			'	 
			' if ( TPFRM_nn_RcpOpeCmmnt = 0 and b_W1.OutputBit ) then TPFRM_nn_RcpOpeCmmnt := 1; end_if;
			' if ( TPFRM_nn_RcpOpeCmmnt = 0 and b_W2.OutputBit ) then TPFRM_nn_RcpOpeCmmnt := 2; end_if;
			' if ( TPFRM_nn_RcpOpeCmmnt = 1 and b_F13.OutputBit ) then 
			'	 COP ( TPFRM_RUNRCP[TPFRM_n_RcpNmbrEdt -1], TPFRM_RUNSET,1); TPFRM_n_RcpNmbrRun := TPFRM_n_RcpNmbrEdt ; end_if;//Insert Recipi(RCP → SET)
			' if ( TPFRM_nn_RcpOpeCmmnt = 2 and b_F13.OutputBit ) then 
			'	 COP ( TPFRM_RUNSET,TPFRM_RUNRCP[TPFRM_n_RcpNmbrEdt -1],1); COP ( TPFRM_RUNSET,TPFRM_RUNRCPEDT,1); end_if; //Insert Recipi(SET → RCP,EDT)
			' if ( TPFRM_nn_RcpOpeCmmnt = 1 and b_F13.OutputBit ) then TPFRM_nn_RcpOpeCmmnt := 0; end_if;
			' if ( TPFRM_nn_RcpOpeCmmnt = 2 and b_F13.OutputBit ) then TPFRM_nn_RcpOpeCmmnt := 0; end_if; 
			' if ( TPFRM_nn_RcpOpeCmmnt > 0 and TPFRM_b_RcpCmnd[1] or G_b_LineJogStpHb ) then TPFRM_nn_RcpOpeCmmnt := 0; end_if;
			' if ( TPFRM_b_RcpCmnd[8] ) then COP ( TPFRM_RUNRCPEDT,TPFRM_RUNRCP[TPFRM_n_RcpNmbrEdt -1],1); end_if ;//Insert Recipi(EDT → RCP)//20200219 Oshida modified
			'//end_if ;//Insert Recipi(EDT → RCP)
			' 
			' //============================================================================================================================
			'//                                       RECIPE CHANGE MONITOR - AUTO TRAVERSE PITCH ONS
			'//============================================================================================================================
			' 
			'//Compare active product names to identified strings using FIND tool
			'if (TPFRM_n_RcpNmbrRun <> TPFRM_n_LastRcpNmbrRun) then
			'	FIND(TPFRM_RUNSET.s_PrdctName, TPFRM_s_Find_CH2, 1, TPFRM_n_Find_CH2);
			'	FIND(TPFRM_RUNSET.s_PrdctName, TPFRM_s_Find_D3, 1, TPFRM_n_Find_D3);
			'	FIND(TPFRM_RUNSET.s_PrdctName, TPFRM_s_Find_CK, 1, TPFRM_n_Find_CK);
			'	FIND(TPFRM_RUNSET.s_PrdctName, TPFRM_s_Find_PK, 1, TPFRM_n_Find_PK);
			'	
			'	
			'//Set Default traverse pitch if conditions above are met
			'if (TPFRM_n_Find_D3 > 0) then
			'	TPFRM_RUNSET.f_TRV_Pitch_ns := 30.0;
			'elsif (TPFRM_n_Find_CH2 > 0) then
			'	TPFRM_RUNSET.f_TRV_Pitch_ns := 8.0;
			'elsif (TPFRM_n_Find_CK > 0) then
			'	TPFRM_RUNSET.f_TRV_Pitch_ns := 8.0;
			'elsif (TPFRM_n_Find_PK > 0) then
			'	TPFRM_RUNSET.f_TRV_Pitch_ns := 6.0;
			'end_if;
			'
			'//Store the current recipe number into the last run for the next comparison that becomes necessary.
			'TPFRM_n_LastRcpNmbrRun := TPFRM_n_RcpNmbrRun;
			'
			'end_if;
			'
		END_ST_ROUTINE

		ST_ROUTINE R10_EvwentListView 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// Event List View //////////////////////////////////////////////////////////////////////
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// For Event List Screen
			'
			'// List Number Up Dowm
			'
			'b_EListUpPls := TPFRM06_b_ELIST_Up_PB and not( b_EListUpOld );
			'b_EListUpOld := TPFRM06_b_ELIST_Up_PB;
			'
			'if( b_EListUpPls ) then nn_L := nn_L + 1; end_if;
			'
			'b_EListDwnPls := TPFRM06_b_ELIST_Dwn_PB and not( b_ElistDwnOld );
			'b_ElistDwnOld := TPFRM06_b_ELIST_Dwn_PB;
			'
			'if( b_EListDwnPls ) then nn_L := nn_L - 1; end_if;
			'
			'if( 2 < nn_L ) then nn_L := 2; end_if;
			'if( nn_L < 0 ) then nn_L := 0; end_if;
			'
			'// Item Number Up Down
			'
			'b_E_P_UpPls := TPFRM06_b_P_Up_PB and not( b_E_P_UpOld );
			'b_E_P_UpOld := TPFRM06_b_P_Up_PB;
			'
			'if( b_E_P_UpPls ) then nn_P := nn_P + 10; end_If;
			'
			'b_E_P_DwnPls := TPFRM06_b_P_Dwn_PB and not( b_E_P_DwnOld );
			'b_E_P_DwnOld := TPFRM06_b_P_Dwn_PB;
			'
			'if( b_E_P_DwnPls ) then nn_P := nn_P - 10; end_if;
			'
			'if( 70 < nn_P) then nn_P := 70; end_if;
			'if( nn_P < 0 ) then nn_P := 0;  end_if;
			'
			'// Set List Value
			'
			'TPTO02_EventView.n_ListNumber := nn_L;
			'TPTO02_EventView.s_Id:= GEVENT_LIST[nn_L].s_Id;
			'
			'TPTO02_EventView.n_DateYear := GEVENT_LIST[nn_L].n_Date_Year;
			'TPTO02_EventView.n_DateMonth := GEVENT_LIST[nn_L].n_Date_Month;
			'TPTO02_EventView.n_DateDay := GEVENT_LIST[nn_L].n_Date_Day;
			'TPTO02_EventView.n_Datehour := GEVENT_LIST[nn_L].n_Date_hour;
			'TPTO02_EventView.n_DateMinute := GEVENT_LIST[nn_L].n_Date_Minute;
			'
			'TPTO02_EventView.n_Recorded := GEVENT_LIST[nn_L].n_Recorded;
			'TPTO02_EventView.n_Printed := GEVENT_LIST[nn_L].n_Printed;
			'
			'TPTO02_EventView.f_TotalLngth := GEVENT_LIST[nn_L].f_TotalLngth;
			'
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'// Fill Event Points List
			'
			'for nn_C := 0
			'	TO 29
			'	BY 1
			'	Do
			'
			'	TPTO02_EventView.n_P_Number[nn_C] := nn_P + nn_C;
			'	if( GEVENT_LIST[nn_L].n_Recorded <= ( nn_P + nn_C )) then
			'		TPTO02_EventView.s_P_Name[nn_C] := '';
			'		TPTO02_EventView.f_P_Length[nn_C] := 0;
			'		
			'	else
			'		TPTO02_EventView.s_P_Name[nn_C] := 
			'		                              GEVENT_LIST[nn_L].POINT[nn_P + nn_C].s_EvntName;
			'		TPTO02_EventView.f_P_Length[nn_C]:=
			'		                              GEVENT_LIST[nn_L].POINT[nn_P + nn_C].f_Length;
			'	end_if;
			'
			'end_for;
			'
		END_ST_ROUTINE

		ST_ROUTINE R14_Torque_Panel 
