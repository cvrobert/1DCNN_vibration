		ROUTINE MainRoutine 
				N: JSR(R00_Input,0);
				N: JSR(R02_EvListStatebit,0);
				N: JSR(R03_EvListStateTrns,0);
				N: JSR(R04_PrintCountState_bit,0);
				N: JSR(R05_PrintCountState_Trns,0);
				N: JSR(R07_ExchangeList,0);
				N: JSR(R08_EventRecord,0);
				N: JSR(R10_PrintData,0);
				N: JSR(R11_OutPut,0);
		END_ROUTINE

		ROUTINE R00_Input 
				N: XIO(G_b_OP_Dly)OTE(b_Triger_InitializeStt);
				N: [XIC(GSTT_b_LineState[40]) ,XIC(GSTT_b_LineState[45]) ,XIC(GSTT_b_LineState[65]) ,XIC(GSTT_b_LineState[70]) ,XIC(GSTT_b_LineState[90]) ,XIC(GSTT_b_LineState[95]) ]OTE(b_TrigerCollect);
				N: XIC(GSTT_b_LineState[5])OTE(b_Triger_Close);
				N: XIC(GSTT_b_LineState[31])OTE(b_Triger_OpenNew);
				N: XIC(GEVENT_b_EvPrntCmplt)OTE(b_PrintComp);
				N: COP(TPTO02_nn_DateTime[0],nn_DateTime[0],7)MOV(TPTO02_f_TU_Lngth_me,f_Length_me);
				N: COP(GLIB_EVENT_PAR_SETS1,event_ParSets,1)COP(TPFRM_RUNSET.s_PrdctName,s_PrdctName,1);
				N: XIC(G_b_Alm1IL[87])OTE(b_E_RQ[0]);
				N: XIC(G_b_Alm1IL[96])OTE(b_E_RQ[1]);
				N: XIC(G_b_Alm1IL[71])OTE(b_E_RQ[2]);
		END_ROUTINE

		ST_ROUTINE R02_EvListStatebit 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// EvListState bit  /////////////////////////////////////////////////////////////////////
			'/////////////////////////////////////////////////////////////////////////////////////////
			'
			'b_EventStt[0] :=  (nn_EventStt = 0  );
			'b_EventStt[12]:=  (nn_EventStt = 12 );
			'b_EventStt[20]:=  (nn_EventStt = 20 );
			'
			'b_EventStt[32]:=  (nn_EventStt = 32 );
			'b_EventStt[34]:=  (nn_EventStt = 34 );
			'
			'b_EventStt[40]:=  (nn_EventStt = 40 );
			'
			'
			'
		END_ST_ROUTINE

		ROUTINE R03_EvListStateTrns 
				N: [XIC(b_Triger_InitializeStt) ONS(b_PlsStrg[1]) ,XIC(b_Triger_Close) ONS(b_PlsStrg[2]) ]MOV(0,nn_EventStt);
				N: XIC(b_EventStt[0])XIC(b_Triger_Close)MOV(12,nn_EventStt);
				N: XIC(b_EventStt[12])MOV(20,nn_EventStt);
				N: XIC(b_EventStt[20])XIC(b_Triger_OpenNew)MOV(32,nn_EventStt);
				N: XIC(b_EventStt[32])MOV(34,nn_EventStt);
				N: XIC(b_EventStt[34])XIC(b_TrigerCollect)MOV(40,nn_EventStt);
				N: XIC(b_EventStt[40])XIO(b_TrigerCollect)MOV(34,nn_EventStt);
		END_ROUTINE

		ST_ROUTINE R04_PrintCountState_bit 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// Send Event Point to Printer State bit ////////////////////////////////////////////////
			'/////////////////////////////////////////////////////////////////////////////////////////
			'
			'b_PriCoStt[0]  := ( nn_PriCoStt = 0  );
			'b_PriCoStt[10] := ( nn_PriCoStt = 10 );
			'b_PriCoStt[13] := ( nn_PriCoStt = 13 );
			'b_PriCoStt[16] := ( nn_PriCoStt = 16 );
			'b_PriCoStt[19] := ( nn_PriCoStt = 19 );
			'b_PriCoStt[22] := ( nn_PriCoStt = 22 );
			'
			'
			'
			'
			'
		END_ST_ROUTINE

		ROUTINE R05_PrintCountState_Trns 
				RC: "Pirnt Count State Transition";
				N: XIC(b_Triger_InitializeStt)MOV(0,nn_PriCoStt);
				N: XIC(b_PriCoStt[0])XIC(b_EventStt[40])MOV(10,nn_PriCoStt);
				N: XIC(b_PriCoStt[10])[XIC(t_NoNeed.DN) XIC(b_EventStt[0]) MOV(0,nn_PriCoStt) ,XIC(b_PointReach0) MOV(13,nn_PriCoStt) ];
				N: XIC(b_PriCoStt[13])MOV(16,nn_PriCoStt);
				N: XIC(b_PriCoStt[16])[XIC(b_PrintComp) MOV(22,nn_PriCoStt) ,XIC(timeOUT[0].DN) MOV(19,nn_PriCoStt) ];
				N: XIC(b_PriCoStt[19])XIC(timeOUT[1].DN)MOV(22,nn_PriCoStt);
				N: XIC(b_PriCoStt[22])MOV(10,nn_PriCoStt);
				RC: "Aux Triger";
				N: XIC(b_PriCoStt[10])XIO(b_PointReach0)TON(t_NoNeed,?,?);
				N: XIC(b_PriCoStt[16])TON(timeOUT[0],?,?);
				N: XIC(b_PriCoStt[19])TON(timeOUT[1],?,?);
				N: XIC(b_PriCoStt[22])OSR(b_PlsStrg[0],b_CountUpP);
		END_ROUTINE

		ST_ROUTINE R07_ExchangeList 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// Exchange EV List  at Production End //////////////////////////////////////////////////
			'/////////////////////////////////////////////////////////////////////////////////////////
			'
			'// Close Last Product 
			'// Record Last Length and date 
			'// then, Move List[1] to List[2] and list[0] to List [1]
			'
			'if b_EventStt[12] then
			'	
			'	// Record Total Length
			'	
			'	event_List.f_TotalLngth := f_Length_me;
			'	
			'	// Up Date
			'	
			'	JSR(R50_UpDate );
			'	
			'end_if;
			'
			'b_ShiftListPls := b_EventStt[12] and not(b_ShiftListTmp);
			'b_ShiftListTmp := b_EventStt[12];
			'
			'		
			'// Initialize List [0]
			'
			'if b_EventStt[32] then
			'	
			'	// Get Product Name
			'	
			'	COP( s_PrdctName, event_List.s_Id, 1); 
			'	
			'	// Cleare Data Number
			'	
			'	event_List.n_Printed := 0;
			'	event_List.n_Recorded := 0;
			'	
			'	// Clear Point List
			'	
			'	event_Point1.f_Length := 0;
			'	event_Point1.s_EvntName := '';
			'	COP( event_Point1, event_List.POINT[0], 1 );
			'	COP( event_List.POINT[0], GEVENT_LIST[0].POINT[1], 99 );
			'	
			'	// Clear Total Length
			'	
			'	event_List.f_TotalLngth := 0;
			'
			'	// Up Date
			'	
			'	JSR(R50_UpDate );
			'	
			'end_if;
			'
			'
		END_ST_ROUTINE

		ST_ROUTINE R08_EventRecord 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// Event Record /////////////////////////////////////////////////////////////////////////
			'/////////////////////////////////////////////////////////////////////////////////////////
			'
			' /* // tempolaly Test code from here
			'	
			'	nn_c1 := 0;
			' 
			'    // Converse Respos Time set from Real[s] to DINT[ms]
			'
			'    f_Dmmy := TPFRM05_f_EventOffDelyT[nn_c1] * 1000;
			'	tmr_Rsp[nn_c1].PRE := f_Dmmy;
			'	if ( tmr_Rsp[nn_c1].PRE < 10 )then tmr_Rsp[nn_c1].PRE := 10; end_if;
			'
			'    // Generate Event Record Exec bits
			'
			'	event_pls[nn_c1].InputBit := b_E_RQ[nn_c1];
			'	OSRI(event_pls[nn_c1]);
			'	b_E_Generate[nn_c1] :=  (b_EventStt[40] and event_pls[nn_c1].OutputBit 
			'	                                                      and (tmr_Rsp[nn_c1].DN));
			'	
			'	// On Delay Timer for Respons Frequency Limit
			'	
			'	tmr_Rsp[nn_c1].EnableIn := 1;
			'	tmr_Rsp[nn_c1].TimerEnable := not( b_E_Generate[nn_c1] );
			'	tmr_Rsp[nn_c1].Reset := ( b_E_Generate[nn_c1] );
			'	
			'	TONR(tmr_Rsp[nn_c1]);
			'	
			'	// Generate and Record Event Point
			'	
			'	if (b_E_Generate[nn_c1] and (GEVENT_LIST[0].n_Recorded <= 99)) then
			'		
			'		event_Point1.s_EvntName := event_ParSets.EVENT_PARS[nn_c1].s_name;
			'		event_Point1.f_Length := TPTO02_f_TU_Lngth_me 
			'		                       + event_ParSets.EVENT_PARS[nn_c1].f_LnghtOffset;
			'		nn_Dmmy:= event_List.n_Recorded;
			'		COP(event_Point1, event_List.POINT[ nn_Dmmy ], 1);
			'		event_List.n_Recorded := event_List.n_Recorded + 1;
			'		
			'	end_if;
			'*/
			'
			' 
			'
			'
			'
			'
			'	
			' // tempolaly comment out from hear
			'	
			' For nn_c1 := 0
			' 	To 29
			' 	By 1
			'	do
			'
			'    // Converse Respos Time set from Real[s] to DINT[ms]
			'
			'    f_Dmmy := TPFRM05_f_EventOffDelyT[nn_c1] * 1000;
			'	tmr_Rsp[nn_c1].PRE := f_Dmmy;
			'	if ( tmr_Rsp[nn_c1].PRE < 10 )then tmr_Rsp[nn_c1].PRE := 10; end_if;
			'
			'    // Generate Event Record Exec bits
			'
			'	event_pls[nn_c1].InputBit := b_E_RQ[nn_c1] and TPFRM05_b_PrntSlct[nn_c1];
			'	OSRI(event_pls[nn_c1]);
			'	b_E_Generate[nn_c1] :=  (b_EventStt[40] and event_pls[nn_c1].OutputBit 
			'	                                                      and (tmr_Rsp[nn_c1].DN));
			'	
			'	// On Delay Timer for Respons Frequency Limit
			'	
			'	tmr_Rsp[nn_c1].EnableIn := 1;
			'	tmr_Rsp[nn_c1].TimerEnable := not( b_E_Generate[nn_c1] );
			'	tmr_Rsp[nn_c1].Reset :=  ( b_E_Generate[nn_c1] );
			'	
			'	TONR(tmr_Rsp[nn_c1]);
			'	
			'	// Generate and Record Event Point
			'	
			'	if (b_E_Generate[nn_c1] and (GEVENT_LIST[0].n_Recorded <= 99)) then
			'		
			'		event_Point1.s_EvntName := event_ParSets.EVENT_PARS[nn_c1].s_name;
			'		event_Point1.f_Length := TPTO02_f_TU_Lngth_me 
			'		                       + event_ParSets.EVENT_PARS[nn_c1].f_LnghtOffset;
			'		nn_Dmmy:= event_List.n_Recorded;
			'		COP(event_Point1, event_List.POINT[ nn_Dmmy ], 1);
			'		event_List.n_Recorded := event_List.n_Recorded + 1;
			'		
			'	end_if;
			'		
			'end_for;
			'
			' // tempolary commnet out to here
			'
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'// Change Order Of Event Points which is Not Printed from shoter to longer.
			'// Because Printed Data is already fixed and should no be changed.
			'//
			'// Example 
			'// "Printed" = 2 means [0],[1] are printed.
			'// also [2] may be printing now, It should not be changed.
			'// "Recorded" = 7 means [0],[1],[2],[3],[4],[5],[6] are recorded.
			'// So, We have to Compare and Change Order [3],[4],[5],[6]
			'// 3= "Printed + 1" ,  6 = ("Recorded" - 1 )
			'// So loop counter "C" shoud be start from "Printed + 1" and end is "Recorded -2 "
			'// and compare [C] and [C+1] and if [C+1] < [C] then swap them.
			'// if "recorded" - "printed" =3, for example "recorded" is 6, and "Printed" is 3
			'// [0][1][2][3][4][5] is recorded, and [0][1][2] is printed and [3] may be printing now.
			'// so, [4][5] are change order element. "C" shoud be start from "Printed" + 1 = 4.
			'// "C" Shoud be stop at recorded -1 = 4. and compare [4]and[5] then swap them if need.
			'// So if ("recorded" - "printed") < 3, we dont execute swap.
			'
			'
			'// tempolary comment out from here
			'
			'if ( 3<= (event_List.n_Recorded - event_List.n_Printed ) ) then
			'	
			'	For nn_c2 := event_List.n_Printed + 1
			'		To event_List.n_Recorded -2
			'		by 1
			'		do
			'		
			'		if 99 < nn_c2 then 
			'		   nn_c2 := 98 ;
			'		end_if;
			'		
			'			if ( event_List.POINT[nn_c2 + 1].f_Length 
			'				                        < event_List.POINT[nn_c2].f_Length ) then
			'				nn_Dmmy := nn_c2 + 1;
			'				JSR(R51_Swap_2Point_of_List, 2, nn_c2 , nn_Dmmy );
			'			end_if;
			'				
			'	end_for;
			'	
			'end_if;
			'
			'//tempplary comment out end
			'
		END_ST_ROUTINE

		ST_ROUTINE R10_PrintData 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// Print Data ///////////////////////////////////////////////////////////////////////////
			'/////////////////////////////////////////////////////////////////////////////////////////
			'
			'// Compare event Length with TU Counter and then ditect the event through 0 point.
			'// ANd Set tne Event Print to Print Out request Data.
			'
			'/* // tempolary comment out 
			'
			'nn_Dmmy :=  event_List.n_Printed;
			'
			'if( 100 <= nn_Dmmy ) then 
			'	nn_Dmmy := 99 ;
			'end_if;
			'	
			'if (nn_Dmmy < event_List.n_Recorded ) then
			'
			'    b_PointReach0 := ( event_List.POINT[ nn_Dmmy ].f_Length < f_Length_me ) 
			'                 and ( b_PriCoStt[10] );
			' end_if;
			'// Set Print Out Event Data
			'
			'COP ( event_List.POINT[nn_Dmmy] , printPoint1 , 1 );
			'
			'if( b_CountUpP ) then
			'	event_List.n_Printed := event_List.n_Printed + 1;		
			'end_if;
			'
			'if (100 <= event_List.n_Printed)
			'	then event_List.n_Printed:=100;
			'end_if;
			'
			'*/ // tempolary comment Out
			'
