		BIT b_Slct_BND1 ZZZZZZZZZZRCP_RRDCT0 : 5 (Description := "ON=use D5290");
		BIT b_Slct_BND2 ZZZZZZZZZZRCP_RRDCT0 : 6 (Description := "ON=use D5295");
		BIT b_Slct_LumpDitct ZZZZZZZZZZRCP_RRDCT0 : 7 (Description := "Use=On D5313");
		BOOL b_Slct_PO[32] (Description := "ON=use,[0]=No1…[11]=No12 D5270");
		SINT ZZZZZZZZZZRCP_RRDCT10 (Hidden := 1);
		BIT b_Slct_StaticElmntr ZZZZZZZZZZRCP_RRDCT10 : 0 (Description := "Use=On D5299");
		REAL f_BND1_Pitch_ns (Description := "[mm/r]Bind Pitch");
		REAL f_BND2_Pitch_ns (Description := "[mm/r]Bind Pitch");
		REAL f_FRYR_TwistPitch_ns (Description := "[mm/r]Twist Pitch D5261");
