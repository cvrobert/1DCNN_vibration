				N: XIC(b_TRV_OriRTB_Stt[26])XIC(b_HomeTeachMem)MOV(30,n_TRV_OriRTB_Stt);
				N: XIC(b_TRV_OriRTB_Stt[30])XIC(G_interum_timer[1].DN)MOV(36,n_TRV_OriRTB_Stt);
