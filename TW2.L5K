		END_ST_ROUTINE

		ST_ROUTINE R04_LngthCtr 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// P63_LengthCounter R04_LngthCtr ///////////////////////////////////////////////////////
			'/////////////////////////////////////////////////////////////////////////////////////////
			'
			'// Cap Motor Pls
			'// CAP Servo Motor revolution value parameters unit is [r] (means revolution)
			'// with REAL type. WE convers this data [0.001r]unit DINT type.
			'
			'f_Dmy := G_f_LngthCtr * 1000;
			'
			'nn_CAP_RevCnt := f_Dmy;
			'
			'// Take-Up Lenght Counter Count Up Process //////////////////////////////////////////////
			'
			'takeUp_CTR.EnableIn := 1;
			'takeUp_CTR.b_Z_Rst := GLNGTH_b_TU_CntrRst;
			'takeUp_CTR.b_Pause := b_CountPause;
			'takeUp_CTR.nn_InCnt := nn_CAP_RevCnt;
			'takeUp_CTR.f_weight := 1000;
			'takeUp_CTR.f_Length_ns := TPFRM03_f_TU_Lngth_ns;
			'
			'LngthCtr0 (takeUp_CTR);
			'
			'TPTO02_f_TU_Lngth_me := takeUp_CTR.f_Length_me;
			'
			'f_TU_RmngPrdLngth := takeUp_CTR.f_RemainingL;
			'
			'
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'// Pay -Off 12 Counters Count Up Process ////////////////////////////////////////////////
			'
			'f_PO_MinLngth := 99999;               // MInLngth is shortest lenght of 12 caurse.
			'
			'For nn_i01 := 0
			'	To 11
			'	By 1
			'	do
			'	
			'	payOff_CTR[nn_i01].EnableIn := 1;
			'	payOff_CTR[nn_i01].b_Z_Rst := TPFRM06_b_PO_CtrRst_PB[nn_i01];
			'	payOff_CTR[nn_i01].b_Pause 
			'	                        := ( (b_CountPause) or not(TPFRM_RUNSET.b_Slct_PO[nn_i01]) );
			'	payOff_CTR[nn_i01].nn_InCnt := nn_CAP_RevCnt;
			'	payOff_CTR[nn_i01].f_weight := 1000;
			'	if TPFRM06_b_PO_CtrRst_PB[nn_i01] then
			'	payOff_CTR[nn_i01].f_Length_ns := TPFRM03_f_PO_Lnght_ns[nn_i01];end_if;
			'
			'	LngthCtr0 (payOff_CTR[nn_i01]);
			'	
			'	TPTO02_f_PO_RmngLngth_me[nn_i01] := payOff_CTR[nn_i01].f_RemainingL;
			'	
			'	if (TPFRM_RUNSET.b_Slct_PO[nn_i01] ) then
			'		if ( TPTO02_f_PO_RmngLngth_me[nn_i01] < f_PO_MinLngth ) then
			'			f_PO_MinLngth := TPTO02_f_PO_RmngLngth_me[nn_i01];
			'		end_if;
			'	end_if;
			'
			'end_for;
			'
			'TPTO02_f_PO_MinLngth := f_PO_MinLngth ;
			'
			'// Binder 1 and 2 Conters Count Up Process ////////////////////////////////////////////////
			'
			'binder_LNGT_CTR[0].EnableIn := 1;
			'binder_LNGT_CTR[0].b_Z_Rst := TPFRM06_b_BND01_CtrRst_PB;
			'binder_LNGT_CTR[0].b_Pause := ((b_CountPause ) or not(TPFRM_RUNSET.b_Slct_BND1));
			'binder_LNGT_CTR[0].nn_InCnt := nn_CAP_RevCnt;
			'binder_LNGT_CTR[0].f_weight := 1000;
			'if TPFRM06_b_BND01_CtrRst_PB then
			'	                         binder_LNGT_CTR[0].f_Length_ns := TPFRM03_f_BND01_Lngth_ns;
			'end_if;
			'
			'LngthCtr0 (binder_LNGT_CTR[0]);
			'
			'TPTO02_f_BND1RmnnLngth := binder_LNGT_CTR[0].f_RemainingL;
			'
			'binder_LNGT_CTR[1].EnableIn := 1;
			'binder_LNGT_CTR[1].b_Z_Rst := TPFRM06_b_BND02_CtrRst_PB;
			'binder_LNGT_CTR[1].b_Pause :=((b_CountPause) or not(TPFRM_RUNSET.b_Slct_BND2));
			'binder_LNGT_CTR[1].nn_InCnt := nn_CAP_RevCnt;
			'binder_LNGT_CTR[1].f_weight := 1000;
			'if TPFRM06_b_BND02_CtrRst_PB then
			'                       binder_LNGT_CTR[1].f_Length_ns := TPFRM03_f_BND02_Lngth_ns;
			'end_if;
			'
			'LngthCtr0 (binder_LNGT_CTR[1]);
			'
			'TPTO02_f_BND2RmnnLngth := binder_LNGT_CTR[1].f_RemainingL;
			'
			'RET();
		END_ST_ROUTINE

		ST_ROUTINE R05_CalcLengthForStop 
