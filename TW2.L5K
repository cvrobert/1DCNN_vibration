		ROUTINE R01_CmmndFlags 
				N: [XIC(GSTT_b_LineState[7]) ,XIC(GSTT_b_LineState[32]) ,XIC(GSTT_b_LineState[55]) ,XIC(GSTT_b_LineState[56]) ,XIC(GSTT_b_LineState[80]) ,XIC(GSTT_b_LineState[81]) ]OTE(b_STT_is_RUN_OK);
				N: [XIC(GSTT_b_LineState[5]) ,XIC(GSTT_b_LineState[7]) ,XIC(GSTT_b_LineState[30]) ,XIC(GSTT_b_LineState[32]) ,XIC(GSTT_b_LineState[55]) ,XIC(GSTT_b_LineState[56]) ,XIC(GSTT_b_LineState[80]) ,XIC(GSTT_b_LineState[81]) ]OTE(b_STT_is_JOG_OK);
				RC: "1 June 2026     Shoe$N"
				    "DISABLE Line Ramp UP function except in Line State 65 -- which is actual Production Mode at normal Line Speed$N"
				    "Line States 15_40_90 are Scrap and Sample sequences at end of a Run -- $N"
				    "accidental Ramp during these Line States has Caused PO2 Torque Warning and Alarm conditions$N"
				    "";
				N: [XIC(Always_OFF) XIC(GSTT_b_LineState[15]) ,XIC(Always_OFF) XIC(GSTT_b_LineState[40]) ,XIC(GSTT_b_LineState[65]) ,XIC(Always_OFF) XIC(GSTT_b_LineState[90]) ]OTE(b_STT_is_M_Up_OK);
		END_ROUTINE

