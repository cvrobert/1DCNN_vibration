	DATATYPE AX_PAR_BBN (Description := "Bobbin Drive Axis Gia Parameter",
	                     FamilyType := NoFamily)
		REAL f_Spd_Max (Description := "[rpm] Maximum speed Of Out Put Shaft with Maximum Motor Speed");
		REAL f_Ref_Max (Description := "Maximum Speed Reference for Motor");
		REAL f_Spd_HiLmt (Description := "[rpm] Hiest Limit of the Speed for real Use");
		SINT ZZZZZZZZZZAX_PAR_BBN3 (Hidden := 1);
		BIT b_is_TU ZZZZZZZZZZAX_PAR_BBN3 : 0 (Description := "Property of This Axix, $QOff$Q means Pay Off, $QOn$Q means Take Up");
	END_DATATYPE

	DATATYPE AX_PAR_BND (Description := "Axis Gia Diagram Parameter of Binder",
	                     FamilyType := NoFamily)
		REAL f_Spd_Max (Description := "[rpm] Maximum Speed Of Out Put Axis with Maximum Motor Speed");
		REAL f_Ref_Max (Description := "Maximum Motror Speed Reference with some Unit");
		REAL f_Spd_HiLmt (Description := "[rpm] Speed Hiest Limit For Real Use");
	END_DATATYPE

	DATATYPE AX_PAR_CAP (Description := "Capstan Axis Gia Diagram Parameter",
	                     FamilyType := NoFamily)
		REAL f_Spd_Max (Description := "[m/min] Maximum Speed Of Out Put Axis");
		REAL f_Ref_Max (Description := "Maximum Speed Reference for Motor as Some Unit");
		REAL f_Spd_HiLmt (Description := "[m/min] Upper Speed Limit of  Out Put Axis for Real Use");
	END_DATATYPE

	DATATYPE AX_PAR_FRYR (Description := "Fryer Axis Gia Difine",
	                      FamilyType := NoFamily)
		REAL f_Spd_Max (Description := "[rpm]　Maximum speed With maximum motor speed Refernce");
		REAL f_Ref_Max;
		REAL f_Spd_HiLimit (Description := "[rpm]");
	END_DATATYPE

	DATATYPE AX_PAR_TRV (Description := "Parameter for Traverse Gia Diagram",
	                     FamilyType := NoFamily)
		REAL f_Spd_Max (Description := "[mm/s] Traverse Maximum Speed With");
		REAL f_Ref_Max (Description := "Motor Maximim Speed Reference");
		REAL f_Spd_HiLmt (Description := "[mm/s] Traverse Hiest Speed Limit For Real Use");
	END_DATATYPE

	DATATYPE BBN_TYPE (Description := "Define Bobbin Size",
	                   FamilyType := NoFamily)
		STRING s_Name (Description := "Name of Bobbin Type");
		REAL f_DiaMin (Description := "[mm] Minimum Diameter = Barel Diameter");
		REAL f_DiaMax (Description := "[mm] Maximum Diameter = Flange Diameter");
		REAL f_innrWidth (Description := "[mm] Inner Width Of  Barrel");
		REAL f_OutrWidth (Description := "[mm] Out Side Widht OF Bbbin");
	END_DATATYPE

	DATATYPE DNCR_GAIN (Description := "Dancer Control Parameter",
	                    FamilyType := NoFamily)
		REAL f_P (Description := "[rpm/100%] P correct Gain With Dancer Maximum Error");
		REAL f_I_Time (Description := "[s] Integrate Time for Diameter Correct with Maximum Dancer Error");
	END_DATATYPE

	DATATYPE DNCR_PSTN_SCL_PAR (Description := "Dancer Position Scale Tanslate Parameter",
	                            FamilyType := NoFamily)
		REAL f_UpLimit (Description := "[U] Analog Input Value With Dancer Up Limit (or Nearesest )Position");
		REAL f_Midle (Description := "[U] Analog Input Value With Dancer Center Position");
		REAL f_DwnLimit (Description := "[U] Analog Input Value with Dancer Lowest Limit8of Farest) Position");
	END_DATATYPE

	DATATYPE EVENT_LIST (Description := "Event Record List for Product with Each Take Up Bobbin",
	                     FamilyType := NoFamily)
		STRING s_Id;
		INT n_Date_Year;
		INT n_Date_Month;
		INT n_Date_Day;
		INT n_Date_hour;
		INT n_Date_Minute;
		REAL f_TotalLngth (Description := "[m] Total Take Up Length Of Product$Non The Bobbin");
		INT n_Recorded (Description := "Last Number Of Recorded Event Point List");
		EVENT_POINT POINT[100] (Description := "Event Point List");
		INT n_Printed (Description := "Last Number Of Prited Event Point List");
	END_DATATYPE

	DATATYPE EVENT_PAR (Description := "Define  Event Point Data Type",
	                    FamilyType := NoFamily)
		STRING s_name (Description := "Event Point Name ForExample, Diameter Large");
		REAL f_LnghtOffset (Description := "Pass Length From Counter 0 Point, Event Point = Counter value + this Value");
	END_DATATYPE

	DATATYPE EVENT_PAR_SET (Description := "Parameters to make Event Data",
	                        FamilyType := NoFamily)
		EVENT_PAR EVENT_PARS[30] (Description := "List of Event Define Parameter");
		REAL f_Lnght_Frm_TU (Description := "[m] Lenght from Counter 0 Point to Take Up Point");
	END_DATATYPE

	DATATYPE EVENT_POINT (Description := "Point on the Products with some Event",
	                      FamilyType := NoFamily)
		REAL f_Length (Description := "[m] Event Point on the product from Take Up start end");
		STRING s_EvntName;
	END_DATATYPE

	DATATYPE MTR_MNTR (Description := "Motor Monitor Value Set",
	                   FamilyType := NoFamily)
		REAL f_Spd_as (Description := "[rpm] Motor Speed Reference");
		REAL f_Spd_me (Description := "[rpm]Motor Speed Actual Value");
		REAL f_Trq_me (Description := "[%] Motor Output Torque Value");
		REAL f_Ampere (Description := "[A] Motor Primary Curent");
	END_DATATYPE

	DATATYPE RCP_RRDCT (Description := "Recipi File For Production Setting List",
	                    FamilyType := NoFamily)
		SINT ZZZZZZZZZZRCP_RRDCT0 (Hidden := 1);
		BIT b_BND1_CheesPoDrct ZZZZZZZZZZRCP_RRDCT0 : 0 (Description := "CLW=1(fromUpSide)");
		BIT b_BND1_Drct ZZZZZZZZZZRCP_RRDCT0 : 1 (Description := "off=Z,ON=S");
		BIT b_BND2_CheesPoDrct ZZZZZZZZZZRCP_RRDCT0 : 2 (Description := "ACLW=1(fromTakeUp)");
