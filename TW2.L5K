		ROUTINE MainRoutine 
				N: JSR(R02_AuxEquipment,0);
				N: JSR(R03_RunMainbit,0);
				N: JSR(R05_SpdRfClc,0);
				N: JSR(R06_TU_OutPut,0);
		END_ROUTINE

		ROUTINE R02_AuxEquipment 
				N: XIC(M11ETH:1:I.Pt07.Data)[OSR(b_PlsStrage[0],b_TU_FJog_Rsng) ,OSF(b_PlsStrage[1],b_BBN_FJog_Fllng) ];
				N: XIC(M11ETH:1:I.Pt08.Data)[OSR(b_PlsStrage[2],b_BBN_RJog_Rsng) ,OSF(b_PlsStrage[3],b_BBN_RJog_Fllng) ];
				N: EQU(GTU_f_Spd_as,0)OTE(b_Spd_as_Zero);
		END_ROUTINE

		ROUTINE R03_RunMainbit 
				N: XIO(G_b_Alm1IL[0])XIO(G_b_Alm1IL[7])XIO(G_b_Alm1IL[8])XIO(G_b_Alm1IL[9])XIO(G_b_Alm1IL[10])XIO(G_b_Alm1IL[11])XIO(G_b_Alm1IL[14])XIO(G_b_Alm1IL[15])OTE(b_ES_Aux1);
				N: XIO(G_b_Alm1IL[17])XIO(G_b_Alm1IL[21])XIO(G_b_Alm1IL[24])XIO(G_b_Alm1IL[25])XIO(G_b_Alm1IL[28])XIO(G_b_Alm1IL[61])OTE(b_ES_Aux2);
				N: XIO(G_b_Alm1IL[105])XIO(G_b_Alm3IL[50])XIO(G_b_Alm3IL[51])XIO(G_b_Alm3IL[52])XIO(G_b_Alm3IL[53])XIO(G_b_Alm3IL[54])XIO(G_b_Alm3IL[55])XIO(G_b_Alm3IL[56])OTE(b_ES_Aux3);
				N: XIO(G_b_Alm3IL[61])XIO(G_b_Alm3IL[62])XIO(G_b_Alm3IL[63])XIO(G_b_Alm3IL[64])OTE(b_ES_Aux4);
				N: XIC(b_ES_Aux1)XIC(b_ES_Aux2)XIC(b_ES_Aux3)XIC(b_ES_Aux4)OTE(b_ES_Single);
				N: XIC(b_ES_Aux1)XIC(b_ES_Aux2)XIC(b_ES_Aux3)XIC(b_ES_Aux4)OTE(b_ES_Synch);
				RC: "//////////////////////////////////////////////////////////// Take-Up Bobbin Foword Jog  /////////////////////////////////////////////////////";
				N: XIO(b_TU_SynchRun_Mb)XIO(GTU_b_RvJog_Mb)OTE(b_Exclusive_Fjog);
				N: XIC(b_ES_Single)XIC(b_Exclusive_Fjog)XIO(b_TU_FJog_Fin)[XIC(b_TU_FJog_Rsng) XIC(G_b_CNV1_MC_Intrvl_OK) ,XIC(GTU_b_FwJog_Mb) ]OTE(GTU_b_FwJog_Mb);
				N: XIC(GTU_b_FwJog_Mb)[XIC(b_BBN_FJog_Fllng) ,XIC(b_TU_FJog_stpHold) ][OTE(b_TU_FJog_stpHold) ,XIC(b_Spd_as_Zero) OTE(b_TU_FJog_Fin) ];
				RC: "//////////////////////////////////////////////////////////// Take-Up Bobbin Reverse Jog  /////////////////////////////////////////////////////$N"
				    "";
				N: XIO(b_TU_SynchRun_Mb)XIO(GTU_b_FwJog_Mb)OTE(b_Exclusive_Rjog);
				N: XIC(b_ES_Single)XIC(b_Exclusive_Rjog)XIO(b_TU_RJog_Fin)[XIC(b_BBN_RJog_Rsng) XIC(G_b_CNV1_MC_Intrvl_OK) ,XIC(GTU_b_RvJog_Mb) ]OTE(GTU_b_RvJog_Mb);
				N: XIC(GTU_b_RvJog_Mb)[XIC(b_BBN_RJog_Fllng) ,XIC(b_TU_RJog_stpHold) ][OTE(b_TU_RJog_stpHold) ,XIC(b_Spd_as_Zero) OTE(b_TU_RJog_Fin) ];
				RC: "//////////////////////////////////////////////////////////////// Take-Up Bobbin Synchro Run Main bit Sequence /////////////////////////////////////////////";
				N: XIC(b_ES_Synch)XIC(G_b_LineRunJogZero)OTE(b_TU_SynchRun_Mb);
				RC: "//////////////////////////////////////////////////////// Take Up Door Open Hold ///////////////////////////////////////////////////";
				N: XIO(b_TU_SynchRun_Mb)[XIC(GSTT_b_LineState[55]) ,XIC(M11ETH:2:I.Pt01.Data) ,XIC(b_DoorUnlockHb) ]OTE(b_DoorUnlockHb);
				RC: "////////////////////////////////////////////////////// Take Up Bobbin Brake Manual Open Hold /////////////////////////////////////////////////////";
				N: XIO(GTU_b_FwJog_Mb)XIO(GTU_b_RvJog_Mb)XIO(b_TU_SynchRun_Mb)XIO(M11ETH:1:I.Pt10.Data)[XIC(M11ETH:1:I.Pt09.Data) ,XIC(b_BrkManOpen) ]OTE(b_BrkManOpen);
		END_ROUTINE

		ST_ROUTINE R05_SpdRfClc 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// take-Up Speed Reference //////////////////////////////////////////////////////////////
			'/////////////////////////////////////////////////////////////////////////////////////////
			'
			'// DancerControl Parameter //////////////////////////////////////////////////////////////
			'
			'takeUp_DNCR_Cntrl.EnableIn := 1;
			'takeUp_DNCR_Cntrl.b_is_TU := GLIB_AX_TU.b_is_TU;
			'takeUp_DNCR_Cntrl.b_RstDia := G_b_Alm1IL[33];
			'takeUp_DNCR_Cntrl.f_SpdMax := GLIB_AX_TU.f_Spd_Max;
			'takeUp_DNCR_Cntrl.f_DiaMax := TPFRM_TU_BBN.f_DiaMax;
			'takeUp_DNCR_Cntrl.f_DiaMin := TPFRM_TU_BBN.f_DiaMin;
			'takeUp_DNCR_Cntrl.f_DNCR_Is := GLIB_DNCR_GAIN_TU.f_I_Time;
			'takeUp_DNCR_Cntrl.f_DNCR_Kp := GLIB_DNCR_GAIN_TU.f_P;
			'
			'takeUp_DNCR_Cntrl.f_DNCR_Pstn_me := TPTO02_f_DncrPstn_TU_me;
			'takeUp_DNCR_Cntrl.f_Line_Spd_me := GCAP_f_Spd_as;
			'
			'takeUp_DNCR_Cntrl.b_Run := G_b_TU_SV_ON;
			'takeUp_DNCR_Cntrl.b_I_Calc := (( G_b_TU_SV_ON ) and ( 5< GCAP_f_Spd_as ));
			'
			'// Exec Dancer Control Calculation //////////////////////////////////////////////////////
			'
			'BBN_DNCR_Cntrl00(takeUp_DNCR_Cntrl);
			'
			'// Get Speed Reference //////////////////////////////////////////////////////////////////
			'// 31 MARCH 2021  Shoe  PER Oshida-san instructions for individual axis motor testing -- see page 3 of "Procedure of Motor Operation Check" -- upper statement for normal run_lower for testing
			'// 25 March 2026  Croberts added conditions for high pitch runs where takeup would go in reverse and then transition to forward sometime in the run
			'//this condition caused the logic here to get stuck originally when the AxisSpd tag would go from negative to positive
			'
			'//If the takeup axis is told to go 0 spd, instead go to 0.01
			'if (takeUp_DNCR_Cntrl.f_AxisSpd_as = 0 and takeUp_DNCR_Cntrl.f_Line_Spd_me <> 0) then
			'	takeUp_DNCR_Cntrl.f_AxisSpd_as := 0.001;
			'end_if;
			'
			'//If the takeup axis is told to go near 0 (positive) then default to 0.01
			'if (takeUp_DNCR_Cntrl.f_AxisSpd_as > 0 and takeUp_DNCR_Cntrl.f_AxisSpd_as < 0.01) then
			'	
			'	takeUp_DNCR_Cntrl.f_AxisSpd_as := 0.01;
			'	
			'end_if;
			'
			'//If the takeup axis is told to go near 0 (negative) then default to -0.01
			'if (takeUp_DNCR_Cntrl.f_AxisSpd_as > -0.01 and takeUp_DNCR_Cntrl.f_AxisSpd_as < 0) then
			'	
			'	takeUp_DNCR_Cntrl.f_AxisSpd_as := -0.01;
			'	
			'end_if;
			'
			'
			'GTU_f_AppAxisSpd_as := takeUp_DNCR_Cntrl.f_AxisSpd_as;  // It is Plus When Winding     COMMENT THIS STATEMENT OUT FOR TESTING
			'//GTU_f_AppAxisSpd_as := takeUp_DNCR_Cntrl.f_AxisSpd_as *(takeUp_DNCR_Cntrl.f_Dia_me/TPFRM_TU_BBN.f_DiaMin);  // It is Plus When Winding   COMMENT THIS STATEMENT OUT FOR NORMAL RUN
			'
			'// Get Bobbin Diameter /////////////////////////////////////////////////////////////////
			'
			' TPTO02_f_TU_BBN_DIA_me := takeUp_DNCR_Cntrl.f_Dia_me ;
			'// Calculation of Take-Up Bobbin Actual set From Appearence one ////////////////////////
			'
			'if ( TPFRM_RUNSET.b_FRYR_TwistDrct ) then                 // S Direction_
			'	f_SynchSpd_as := GFRYR_f_Spd_as + GTU_f_AppAxisSpd_as; // FRYR = Minus  ORIGINAL
			'		
			'elsif( not(TPFRM_RUNSET.b_FRYR_TwistDrct) ) then          // Z Direction
			'	f_SynchSpd_as := GFRYR_f_Spd_as - GTU_f_AppAxisSpd_as;  // FRYR = PLUS
			'end_if;	
			'
			'
			'// The Following program says Take-UP Bobbin Jog ///////////////////////////////////////
			'
			'if   ( GTU_b_FwJog_Mb and not( b_TU_FJog_stpHold ) ) then
			'	f_TU_JogSpd_ns := 20;
			'elsif( GTU_b_RvJog_Mb and not( b_TU_RJog_stpHold ) ) then
			'	f_TU_JogSpd_ns := -20;
			'else
			'	f_TU_JogSpd_ns := 0;
			'end_if;
			'
			'takeUp_Jog_SFS.f_Accrat := 150;
			'takeUp_Jog_SFS.f_Dccrat := 150;
			'takeUp_Jog_SFS.b_NoRst := ( GTU_b_FwJog_Mb or GTU_b_RvJog_Mb );
			'takeUp_Jog_SFS.f_ns := f_TU_JogSpd_ns;
			'
			'// Exec Bobbin Jog /////////////////////////////////////////////////////////////////////
			'
			'SFS00(takeUp_Jog_SFS);
			'
			'// Select Take Up Speed ////////////////////////////////////////////////////////////////
			'
			'if ( G_b_LineRunJogZero ) then
			'	GTU_f_Spd_as := f_SynchSpd_as;
			'elsif ( GTU_b_FwJog_Mb or GTU_b_RvJog_Mb ) then
			'	GTU_f_Spd_as := takeUp_Jog_SFS.f_as;
			'else
			'	GTU_f_Spd_as := 0;
			'end_if;
			'
			'TPTO02_MTR_TU.f_Spd_me := SV1_Axis2_TU.VelocityFeedback * 60 * (24/90);
		END_ST_ROUTINE

		ROUTINE R06_TU_OutPut 
				N: XIO(G_b_Alm1IL[0])XIO(G_b_Alm1IL[7])XIO(G_b_Alm1IL[8])XIO(G_b_Alm1IL[9])XIO(G_b_Alm1IL[10])XIO(G_b_Alm1IL[11])XIO(G_b_Alm1IL[14])XIO(G_b_Alm1IL[15])XIO(G_b_Alm1IL[17])XIO(G_b_Alm1IL[21])XIO(G_b_Alm1IL[24])XIO(G_b_Alm1IL[28])XIO(G_b_Alm1IL[49])XIO(G_b_Alm1IL[50])XIO(G_b_Alm1IL[105])XIO(G_b_Alm3IL[61])OTE(b_TU_ServoIL);
