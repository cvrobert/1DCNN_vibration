		ROUTINE R02_RunMainbit 
				N: XIO(G_b_Alm1IL[0])XIO(G_b_Alm1IL[7])XIO(G_b_Alm1IL[8])XIO(G_b_Alm1IL[9])XIO(G_b_Alm1IL[10])XIO(G_b_Alm1IL[11])XIO(G_b_Alm1IL[14])XIO(G_b_Alm1IL[15])OTE(b_Alarm_Sub[0]);
				N: XIO(G_b_Alm1IL[28])XIO(G_b_Alm1IL[82])OTE(b_Alarm_Sub[1]);
				N: XIO(G_b_Alm1IL[92])XIO(G_b_Alm1IL[94])XIO(G_b_Alm1IL[95])XIO(G_b_Alm1IL[98])XIO(G_b_Alm1IL[105])OTE(b_Alarm_Sub[2]);
				N: XIO(G_b_Alm3IL[50])XIO(G_b_Alm3IL[51])XIO(G_b_Alm3IL[52])XIO(G_b_Alm3IL[53])XIO(G_b_Alm3IL[54])XIO(G_b_Alm3IL[55])XIO(G_b_Alm3IL[56])XIO(G_b_Alm3IL[61])OTE(b_Alarm_Sub[3]);
				N: XIO(G_b_Alm3IL[62])XIO(G_b_Alm3IL[63])XIO(G_b_Alm3IL[64])OTE(b_Alarm_Sub[4]);
				N: XIC(b_Alarm_Sub[0])XIC(b_Alarm_Sub[1])XIC(b_Alarm_Sub[2])XIC(b_Alarm_Sub[3])XIC(b_Alarm_Sub[4])OTE(b_Alarm_Summ);
				N: XIC(b_Alarm_Summ)XIO(b_BND_Run_Synch)XIO(b_BND_Stop_Comp_Single)XIO(G_b_LineRunJog)[XIC(M21ETH:1:I.Pt06.Data) XIC(G_b_CNV2_MC_Intvl_OK) ,XIC(b_BND_Run_Single) ]OTE(b_BND_Run_Single);
				N: XIC(b_BND_Run_Single)[XIO(M21ETH:1:I.Pt07.Data) ,XIC(b_BND_Stop_Single) ][OTE(b_BND_Stop_Single) ,XIC(b_Alone_Speed_Zero) OTE(b_BND_Stop_Comp_Single) ];
				N: XIC(b_Alarm_Summ)XIC(G_b_LineRunJogZero)XIC(TPFRM_RUNSET.b_Slct_BND2)OTE(b_BND_Run_Synch);
				N: [XIC(b_BND_Run_Single) ,XIC(b_BND_Run_Synch) ][OTE(b_BND_RUN) ,OTE(GBIND02_b_RUNNING) ];
				N: XIO(b_BND_RUN)XIO(M21ETH:1:I.Pt09.Data)[XIC(M21ETH:1:I.Pt08.Data) ,XIC(b_Break_Man_Open) ]OTE(b_Break_Man_Open);
		END_ROUTINE

		ST_ROUTINE R05_SpdRfCtrl01 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// P_41_Binder02 R05_SpdRfCtrl01 ////////////////////////////////////////////////////////
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// ver 1.00
			'// Bundle2_Speed_Control
			'// Auther Ryo Mikuni
			'// 2019.11.28
			'
			'// Single Speeed Target Value Set
			'if ( b_BND_Run_Single ) then 
			'	f_Single_Speed_Target_Value := TPFRM03_f_BND02_ManSpd_ns ;
			'else f_Single_Speed_Target_Value := 0; f_Single_Speed_as := 0 ; 
			'end_if;
			'
			'if ( b_BND_Stop_Single ) then 
			'	f_Single_Speed_Target_Value := 0 ;
			'end_if ;
			'
			'sfs_Ctrl.EnableIn := 1 ;
			'sfs_Ctrl.f_Accrat := 1000 / 60 ; // Acc= 1000rpm/min2　→　rpm/sec
			'sfs_Ctrl.f_Dccrat := 1000 / 60 ; // Dcc= 1000rpm/min2 →　rpm/sec
			'sfs_Ctrl.f_ns := f_Single_Speed_Target_Value ;
			'if b_BND_Run_Single then sfs_Ctrl.b_NoRst := 1;
			'else sfs_Ctrl.b_NoRst := 0 ; end_if;
			'
			'SFS00(sfs_Ctrl);
			'
			'f_Single_Speed_as := sfs_Ctrl.f_as ;
			'b_Alone_Speed_Zero := (f_Single_Speed_as = 0 );
			'
			'// Synchro Speed Target Value Set 
			'
			'b_Direct_Opposit := ( TPFRM_RUNSET.b_BND2_Drct XOR TPFRM_RUNSET.b_BND2_CheesPoDrct );
			'b_Direct_Same := not( b_Direct_Opposit );
			'
			' if( 0< TPFRM_RUNSET.f_BND1_Pitch_ns ) then
			'	f_Base_Rotation :=  GCAP_f_Spd_as / ( TPFRM_RUNSET.f_BND2_Pitch_ns /1000 ) ;
			' else
			'	f_Base_Rotation := 0;
			'end_if;
			'  
			' if( 0 < TPTO02_f_BND1CheeseDia_me ) then
			'	 f_Correction_Rotation := GCAP_f_Spd_as / (3.14 * TPTO02_f_BND2CheeseDia_me / 1000 );
			' else
			'	 f_Correction_Rotation := 0;
			'end_if;
			' 
			'  
			'if b_Direct_Same then f_Rotation_ns := f_Base_Rotation + f_Correction_Rotation; end_if;
			'if b_Direct_Opposit then f_Rotation_ns := f_Base_Rotation + f_Correction_Rotation; end_if;  //11/18/22 croberts originally a - correction factor here but changed to +   
			'
			'if b_BND_Run_Synch then f_BND_Spd_ns := f_Rotation_ns ; end_if;
			'if b_BND_Run_Single then f_BND_Spd_ns := f_Single_Speed_as ; end_if;
			'if not(TPFRM_RUNSET.b_BND2_Drct) then f_BND_Spd_ns := f_BND_Spd_ns * (-1) ; end_if;
			'if not(b_BND_RUN) then f_BND_Spd_ns := 0; end_if;
			'
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'
			'// BND2 Speed Limit
			'
			'if ( f_BND_Spd_ns < -(GLIB_AX_BND2.f_Spd_HiLmt) ) then 
			'	f_BND_Spd_ns :=  -(GLIB_AX_BND2.f_Spd_HiLmt) ; 
			'end_if;  //Low limit -2000rpm
			'
			'if ( f_BND_Spd_ns > GLIB_AX_BND2.f_Spd_HiLmt ) then
			'	f_BND_Spd_ns := GLIB_AX_BND2.f_Spd_HiLmt ; 
			'end_if;  // High limit 2000rpm
			'
			'TPTO02_MTR_BND2.f_Spd_me := SV2_Axis2_BND02.VelocityFeedback * 60 * (24/36);
		END_ST_ROUTINE

		ROUTINE R07_BindOutPut 
				N: XIC(b_BND_RUN)[TOF(tmr_Bind_MC,?,?) ,TON(tmr_Bind_SvOn,?,?) ];
				N: XIC(b_Alarm_Summ)XIC(tmr_Bind_MC.DN)OTE(G_b_BND02_MC_ON);
				N: [XIC(b_Alarm_Summ) XIC(tmr_Bind_MC.DN) ,XIC(M11ETH:2:I.Pt06.Data) ]OTE(M21ETH:2:O.Pt01.Data);
				N: XIC(b_Alarm_Summ)OTE(G_b_BND02_SV_ENBL);
				N: XIC(b_Alarm_Summ)XIC(tmr_Bind_SvOn.DN)OTE(G_b_BND02_SV_ON);
				N: XIC(b_Break_Man_Open)OTE(G_b_BrakeOff_BND02);
				N: XIO(b_BND_Run_Synch)[OTE(M20ETH:3:O.Pt10.Data) ,OTE(M20ETH:3:O.Pt09.Data) ];
				N: [XIC(b_BND_Run_Synch) ,XIC(TPFRM06_b_ChsSncr02_FrcOn) ]OTE(M20ETH:3:O.Pt06.Data);
				N: XIO(b_BND_RUN)XIO(G_b_LineRunMb)XIO(G_b_LineJogMb)OTE(M20ETH:3:O.Pt08.Data);
				N: MOV(f_BND_Spd_ns,GBIND02_f_Spd_as);
		END_ROUTINE

		CHILD_PROGRAMS
		END_CHILD_PROGRAMS

	END_PROGRAM

