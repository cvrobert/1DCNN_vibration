				N: LES(TPTO02_f_DncrPstn_PO_me[2],f_DncrLoFatal)OTE(b_PO_DncrLoFatal[2]);
				N: GRT(TPTO02_f_DncrPstn_PO_me[2],f_DncrHiWarn)OTE(b_PO_DncrHiWarn[2]);
				N: LES(TPTO02_f_DncrPstn_PO_me[2],f_DncrLoWarn)OTE(b_PO_DncrLoWarn[2]);
				N: GEQ(TPTO02_MTR_PO[2].f_Ampere,GLIB_f_POINV_TrqHiErr)TON(tmr_PO_Trq_Fatal[2],?,?);
				N: GEQ(TPTO02_MTR_PO[2].f_Ampere,GLIB_f_POINV_TrqHiAlm)TON(tmr_PO_Trq_Warn[2],?,?);
				RC: "////////////////////////////////////////////////////////////////// Pay Off No4  Alarm Prepare /////////////////////////////////////////////////////";
