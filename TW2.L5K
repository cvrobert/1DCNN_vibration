		ROUTINE R06_TurnDrctn 
				N: XIC(G_b_LineRunJogZero)XIC(G_b_TRV_SV_ON)OTE(b_TRV_SyncSpdRqr);
				N: [XIC(M11ETH:1:I.Pt14.Data) ,XIC(b_TRV_TUSide_SftLimit) XIC(b_TRV_OriRTB_Stt[200]) ]OSR(b_StorageBit6_01,b_TRV_FrcTurnRsng_TUside);
				N: [XIC(M11ETH:1:I.Pt13.Data) ,XIC(b_TRV_POSide_SftLimit) XIC(b_TRV_OriRTB_Stt[200]) ]OSR(b_StorageBit6_02,b_TRV_FrcTurnRsng_POside);
				RC: "Traverse modification program is shown in below.$N"
				    "Its calculation formula is $' av2 + bv + c. $N"
				    " Input the values in three parameters(a, b, c) and modify turn position.";
				N: ABS(f_TRV_SyncSpeed_as,f_Calculation_Dummy2)DIV(f_Calculation_Dummy2,1000,f_TRV_SyncSpeedAb_as);
				N: MOV(0.1778,f_TRV_TrnMdfyPrmtr_Co_a)MOV(0.1804,f_TRV_TrnMdfyPrmtr_Co_b)MOV(-0.176,f_TRV_TrnMdfyPrmtr_Co_c);
				N: MUL(f_TRV_SyncSpeedAb_as,f_TRV_SyncSpeedAb_as,f_Calculation_Dummy1);
				N: MUL(f_TRV_TrnMdfyPrmtr_Co_a,f_Calculation_Dummy1,f_TRV_TrnMdfyPrmtr_Quad);
				N: MUL(f_TRV_SyncSpeedAb_as,f_TRV_TrnMdfyPrmtr_Co_b,f_TRV_TrnMdfyPrmtr_Linear1);
				N: ADD(f_TRV_TrnMdfyPrmtr_Quad,f_TRV_TrnMdfyPrmtr_Linear1,f_Calculation_Dummy1);
				N: ADD(f_TRV_TrnMdfyPrmtr_Co_c,f_Calculation_Dummy1,f_TRV_TurnPstn_Mdfy);
				N: XIC(G_b_LineRunJog)[SUB(TPFRM02_f_TRV_TurnPstnPOside_ns,f_TRV_TurnPstn_Mdfy,f_TRV_TurnPstnPOside_Mdfyed) ,ADD(TPFRM02_f_TRV_TurnPstnTUside_ns,f_TRV_TurnPstn_Mdfy,f_TRV_TurnPstnTUside_Mdfyed1) ];
				N: XIC(G_b_LineRunJog)[GRT(TPTO02_f_TRV_Pstn_me,f_TRV_TurnPstnPOside_Mdfyed) OSR(b_StorageBit6_03,b_TRV_SyncTurnRsng_POside) ,LES(TPTO02_f_TRV_Pstn_me,f_TRV_TurnPstnTUside_Mdfyed1) OSR(b_StorageBit6_04,b_TRV_SyncTurnRsng_TUside) ];
				N: XIO(b_TRV_FrcTurnRsng_POside)XIO(b_TRV_SyncTurnRsng_POside)XIC(b_TRV_OriRTB_Stt[200])[XIC(b_TRV_SyncTurnRsng_TUside) ,XIC(b_TRV_FrcTurnRsng_TUside) ,XIC(b_TurnDrctn_is_GoPO) ][OTE(b_TurnDrctn_is_GoPO) ,OSR(b_StorageBit6_05,b_TRV_TrnPls_Right) ,XIC(b_TRV_TrnPls_Right) MOV(TPTO02_f_TRV_Pstn_me,f_TRV_TrnPstn_Right) ];
		END_ROUTINE

		ST_ROUTINE R11_TR_SpeedCalc 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'////////////////////////////////////////////////////////////////////////////////////////
			'// Traverse Speed Calculation //////////////////////////////////////////////////////////
			'////////////////////////////////////////////////////////////////////////////////////////
			'// Calculation Program Of Traverse Syncronize Speed
			'// Auther Shohei Oshida
			'// 2019.11.25
			'
			'//Calculation of Syncronized Speed  [mm/sec]
			'if ( b_TurnDrctn_is_GoPO ) then
			'	f_TRV_SyncSpeed_as := +( GTU_f_AppAxisSpd_as*( TPFRM_RUNSET.f_TRV_Pitch_ns ) );
			'else 
			'	f_TRV_SyncSpeed_as := -( GTU_f_AppAxisSpd_as*( TPFRM_RUNSET.f_TRV_Pitch_ns ) );
			'end_if;
			'
			'//Switching Traverse Actual Speed Set [mm/sec]
			'
			'if ( NOT G_b_TRV_SV_ON ) then
			'	GTRV_f_Spd_as := 0;
			'	 
			'elsif ( b_TRV_QckJog_POside_Mb ) then
			'	GTRV_f_Spd_as :=
			'	            + ( GLIB_AX_TRV.f_Spd_HiLmt * ( TPFRM04_f_TRV_QckJogSpd_ns / 100 ) );	
			'
			'elsif ( b_TRV_QckJog_TUSide_Mb ) then
			'	GTRV_f_Spd_as :=
			'	            - ( GLIB_AX_TRV.f_Spd_HiLmt * ( TPFRM04_f_TRV_QckJogSpd_ns / 100 ) );
			'
			'elsif ( b_TRV_SyncSpdRqr ) then
			'	 GTRV_f_Spd_as := f_TRV_SyncSpeed_as;
			'		
			'elsif ( GTRV_b_Go_StrtPstn ) then
			'	GTRV_f_Spd_as := ( GLIB_AX_TRV.f_Spd_HiLmt * ( TPFRM04_f_TRV_QckJogSpd_ns / 100 ));//300;
			'  //Quick Jog Set 
			'  //elsif (b_TRV_OriRTB_SpdRqr1)  then
			'  //GTRV_f_Spd_as := GTRV_f_OriRTBHiSpd_as;
			'  //elsif (b_TRV_OriRTB_SpdRqr3) then
			'  //GTRV_f_Spd_as := GTRV_f_OriRTBLowSpd_as;
			'  //elsif (b_TRV_OriRTB_SpdRqr2) then
			'  //GTRV_f_Spd_as := 0;
			'  else GTRV_f_Spd_as := 0;
			'  end_if;	
			'
			'  TPTO02_MTR_TRV.f_Spd_me := SV1_Axis3_TRV.VelocityFeedback * 60 * (30/40);
		END_ST_ROUTINE

