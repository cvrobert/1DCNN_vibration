	ADD_ON_INSTRUCTION_DEFINITION ScanTime0 (Description := "Scantime Calculate With Timer",
	                                         Revision := "1.0",
	                                         Vendor := "Sumitomo Electric Industries",
	                                         ExecutePrescan := No,
	                                         ExecutePostscan := No,
	                                         ExecuteEnableInFalse := No,
	                                         CreatedDate := "2019-11-14T12:07:36.176Z",
	                                         CreatedBy := "SEI\s910332",
	                                         EditedDate := "2020-01-06T06:05:21.990Z",
	                                         EditedBy := "SEI\s160087",
	                                         SoftwareRevision := "v32.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			f_ScanT : REAL (Description := "[s] Scan Time",
			                   Usage := Output,
			                   RADIX := Float,
			                   Required := No,
			                   Visible := No,
			                   ExternalAccess := Read Only,
			                   DefaultData := 0.00000000e+000);
		END_PARAMETERS

		LOCAL_TAGS
			tonr1 : FBD_TIMER (Description := "Timer For Scan Time Measure",
			                ExternalAccess := None,
			                DefaultData := "[1,0,0,0,0,0,0,0,0,4,0,0]");
			n_ScnCycles : DINT (Description := "Scan Sycle Number",
			                      RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			f_dumy01 : REAL (RADIX := Float,
			                   ExternalAccess := None,
			                   DefaultData := 0.00000000e+000);
		END_LOCAL_TAGS

		ST_ROUTINE Logic (Description := "Calculate Scantime With Timer$NIchiro Hatanaka$N2019.11.14")
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'////////////////////////////////////////////////////////////////////////
			'// Name: ScanTime0 ver1.05
			'////////////////////////////////////////////////////////////////////////
			'// This Program Measure Scan Time Of itself.
			'// Measured time is Average of 1000 time scans.
			'// Ver1.00 Ichiro Hatanaka 2019.11.18
			'// Ver1.05 Ichiro Hatanaka 2020.01.03
			'
			'tonr1.EnableIn := 1;
			'tonr1.TimerEnable := 1;
			'tonr1.PRE := 2147483647;
			'tonr1.Reset := 0;
			'TONR(tonr1);
			'
			'n_ScnCycles := n_ScnCycles +1 ;
			'
			'// TONR1.ACC is [ms]unit, so dived by 1000.
			'
			'IF 1000 <= n_ScnCycles THEN
			'	f_dumy01 := tonr1.ACC;
			'	f_ScanT := ( f_dumy01 /1000 )/1000 ;
			'
			'	// tonr1.ACC := 0; // Reset Code 1, if it doesn't workwell, use code2.
			'	tonr1.Reset := 1; // Reset Code2.
			'	TONR(tonr1);      // Reset Code2.
			'	n_ScnCycles := 0;
			'END_IF;	
		END_ST_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION BBN_DNCR_Cntrl00 (Description := "Dancer Control program.Old SEI style.",
	                                                Revision := "1.0",
	                                                ExecutePrescan := No,
	                                                ExecutePostscan := No,
	                                                ExecuteEnableInFalse := No,
	                                                CreatedDate := "2019-11-20T09:08:55.640Z",
	                                                CreatedBy := "SEI\s910332",
	                                                EditedDate := "2024-05-29T14:19:22.024Z",
	                                                EditedBy := "GD\gu222024",
	                                                SoftwareRevision := "v34.01")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			f_SpdMax : REAL (Description := "[rpm] maximum speed Limit of the Axis.",
			                    Usage := Input,
			                    RADIX := Float,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			b_is_TU : BOOL (Description := "On = Take Up, OFF = Pay Off,",
			                   Usage := Input,
			                   RADIX := Decimal,
			                   Required := No,
			                   Visible := No,
			                   ExternalAccess := None,
			                   DefaultData := 0);
			f_DiaMax : REAL (Description := "[mm] Bobbin Maximum Diameter",
			                    Usage := Input,
			                    RADIX := Float,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			f_DiaMin : REAL (Description := "[mm] Bobbin Minimum Diameter",
			                    Usage := Input,
			                    RADIX := Float,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			f_DNCR_Kp : REAL (Description := "[rpm/100%] P correct Value With Dancer Max Error",
			                     Usage := Input,
			                     RADIX := Float,
			                     Required := No,
			                     Visible := No,
			                     DefaultData := 0.00000000e+000);
			f_DNCR_Is : REAL (Description := "[s] I corect time. DIameter Correct will integrated with Dancer Max Error by this Time",
			                     Usage := Input,
			                     RADIX := Float,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := None,
			                     DefaultData := 0.00000000e+000);
			b_Run : BOOL (Description := "Dancer Control Activate",
			                 Usage := Input,
			                 RADIX := Decimal,
			                 Required := No,
			                 Visible := No,
			                 ExternalAccess := None,
			                 DefaultData := 0);
			f_Line_Spd_me : REAL (Description := "[m/min] Control Base Line Speed",
			                         Usage := Input,
			                         RADIX := Float,
			                         Required := No,
			                         Visible := No,
			                         ExternalAccess := None,
			                         DefaultData := 0.00000000e+000);
			b_I_Calc : BOOL (Description := "Dancer DIameter Correct Integration Acttivate",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := None,
			                    DefaultData := 0);
			f_DNCR_Pstn_me : REAL (Description := "[%} Dancer Position Data. 100% is Up Limit, -100% is Down Limit",
			                          Usage := Input,
			                          RADIX := Float,
			                          Required := No,
			                          Visible := No,
			                          ExternalAccess := None,
			                          DefaultData := 0.00000000e+000);
			f_AxisSpd_as : REAL (Description := "[rpm] Axis Speed Reference with Dancer Control",
			                        Usage := Output,
			                        RADIX := Float,
			                        Required := No,
			                        Visible := No,
			                        ExternalAccess := Read Only,
			                        DefaultData := 0.00000000e+000);
			f_Dia_me : REAL (Description := "[mm] Calculated Diameter with Dancer Control",
			                    Usage := Output,
			                    RADIX := Float,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			f_P_Crct_me : REAL (Description := "[rpm] Actual P correction monitor",
			                       Usage := Output,
			                       RADIX := Float,
			                       Required := No,
			                       Visible := No,
			                       ExternalAccess := None,
			                       DefaultData := 0.00000000e+000);
			b_RstDia : BOOL (Description := "Reset Integrated Value for Diameter Calcutlate",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
			f_DiaSync : REAL (Description := "[mm] Start Diameter",
			                    RADIX := Float,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			f_DiaMin2 : REAL (Description := "[mm] Minimum diameter with some margine",
			                    RADIX := Float,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			f_DiaMax2 : REAL (Description := "[mm] Maximum diameter with some margine",
			                    RADIX := Float,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			tmr_FOR_P : FBD_TIMER (Description := "Timer for P correct Start",
			                    ExternalAccess := None,
			                    DefaultData := "[1,0,0,0,0,0,0,0,0,4,0,0]");
			f_Pcorrect_ns : REAL (RADIX := Float,
			                        ExternalAccess := None,
			                        DefaultData := 0.00000000e+000);
			f_Dummy01 : REAL (RADIX := Float,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			f_P_StrtSec : REAL (Description := "[s]",
			                      RADIX := Float,
			                      ExternalAccess := None,
			                      DefaultData := 0.00000000e+000);
			f_ScnT : REAL (Description := "[s] Scan Time",
			                 RADIX := Float,
			                 ExternalAccess := None,
			                 DefaultData := 0.00000000e+000);
			scanTime : ScanTime0 (ExternalAccess := None,
			                   DefaultData := "[1,0.00000000e+000,[1,0,0,0,0,0,0,0,0,4,0,0],0,0.00000000e+000]");
			f_incVforDIa : REAL (Description := "[mm/scan] increase value of Diameter with each scan.",
			                       RADIX := Float,
			                       ExternalAccess := None,
			                       DefaultData := 0.00000000e+000);
			f_SpdMaxNeg : REAL (Description := "[rpm] SpeedMax Of Negative Side",
			                      RADIX := Float,
			                      ExternalAccess := None,
			                      DefaultData := 0.00000000e+000);
			b_SpdOver : BOOL (RADIX := Decimal,
			                    ExternalAccess := None,
			                    DefaultData := 0);
		END_LOCAL_TAGS

		ST_ROUTINE Logic 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// Name: BBN_DNCR_Cntrl00 Ver1.03 ///////////////////////////////////////////////////////
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// Dancer Control Calculating
			'// Ver 1.00 Ichiro Hatanaka 2019.11.18
			'// ver 1.03 Ichiro Hatanaka 2020.01.03
			'
			'// Preparetion Get Scantime of tihs Program /////////////////////////////////////////////
			'
			'scanTime.EnableIn := 1;
			'ScanTime0(scanTime);
			'//f_ScnT := scanTime.f_ScanT;
			'f_ScnT := scanTime.f_ScanT; //20191219 oshida editted
			'
			'// Preparation Make Diameter Data ///////////////////////////////////////////////////////
			'
			'f_DiaMax2 := f_DiaMax + 10;
			'f_DiaMin2 := f_DiaMin -70;
			'if (f_DiaMax2 < 10 ) then f_DiaMin2 := 10; end_if;
			'
			'if (b_is_TU ) then
			'	f_DiaSync := f_DiaMin;
			'else
			'	f_DiaSync := 2*(f_DiaMax2 * f_DiaMin2) / (f_DiaMax2 + f_DiaMin2);
			'end_if;
			'
			'// Reset diameter Data by input signal //////////////////////////////////////////////////
			'
			'if( (not(b_Run)) and (b_RstDia) )then
			'	f_Dia_me := f_DiaSync;
			'end_if;
			'
			'// P correct start timer ////////////////////////////////////////////////////////////////
			'
			'tmr_FOR_P.EnableIn := 1;
			'tmr_FOR_P.PRE := 5000;
			'tmr_FOR_P.Reset := not(b_Run);
			'tmr_FOR_P.TimerEnable := b_Run;
			'
			'TONR(tmr_FOR_P);
			'
			'f_Dummy01 := tmr_FOR_P.ACC;
			'f_P_StrtSec := f_Dummy01 /1000;
			'
			'// Calculate P COrrect Value ////////////////////////////////////////////////////////////
			'
			'f_Pcorrect_ns := f_DNCR_Kp * f_DNCR_Pstn_me /100;
			'
			'f_P_Crct_me := f_Pcorrect_ns * f_P_StrtSec /5;
			'
			'if (b_is_TU ) then f_P_Crct_me :=( f_P_Crct_me * -1) ; end_if;
			'
			'// Estimate Diameter with Integration calculating  //////////////////////////////////////
			'
			'f_incVforDIa := (((f_DiaMax2 - f_DiaMin2)/2) / (f_DNCR_Is/f_ScnT))//20191227 edit 
			'                * (f_DNCR_Pstn_me /100) ;
			'
			'if (b_is_TU) then f_incVforDIa := (f_incVforDIa * -1); end_if;
			'
			'if (b_SpdOver)and(0 < f_incVforDIa) then f_incVforDIa := 0; end_if;
			'
			'if( (b_Run)and(b_I_Calc)and(0 < f_Line_Spd_me) )then
			'	f_Dia_me := f_Dia_me - f_incVforDIa;
			'	
			'	if (f_Dia_me < f_DiaMin2 ) then
			'		f_Dia_me := f_DiaMin2;
			'	elsif (f_DiaMax2 < f_Dia_me ) then
			'		f_Dia_me := f_DiaMax2;
			'	end_if;
			'
			'end_if;
			'
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'// Axis Speed Calculate /////////////////////////////////////////////////////////////////
			'
			'if (b_Run) then
			'	f_AxisSpd_as :=( f_Line_Spd_me /(3.1415 * f_Dia_me /1000)) + f_P_Crct_me;
			'else
			'	f_AxisSpd_as := 0;
			'end_if;
			'
			'// Limit Output Speed Reference /////////////////////////////////////////////////////////
			'
			'f_SpdMaxNeg := f_SpdMax * -1 ;
			'b_SpdOver := 0;
			'
			'if( f_AxisSpd_as < f_SpdMaxNeg )then
			'	f_AxisSpd_as := f_SpdMaxNeg;
			'elsif( f_SpdMax < f_AxisSpd_as )then
			'	f_AxisSpd_as := f_SpdMax;
			'	b_SpdOver := 1;
			'end_if;
			'
		END_ST_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION CTR00 (Description := "Count input Palses$NIchiro Hatanaka$N2019.11.15",
	                                     Revision := "1.0",
	                                     ExecutePrescan := No,
	                                     ExecutePostscan := No,
	                                     ExecuteEnableInFalse := No,
	                                     CreatedDate := "2019-11-15T07:45:13.326Z",
	                                     CreatedBy := "SEI\s910332",
	                                     EditedDate := "2020-01-03T14:15:54.248Z",
	                                     EditedBy := "SEI\s910332",
	                                     SoftwareRevision := "v32.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			b_Z_Rst : BOOL (Description := "Reset Inner Counter to Zero",
			                   Usage := Input,
			                   RADIX := Decimal,
			                   Required := No,
			                   Visible := No,
			                   DefaultData := 0);
			b_Pause : BOOL (Description := "Hold Count and Ignre Input Palses While It Is On",
			                   Usage := Input,
			                   RADIX := Decimal,
			                   Required := No,
			                   Visible := No,
			                   ExternalAccess := None,
			                   DefaultData := 0);
			nn_InCnt : DINT (Description := "[pls] Palses for Cout",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := None,
			                    DefaultData := 0);
			nn_Cnt : DINT (Description := "[pls] Counted Value of Palses",
			                  Usage := Output,
			                  RADIX := Decimal,
			                  Required := No,
			                  Visible := No,
			                  ExternalAccess := None,
			                  DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
			nn_Incnt_1ScanBefore : DINT (RADIX := Decimal,
			                               ExternalAccess := None,
			                               DefaultData := 0);
			nn_diference : DINT (RADIX := Decimal,
			                       ExternalAccess := None,
			                       DefaultData := 0);
		END_LOCAL_TAGS

		ST_ROUTINE Logic 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////
			'// Name: CTR00 Ver1.00
			'/////////////////////////////////////////////////////////////////////////////////
			'// Vartuarized Counter. Make multiple counter from 1 hard ware counter.
			'// Ver1.00 Ichiro Hatanaka 2019.11.18
			'
			'nn_diference := nn_InCnt - nn_Incnt_1ScanBefore;
			'nn_Incnt_1ScanBefore := nn_InCnt;
			'
			'if not(b_Pause) then
			'	nn_Cnt := nn_Cnt + nn_diference;
			'end_if;
			'
			'if b_Z_Rst then
			'	nn_Cnt := 0;
			'end_if;
		END_ST_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION LngthCtr0 (Description := "Counter FOr Length$NIchiro Hatanaka$N2019.11.15",
	                                         Revision := "1.0",
	                                         ExecutePrescan := No,
	                                         ExecutePostscan := No,
	                                         ExecuteEnableInFalse := No,
	                                         CreatedDate := "2019-11-15T07:56:42.533Z",
	                                         CreatedBy := "SEI\s910332",
	                                         EditedDate := "2020-01-06T07:18:51.627Z",
	                                         EditedBy := "SEI\s160087",
	                                         SoftwareRevision := "v32.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			b_Z_Rst : BOOL (Description := "Reaset Inner Counter To 0",
			                   Usage := Input,
			                   RADIX := Decimal,
			                   Required := No,
			                   Visible := No,
			                   DefaultData := 0);
			b_Pause : BOOL (Usage := Input,
			                   RADIX := Decimal,
			                   Required := No,
			                   Visible := No,
			                   DefaultData := 0);
			nn_InCnt : DINT (Description := "[pls]",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    DefaultData := 0);
			f_weight : REAL (Description := "[pls/m] Transrate Coefficient to Length",
			                    Usage := Input,
			                    RADIX := Float,
			                    Required := No,
			                    Visible := No,
			                    DefaultData := 0.00000000e+000);
			f_Length_ns : REAL (Description := "[m] Set Point Of Length Counter",
			                       Usage := Input,
			                       RADIX := Float,
			                       Required := No,
			                       Visible := No,
			                       DefaultData := 0.00000000e+000);
			f_Length_me : REAL (Description := "[m] Counted Length",
			                       Usage := Output,
			                       RADIX := Float,
			                       Required := No,
			                       Visible := No,
			                       ExternalAccess := Read Only,
			                       DefaultData := 0.00000000e+000);
			f_RemainingL : REAL (Description := "[m]  f_Length_ns - fLength_me",
			                        Usage := Output,
			                        RADIX := Float,
			                        Required := No,
			                        Visible := No,
			                        ExternalAccess := Read Only,
			                        DefaultData := 0.00000000e+000);
		END_PARAMETERS

		LOCAL_TAGS
			counter : CTR00 (ExternalAccess := None,
			                  DefaultData := "[1,0,0,0,0]");
			f_Dummy : REAL (RADIX := Float,
			                  ExternalAccess := None,
			                  DefaultData := 0.00000000e+000);
		END_LOCAL_TAGS

		ST_ROUTINE Logic (Description := "Counter FOr Length$NIchiro Hatanaka$N2019.11.15")
			'////////////////////////////////////////////////
			'// Name: LngthCtr0
			'////////////////////////////////////////////////
			'// ver 1.00
			'// Length Counter For Cable Machine.
			'// Auther Ichiro Hatanaka
			'// 2019.11.18
			'
			'counter.nn_InCnt := nn_InCnt;
			'counter.b_Z_Rst := b_Z_Rst;
			'counter.b_Pause := b_Pause;
			'counter.EnableIn := 1;
			'
			'CTR00 ( counter );
			'
			'f_Dummy := counter.nn_Cnt;
			'f_Length_me := f_Dummy / f_weight;
			'f_RemainingL := f_Length_ns - f_Length_me;
			'
		END_ST_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION DNCR_Scale0 (Description := "Scale Calcurate for Dancer Position",
	                                           Revision := "1.0",
	                                           ExecutePrescan := No,
	                                           ExecutePostscan := No,
	                                           ExecuteEnableInFalse := No,
	                                           CreatedDate := "2019-11-15T08:10:54.321Z",
	                                           CreatedBy := "SEI\s910332",
	                                           EditedDate := "2020-01-06T06:28:14.038Z",
	                                           EditedBy := "SEI\s160087",
	                                           SoftwareRevision := "v32.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			f_DwnLimit : REAL (Description := "Dancer AD Value with Down Limit Position",
			                      Usage := Input,
			                      RADIX := Float,
			                      Required := No,
			                      Visible := No,
			                      ExternalAccess := None,
			                      DefaultData := 0.00000000e+000);
			f_Midle : REAL (Description := "Dancer AD Value with Midle Position",
			                   Usage := Input,
			                   RADIX := Float,
			                   Required := No,
			                   Visible := No,
			                   ExternalAccess := None,
			                   DefaultData := 0.00000000e+000);
			f_UpLimit : REAL (Description := "Dancer AD Value with Uper Limit Position",
			                     Usage := Input,
			                     RADIX := Float,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := None,
			                     DefaultData := 0.00000000e+000);
			f_pstn_raw : REAL (Description := "Dancer DA Value",
			                      Usage := Input,
			                      RADIX := Float,
			                      Required := No,
			                      Visible := No,
			                      ExternalAccess := None,
			                      DefaultData := 0.00000000e+000);
			f_DNCR_Pstn_me : REAL (Description := "Dancer Positon 100%=Highest, -100%=Lowest",
			                          Usage := Output,
			                          RADIX := Float,
			                          Required := No,
			                          Visible := No,
			                          ExternalAccess := Read Only,
			                          DefaultData := 0.00000000e+000);
		END_PARAMETERS

		LOCAL_TAGS
			f_Midle2 : REAL (RADIX := Float,
			                   ExternalAccess := None,
			                   DefaultData := 0.00000000e+000);
			b_Chck : BOOL (Description := "value check",
			                 RADIX := Decimal,
			                 ExternalAccess := None,
			                 DefaultData := 0);
		END_LOCAL_TAGS

		ST_ROUTINE Logic (Description := "Scale Calcurate for Dancer Position$N$NIchiro Hatanaka$N2019.11.15")
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'//////////////////////////////////////////////////////////////////////////////////
			'// Name: DNCR_Scale0 ver1.00
			'//////////////////////////////////////////////////////////////////////////////////
			'// Dancer AD Input Value trancearate to +-100% 
			'// ver1.00 Ichiro Hatanaka 2019.12.29
			'
			'// Check Input Prameter if it is acceptable.
			'
			'if ( f_DwnLimit = f_UpLimit ) then
			'	b_Chck := 0;
			'else
			'	b_Chck := 1;
			'end_if;
			'
			'
			'// Check Middle Position Parameter and ,if it is not acceptable, over Write it.
			'
			'if (( f_Midle < f_DwnLimit ) and (f_Midle < f_UpLimit ))
			'	or (( f_DwnLimit < f_Midle ) and (f_UpLimit < f_Midle)) then
			'	 
			'	 f_Midle2 := (f_DwnLimit + f_UpLimit )/2 ;
			'	 
			'else
			'	f_Midle2 := f_Midle;
			'	
			'end_if;
			'
			'
			'// Trancerate Caluculation
			'// D= dowu Limit, M = Midle Position, U = Up Limit, I = Input Value, P= conversed Value
			'// We canverse Input Value to -100 to +100
			'// I=d -> P= -100, I=M -> P= 0 , I=U -> P = 100, We need it.
			'// if 0 < D < M < U :  if (D=< I <  M) P = (I-M)*100/(M-D) 
			'//                     if (M=< I <= U) P = (I-M)*100/(U-M)
			'// if D < M < U < 0 :  if (D=< I <  M) P = (I-M)*100/(M-D) 
			'//                     if (M=< I <= U) P = (I-M)*100/(U-M) same 
			'// if 0 < U < M < D :  if (U=< I <= M) P = (I-M)*100/(U-M)
			'//                     if (M<  I < =D) P = (I-M)*100/(M-D)
			'// if U < M < D < 0 :  if (U=< I <= M) P = (I-M)*100/(U-M)
			'//                     if (M<  I < =D) P = (I-M)*100/(M-D)
			'// Thats why rquaton should be same, but becareful about range
			'
			'if (b_Chck) then
			'
			'	if ((f_pstn_raw < f_DwnLimit) and (f_DwnLimit < f_UpLimit ))
			'		or ((f_DwnLimit < f_pstn_raw ) and ( f_UpLimit < f_DwnLimit )) then
			'		
			'		f_DNCR_Pstn_me := -100;
			'		
			'	end_if;
			'	
			'	if (( f_UpLimit < f_pstn_raw ) and ( f_DwnLimit < f_UpLimit ))
			'		or (( f_pstn_raw < f_UpLimit ) and ( f_UpLimit < f_DwnLimit )) then
			'		
			'		f_DNCR_Pstn_me := 100;
			'	
			'	end_if;
			'
			'	if ((f_DwnLimit <= f_pstn_raw)  and  (f_pstn_raw < f_Midle2))
			'		or ((f_Midle2 < f_pstn_raw ) and (f_pstn_raw <= f_DwnLimit)) then
			'	
			'		f_DNCR_Pstn_me := (f_pstn_raw - f_Midle2) * 100 / (f_Midle2 - f_DwnLimit);
			'	
			'	end_if;
			'
			'	if (( f_Midle2 <= f_pstn_raw) and ( f_pstn_raw <= f_UpLimit))
			'		or ((f_UpLimit <= f_pstn_raw) and (f_pstn_raw <= f_Midle2 )) then
			'
			'		f_DNCR_Pstn_me := (f_pstn_raw - f_Midle2 )* 100 / (f_UpLimit - f_Midle2);
			'	
			'	end_if;
			'
			'else
			'	f_DNCR_Pstn_me := 0;
			'end_if;
		END_ST_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION LngthForDcc (Description := "Calculate Lenght for Line Decceleration$N$NIchiro Hatanaka$N2019.11.15",
	                                           Revision := "1.0",
	                                           ExecutePrescan := No,
	                                           ExecutePostscan := No,
	                                           ExecuteEnableInFalse := No,
	                                           CreatedDate := "2019-11-15T08:04:48.584Z",
	                                           CreatedBy := "SEI\s910332",
	                                           EditedDate := "2020-03-12T09:18:27.405Z",
	                                           EditedBy := "MR-lenovo-THINK\MR-lenovo",
	                                           SoftwareRevision := "v32.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			f_Dccrat : REAL (Description := "[(m/min)/min] Decclaration of Line Speed",
			                    Usage := Input,
			                    RADIX := Float,
			                    Required := No,
			                    Visible := No,
			                    DefaultData := 0.00000000e+000);
			f_LineSpd_me : REAL (Description := "[m/min] Line Actual Speed",
			                        Usage := Input,
			                        RADIX := Float,
			                        Required := No,
			                        Visible := No,
			                        DefaultData := 0.00000000e+000);
			f_DwnSpd_ns : REAL (Description := "[m/min] Target Speed Of Decceleration",
			                       Usage := Input,
			                       RADIX := Float,
			                       Required := No,
			                       Visible := No,
			                       DefaultData := 0.00000000e+000);
			f_LngthForDcc : REAL (Description := "[m] Calculated Length for Decceleration",
			                         Usage := Output,
			                         RADIX := Float,
			                         Required := No,
			                         Visible := No,
			                         ExternalAccess := Read Only,
			                         DefaultData := 0.00000000e+000);
		END_PARAMETERS

		LOCAL_TAGS
			b_Chk : BOOL (Description := "Check the Value",
			                RADIX := Decimal,
			                ExternalAccess := None,
			                DefaultData := 0);
		END_LOCAL_TAGS

		ST_ROUTINE Logic (Description := "Calculate Lenght for Line Decceleration$N$NIchiro Hatanaka$N2019.11.15")
			'////////////////////////////////////////////////
			'// Name: LngthForDcc
			'////////////////////////////////////////////////
			'// ver 1.00
			'// Calculate Length with Decceleration of The Line.
			'// Auther Ichiro Hatanaka
			'// 2019.11.18
			'
			'b_Chk := 1;
			'
			'if ( (f_LineSpd_me <= 0 ) 
			'	or (f_DwnSpd_ns < 0  ) 
			'	or (f_Dccrat <=0 ) 
			'	or (f_LineSpd_me <= f_DwnSpd_ns) )then
			'	
			'	b_Chk := 0;
			'	
			'end_if;
			'
			'if ( b_Chk ) then
			'	f_LngthForDcc := ( (f_LineSpd_me - f_DwnSpd_ns) / f_Dccrat ) 
			'                             * (f_LineSpd_me + f_DwnSpd_ns) / 2 ;
			'else
			'	f_LngthForDcc := 0;
			'end_if;
		END_ST_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION SFS00 (Description := "Soft Start ::",
	                                     Revision := "1.0",
	                                     ExecutePrescan := No,
