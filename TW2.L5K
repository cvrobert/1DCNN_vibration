		ST_ROUTINE R02_PrntComStatebit 
			'//3456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
			'/////////////////////////////////////////////////////////////////////////////////////////
			'// Prnter Communication State bit  //////////////////////////////////////////////////////
			'/////////////////////////////////////////////////////////////////////////////////////////
			'
			'b_PrntStt[0]  :=  ( nn_PrntStt =  0 );
			'
			'b_PrntStt[10] :=  ( nn_PrntStt = 10 );
			'b_PrntStt[12] :=  ( nn_PrntStt = 12 );
			'b_PrntStt[13] :=  ( nn_PrntStt = 13 );
			'b_PrntStt[16] :=  ( nn_PrntStt = 16 );
