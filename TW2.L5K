				N: ABS(GBIND01_f_Spd_as,f_BND01_Spd_Abs);
				N: GRT(f_BND01_Spd_Abs,45)[XIO(M20ETH:1:I.Pt02.Data) TON(tmr_Yarn_Break_1_1,?,?) ,XIC(M20ETH:1:I.Pt02.Data) TON(tmr_Yarn_Dirt1_1,?,?) ,XIO(M20ETH:1:I.Pt05.Data) XIC(G_b_MasterUp) TON(tmr_Yarn_Break_1_2,?,?) ,XIC(M20ETH:1:I.Pt05.Data) TON(tmr_Yarn_Dirt1_2,?,?) ];
				N: LEQ(TPTO02_f_BND1CheeseDia_me,88.5)TON(tmr_BND1_None_Detect,?,?);
				N: XIC(G_b_BND02_SV_ON)TON(tmr_BND2_Run,?,?);
