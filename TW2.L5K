		END_PARAMETERS

		LOCAL_TAGS
			b_AccPls : BOOL (RADIX := Decimal,
			                   ExternalAccess := None,
			                   DefaultData := 0);
			b_DccPls : BOOL (RADIX := Decimal,
			                   ExternalAccess := None,
			                   DefaultData := 0);
			b_AccOld : BOOL (RADIX := Decimal,
			                   ExternalAccess := None,
			                   DefaultData := 0);
			b_DccOld : BOOL (RADIX := Decimal,
			                   ExternalAccess := None,
			                   DefaultData := 0);
			f_as_Temp : REAL (RADIX := Float,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			tmr_ACC : FBD_TIMER (ExternalAccess := None,
			                  DefaultData := "[1,0,0,0,0,0,0,0,0,4,0,0]");
			tmr_DCC : FBD_TIMER (ExternalAccess := None,
			                  DefaultData := "[1,0,0,0,0,0,0,0,0,4,0,0]");
			f_Dummy01 : REAL (RADIX := Float,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			f_SecForAcc : REAL (Description := "[s] Accumued Time for Acceleration",
			                      RADIX := Float,
			                      ExternalAccess := None,
			                      DefaultData := 0.00000000e+000);
			f_SecForDcc : REAL (Description := "[s] Accumed Time for Decceleration",
			                      RADIX := Float,
			                      ExternalAccess := None,
			                      DefaultData := 0.00000000e+000);
			f_AccratOld : REAL (RADIX := Float,
			                      ExternalAccess := None,
			                      DefaultData := 0.00000000e+000);
			f_DccratOld : REAL (RADIX := Float,
			                      ExternalAccess := None,
			                      DefaultData := 0.00000000e+000);
