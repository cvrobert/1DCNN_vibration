		ST_ROUTINE R03_Monitor 
			'///////////////////////////////////////////////
			'// Name: TouchPanel_Monitor
			'////////////////////////////////////////////////
			'// ver 1.00
			'// Touch Panel Monitor Processing
			'// Auther Ryo Mikuni
			'// 2019.11.22
			'
			'TPTO02_n_LineState_me := GSTT_n_LineState;
			'
			'// No.1 PO Color Change
			'
			'TPTO01_n_Grph_PO[0] := 0 ;
			'if ( TPFRM_RUNSET.b_Slct_PO[0] ) then TPTO01_n_Grph_PO[0] := 1 ; end_if;
			'if ( GPO_b_RUN_Mb[0] ) then TPTO01_n_Grph_PO[0] := 2 ; end_if; 
			'if ( G_b_Alm2IL[0] or G_b_Alm2IL[1] or G_b_Alm2IL[2] or G_b_Alm2IL[3] 
			'	or G_b_Alm2IL[4] or G_b_Alm2IL[5] or G_b_Alm2IL[6] )
			'    then TPTO01_n_Grph_PO[0] := 3 ; end_if;
			'if ( G_b_Alm2IL[7] or G_b_Alm2IL[8] )
			'    then TPTO01_n_Grph_PO[0] := 3 ; end_if;
			'		
			'// No.2 PO Color Change
			'
			'TPTO01_n_Grph_PO[1] := 0 ;
			'if ( TPFRM_RUNSET.b_Slct_PO[1] ) then TPTO01_n_Grph_PO[1] := 1 ; end_if;
			'if ( GPO_b_RUN_Mb[1] ) then TPTO01_n_Grph_PO[1] := 2 ; end_if; 
			'if ( G_b_Alm2IL[11] or G_b_Alm2IL[12] or G_b_Alm2IL[13] or G_b_Alm2IL[14] 
			'	or G_b_Alm2IL[15] or G_b_Alm2IL[16] or G_b_Alm2IL[17] )
			'    then TPTO01_n_Grph_PO[1] := 3 ; end_if;
			'if ( G_b_Alm2IL[18] or G_b_Alm2IL[19] )
			'    then TPTO01_n_Grph_PO[1] := 3 ; end_if;
			'	
			'// No.3 PO Color Change
			'
			'TPTO01_n_Grph_PO[2] := 0 ;
			'if ( TPFRM_RUNSET.b_Slct_PO[2] ) then TPTO01_n_Grph_PO[2] := 1 ; end_if;
			'if ( GPO_b_RUN_Mb[2] ) then TPTO01_n_Grph_PO[2] := 2 ; end_if; 
