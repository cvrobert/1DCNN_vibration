				N: LES(TPTO02_f_DncrPstn_PO_me[5],f_DncrLoWarn)OTE(b_PO_DncrLoWarn[5]);
				N: GEQ(TPTO02_MTR_PO[5].f_Ampere,GLIB_f_POINV_TrqHiErr)TON(tmr_PO_Trq_Fatal[5],?,?);
				N: GEQ(TPTO02_MTR_PO[5].f_Ampere,GLIB_f_POINV_TrqHiAlm)TON(tmr_PO_Trq_Warn[5],?,?);
				RC: "////////////////////////////////////////////////////////////////// Pay Off No7 Alarm Prepare /////////////////////////////////////////////////////";
				N: GRT(TPTO02_f_DncrPstn_PO_me[6],f_DncrHiFatal)OTE(b_PO_DncrHiFatal[6]);
				N: LES(TPTO02_f_DncrPstn_PO_me[6],f_DncrLoFatal)OTE(b_PO_DncrLoFatal[6]);
				N: GRT(TPTO02_f_DncrPstn_PO_me[6],f_DncrHiWarn)OTE(b_PO_DncrHiWarn[6]);
				N: LES(TPTO02_f_DncrPstn_PO_me[6],f_DncrLoWarn)OTE(b_PO_DncrLoWarn[6]);
				N: GEQ(TPTO02_MTR_PO[6].f_Ampere,GLIB_f_POINV_TrqHiErr)TON(tmr_PO_Trq_Fatal[6],?,?);
				N: GEQ(TPTO02_MTR_PO[6].f_Ampere,GLIB_f_POINV_TrqHiAlm)TON(tmr_PO_Trq_Warn[6],?,?);
				RC: "////////////////////////////////////////////////////////////////// Pay Off No8 Alarm Prepare /////////////////////////////////////////////////////";
				N: GRT(TPTO02_f_DncrPstn_PO_me[7],f_DncrHiFatal)OTE(b_PO_DncrHiFatal[7]);
				N: LES(TPTO02_f_DncrPstn_PO_me[7],f_DncrLoFatal)OTE(b_PO_DncrLoFatal[7]);
				N: GRT(TPTO02_f_DncrPstn_PO_me[7],f_DncrHiWarn)OTE(b_PO_DncrHiWarn[7]);
				N: LES(TPTO02_f_DncrPstn_PO_me[7],f_DncrLoWarn)OTE(b_PO_DncrLoWarn[7]);
				N: GEQ(TPTO02_MTR_PO[7].f_Ampere,GLIB_f_POINV_TrqHiErr)TON(tmr_PO_Trq_Fatal[7],?,?);
				N: GEQ(TPTO02_MTR_PO[7].f_Ampere,GLIB_f_POINV_TrqHiAlm)TON(tmr_PO_Trq_Warn[7],?,?);
				RC: "////////////////////////////////////////////////////////////////// Pay Off No9 Alarm Prepare /////////////////////////////////////////////////////";
