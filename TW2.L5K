			'b_PrntStt[20] :=  ( nn_PrntStt = 20 );
			'b_PrntStt[21] :=  ( nn_PrntStt = 21 );
			'
			'
			'b_PrntStt[30] :=  ( nn_PrntStt = 30 );
			'b_PrntStt[32] :=  ( nn_PrntStt = 32 );
			'b_PrntStt[33] :=  ( nn_PrntStt = 33 );
			'b_PrntStt[36] :=  ( nn_PrntStt = 36 );
